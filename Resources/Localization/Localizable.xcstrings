    "Asks before anything that changes something outside Sidefolk, even if you allowed it before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل قبل أي شيء يغيّر ما هو خارج Sidefolk، حتى لو سمحت به من قبل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor allem, was etwas außerhalb von Sidefolk ändert, auch wenn du es schon einmal erlaubt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes de cualquier cosa que cambie algo fuera de Sidefolk, aunque lo hayas permitido antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant tout ce qui modifie quelque chose en dehors de Sidefolk, même si vous l’avez déjà autorisé."
