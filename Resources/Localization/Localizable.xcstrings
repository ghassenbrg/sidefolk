          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يمرّر ما يُعطى له إلى ملحق، لذا أتحقق منك أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das gibt, was es bekommt, an eine Erweiterung weiter, deshalb frage ich dich zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto pasa lo que recibe a una extensión, así que lo consulto contigo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci transmet ce qu’on lui donne à une extension, alors je vérifie d’abord avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo passa ciò che riceve a un’estensione, quindi te lo chiedo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "受け取ったものを拡張機能に渡すので、先に確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받은 내용을 확장 프로그램에 넘겨서 먼저 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso passa o que recebe para uma extensão, então confiro com você antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它会把收到的内容交给一个扩展，所以我先问你。"
          }
        }
      }
    },
    "This model can't use tools, and Sidefolk acts through them. Pick one that can." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا النموذج استخدام الأدوات، وSidefolk يعمل من خلالها. اختر نموذجًا يستطيع ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Modell kann keine Werkzeuge verwenden, und Sidefolk handelt über sie. Wähle eines, das Werkzeuge verwenden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo no puede usar herramientas, y Sidefolk actúa a través de ellas. Elige uno que pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce modèle ne peut pas utiliser d’outils, et Sidefolk agit par leur biais. Choisissez-en un qui le peut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo modello non sa usare gli strumenti, e Sidefolk agisce tramite quelli. Scegline uno che sappia farlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモデルはツールを使えません。Sidefolkはツールを通して操作するため、ツールを使えるモデルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모델은 도구를 사용할 수 없는데, Sidefolk는 도구를 통해 동작해요. 도구를 사용할 수 있는 모델을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este modelo não sabe usar ferramentas, e o Sidefolk age por meio delas. Escolha um que saiba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个模型无法使用工具，而 Sidefolk 要通过工具来行事。请选择一个能使用工具的模型。"
          }
        }
      }
    },
