    "Sidefolk acts on its own, and asks before risky steps" : {
      "comment" : "Settings › Trust: the headline in Auto",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتصرف Sidefolk وحده، ويسأل قبل الخطوات الخطرة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk handelt selbst und fragt vor riskanten Schritten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk actúa por su cuenta y pregunta antes de los pasos arriesgados"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk agit seul, et demande avant les étapes risquées"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk agisce da solo e chiede prima dei passaggi rischiosi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk は自分で実行し、危険な手順の前には確認します"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
