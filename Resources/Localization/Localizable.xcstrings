    },
    "Sidefolk isn't running, so here's your reminder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk لا يعمل، لذا إليك تذكيرك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk läuft nicht, deshalb kommt deine Erinnerung auf diesem Weg."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no se está ejecutando, así que aquí tienes tu recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’est pas ouvert, alors voici votre rappel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non è in esecuzione, quindi ecco il tuo promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが起動していないため、こちらでリマインダーをお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 실행 중이 아니어서 여기로 미리 알림을 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não está aberto, então aqui está seu lembrete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 没有在运行，所以在这里提醒你。"
          }
        }
      }
    },
    "Sidefolk keeps these in mind in every conversation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع Sidefolk هذه في اعتباره في كل محادثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk behält das in jedem Gespräch im Hinterkopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkはどの会話でもこれらを覚えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 在每次对话中都会记着这些。"
          }
        }
      }
    },
    "Sidefolk keeps these in mind in every conversation. Change or delete anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع Sidefolk هذه في اعتباره في كل محادثة. يمكنك تغيير أي منها أو حذفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk behält das in jedem Gespräch im Hinterkopf. Ändere oder lösche, was du willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación. Cambia o elimina lo que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation. Modifiez ou supprimez ce que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione. Puoi modificare o eliminare qualsiasi cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkはどの会話でもこれらを覚えています。自由に変更・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요. 무엇이든 변경하거나 삭제할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas. Altere ou apague o que quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 在每次对话中都会记着这些。你可以随意更改或删除。"
          }
        }
      }
    },
    "Sidefolk needs your OK to use %@" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج Sidefolk إلى موافقتك لاستخدام %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk braucht dein Okay für %@"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk necesita tu permiso para usar %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk a besoin de votre accord pour utiliser %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ha bisogno del tuo OK per usare %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが%@を使うには許可が必要です"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk에서 %@ 앱을 사용하려면 허용이 필요해요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk precisa do seu OK para usar %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 需要你同意才能使用“%@”"
          }
        }
      }
    },
    "Sidefolk only touches files inside these folders. Anything it deletes goes to the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يلمس Sidefolk إلا الملفات داخل هذه المجلدات. كل ما يحذفه يذهب إلى سلة المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk rührt nur Dateien in diesen Ordnern an. Alles, was gelöscht wird, kommt in den Papierkorb."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk solo toca archivos dentro de estas carpetas. Todo lo que elimina va a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche qu’aux fichiers de ces dossiers. Tout ce qu’il supprime va dans la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tocca solo i file dentro queste cartelle. Ciò che elimina finisce nel Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが扱うのはこれらのフォルダ内のファイルだけです。削除したものはゴミ箱に入ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 이 폴더 안의 파일만 다뤄요. 삭제하는 것은 모두 휴지통으로 가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk só mexe em arquivos dentro destas pastas. Tudo o que ele apaga vai para o Lixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 只会动这些文件夹里的文件。它删除的任何东西都会进入废纸篓。"
          }
        }
      }
    },
    "Sidefolk only works inside your own home folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعمل Sidefolk إلا داخل مجلد المستخدم الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk arbeitet nur in deinem eigenen Benutzerordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk solo trabaja dentro de tu carpeta de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne travaille que dans votre propre dossier de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk lavora solo dentro la tua cartella Inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkはホームフォルダの中でのみ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 사용자의 홈 폴더 안에서만 작업해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk só trabalha dentro da sua pasta de início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 只在你自己的个人文件夹内工作。"
          }
        }
      }
    },
    "Sidefolk reads pages and uses Weather and Currency without asking. Once it has read something from outside, a site you haven't allowed still asks: that's where a page could make it send your data." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Sidefolk الصفحات ويستخدم الطقس والعملات دون سؤال. وبعد أن يقرأ شيئًا من الخارج، يظل الموقع الذي لم تسمح به يسأل: ففي هذه الحالة قد تدفعه صفحة إلى إرسال بياناتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk liest Seiten und nutzt Wetter und Währungen, ohne zu fragen. Sobald es etwas von außen gelesen hat, fragt es bei einer Website, die du nicht erlaubt hast, trotzdem: Dort könnte eine Seite es dazu bringen, deine Daten zu senden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk lee páginas y usa Clima y Divisas sin preguntar. Una vez que ha leído algo del exterior, un sitio que no has permitido sigue preguntando: ahí es donde una página podría hacer que envíe tus datos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk lit des pages et utilise Météo et Devises sans demander. Une fois qu’il a lu du contenu extérieur, un site que vous n’avez pas autorisé demande quand même : c’est là qu’une page pourrait l’amener à envoyer vos données."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk legge pagine e usa Meteo e Valute senza chiedere. Dopo aver letto qualcosa dall'esterno, un sito che non hai consentito chiede comunque: è lì che una pagina potrebbe fargli inviare i tuoi dati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkは確認なしでページを読み、「天気」と「通貨」を利用します。外部から何かを読み込んだあとは、許可していないサイトは引き続き確認します。ページに誘導されてデータを送ってしまうおそれがあるためです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 묻지 않고 페이지를 읽고 날씨와 통화 기능을 써요. 하지만 외부에서 무언가를 읽은 뒤에는 허용하지 않은 사이트는 여전히 물어봐요. 그때 페이지가 사용자의 데이터를 보내도록 유도할 수 있기 때문이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk lê páginas e usa Clima e Moedas sem perguntar. Depois de ler algo de fora, um site que você não permitiu ainda pergunta: é aí que uma página poderia fazê-lo enviar seus dados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 读取页面、使用“天气”和“货币”时不会询问。但读取过外部内容之后，对于你没有允许的网站仍会询问，因为页面可能借此让它发送你的数据。"
          }
        }
      }
    },
    "Sidefolk replaced your copy of %@ (%@) with its built-in version %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استبدل Sidefolk نسختك من %1$@ (%2$@) بإصداره المدمج %3$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk hat deine Kopie von %1$@ (%2$@) durch die integrierte Version %3$@ ersetzt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Sidefolk replaced your copy of %1$@ (%2$@) with its built-in version %3$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk reemplazó tu copia de %1$@ (%2$@) por su versión integrada %3$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk a remplacé votre copie de %1$@ (%2$@) par sa version intégrée %3$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ha sostituito la tua copia di %1$@ (%2$@) con la sua versione integrata %3$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが%1$@のコピー（%2$@）を、内蔵のバージョン%3$@に置き換えました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk에 들어 있는 내장 버전(%3$@)으로 %1$@ 사본(%2$@)을 교체했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk substituiu sua cópia de %1$@ (%2$@) pela versão incluída %3$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 已把你的 %1$@ 副本（%2$@）替换为内置版本 %3$@。"
          }
        }
      }
    },
    "Sidefolk saves a backup next to each file before changing it. Disconnect removes only what it added." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحفظ Sidefolk نسخة احتياطية بجانب كل ملف قبل تغييره. ولا يزيل «فصل» إلا ما أضافه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk legt vor jeder Änderung eine Sicherung neben der Datei an. „Trennen“ entfernt nur, was hinzugefügt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk guarda una copia de seguridad junto a cada archivo antes de cambiarlo. Desconectar quita solo lo que añadió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk enregistre une sauvegarde à côté de chaque fichier avant de le modifier. Déconnecter ne retire que ce qu’il a ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk salva un backup accanto a ogni file prima di modificarlo. Disconnetti rimuove solo ciò che ha aggiunto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkは変更前に各ファイルの横にバックアップを保存します。接続を解除すると、追加したものだけが削除されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 각 파일을 변경하기 전에 옆에 백업을 저장해요. 연결 해제는 Sidefolk가 추가한 것만 제거해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk salva um backup ao lado de cada arquivo antes de alterá-lo. Desconectar remove só o que ele adicionou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 在更改每个文件前都会在旁边保存一份备份。断开连接只会移除它添加的内容。"
          }
        }
      }
    },
