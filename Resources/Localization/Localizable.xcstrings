    "Forget a few that no longer matter, then try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احذف بعض المعلومات التي لم تعد مهمة، ثم حاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entferne ein paar, die nicht mehr wichtig sind, und versuche es dann erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Olvida algunos que ya no importen y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Supprimez-en quelques-unes qui ne comptent plus, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticane qualcuna che non conta più, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要になったものをいくつか忘れさせてから、もう一度お試しください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 이상 필요 없는 것을 몇 개 잊게 한 다음 다시 시도하세요."
          }
        },
        "pt-BR" : {
