    "%@ needs Git, which isn't on this Mac. Apple's Command Line Tools include it: open Terminal, type xcode-select --install, then restart Sidefolk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج %@ إلى Git، وهو غير موجود على هذا الـ Mac. تتضمّنه حزمة Command Line Tools من Apple: افتح Terminal، واكتب xcode-select --install، ثم أعد تشغيل Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ braucht Git, das auf diesem Mac nicht vorhanden ist. Die Command Line Tools von Apple enthalten es: Öffne das Terminal, gib xcode-select --install ein und starte Sidefolk dann neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ necesita Git, que no está en este Mac. Las herramientas de línea de comandos de Apple lo incluyen: abre Terminal, escribe xcode-select --install y reinicia Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ nécessite Git, qui n’est pas sur ce Mac. Les outils de ligne de commande d’Apple l’incluent : ouvrez Terminal, saisissez xcode-select --install, puis redémarrez Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ha bisogno di Git, che non è su questo Mac. Gli strumenti da riga di comando di Apple lo includono: apri Terminale, digita xcode-select --install, poi riavvia Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にはGitが必要ですが、このMacにはありません。AppleのコマンドラインデベロッパツールにGitが含まれています。ターミナルを開き、xcode-select --install と入力してから、Sidefolkを再起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 확장 프로그램에는 Git이 필요한데, 이 Mac에는 없어요. Apple의 명령행 개발자 도구에 포함되어 있어요. 터미널을 열고 xcode-select --install 명령을 입력한 다음 Sidefolk를 다시 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ precisa do Git, que não está neste Mac. As Command Line Tools da Apple incluem o Git: abra o Terminal, digite xcode-select --install e depois reinicie o Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 需要 Git，但这台 Mac 上没有。Apple 的命令行开发者工具中包含它：请打开终端，输入 xcode-select --install，然后重新启动 Sidefolk。"
          }
        }
      }
    },
