    "Sidefolk wrote this for you. It runs only with the permissions below, and you can read its files first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كتب Sidefolk هذا من أجلك. يعمل فقط بالأذونات الموضحة أدناه، ويمكنك قراءة ملفاته أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk hat das für dich geschrieben. Es läuft nur mit den Berechtigungen unten, und du kannst vorher seine Dateien lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk escribió esta extensión para ti. Solo se ejecuta con los permisos de abajo, y antes puedes leer sus archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk a écrit cette extension pour vous. Elle ne s’exécute qu’avec les autorisations ci-dessous, et vous pouvez d’abord lire ses fichiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ha scritto questa estensione per te. Viene eseguita solo con i permessi qui sotto, e puoi prima leggere i suoi file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これはSidefolkが作成したものです。下に示した権限の範囲でのみ動作し、先にファイルの内容を確認することもできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 사용자를 위해 작성했어요. 아래 권한으로만 실행되고, 먼저 파일을 읽어 볼 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk escreveu isto para você. Roda somente com as permissões abaixo, e você pode ler os arquivos antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是 Sidefolk 为你编写的。它只会使用下面列出的权限运行，你也可以先阅读它的文件。"
          }
        }
      }
    },
