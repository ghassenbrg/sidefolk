    "Edit notes, move them, mark tasks done, or move them to the Trash. Only you can empty the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديل الملاحظات ونقلها ووضع علامة على المهام المنجزة أو نقلها إلى سلة المهملات. أنت وحدك من يمكنه إفراغ سلة المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen bearbeiten, verschieben, Aufgaben abhaken oder in den Papierkorb legen. Nur du kannst den Papierkorb leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar notas, moverlas, marcar tareas como hechas o trasladarlas a la Papelera. Solo tú puedes vaciar la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier des notes, les déplacer, cocher des tâches, ou les placer dans la Corbeille. Vous seul pouvez vider la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificare note, spostarle, segnare attività come fatte o spostarle nel Cestino. Solo tu puoi svuotare il Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの編集や移動、タスクの完了、ゴミ箱への移動を行います。ゴミ箱を空にできるのはあなただけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 편집하고, 옮기고, 할 일을 완료로 표시하거나 휴지통으로 이동합니다. 휴지통은 나만 비울 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar notas, movê-las, marcar tarefas como feitas ou movê-las para o Lixo. Só você pode esvaziar o Lixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "编辑笔记、移动笔记、把任务标为完成，或移到废纸篓。只有你能清倒废纸篓。"
          }
        }
      }
    },
