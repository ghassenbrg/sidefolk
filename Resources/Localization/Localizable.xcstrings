    "Your key was saved for %@. Sidefolk only sends a key to the server it was saved for." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ مفتاحك لـ %@. لا يرسل Sidefolk المفتاح إلا إلى الخادم الذي حُفظ له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlüssel wurde für %@ gespeichert. Sidefolk sendet einen Schlüssel nur an den Server, für den er gespeichert wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave se guardó para %@. Sidefolk solo envía una clave al servidor para el que se guardó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé a été enregistrée pour %@. Sidefolk n’envoie une clé qu’au serveur pour lequel elle a été enregistrée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave è stata salvata per %@. Sidefolk invia una chiave solo al server per cui è stata salvata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーは%@用に保存されています。Sidefolkは、キーを保存先のサーバにしか送信しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키가 %@용으로 저장되어 있어요. Sidefolk는 키를 저장할 때 지정된 서버에만 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave foi salva para %@. O Sidefolk só envia uma chave ao servidor para o qual ela foi salva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密钥是为 %@ 保存的。Sidefolk 只会把密钥发送到它所对应的服务器。"
          }
        }
      }
    },
    "Your notes and messages go only to the AI you chose, and only what's needed for the request." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تذهب ملاحظاتك ورسائلك إلا إلى الذكاء الاصطناعي الذي اخترته، ولا يُرسل منها إلا ما يحتاج إليه الطلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
