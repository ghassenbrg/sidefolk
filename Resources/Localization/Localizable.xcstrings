    "Until I turn it off" : {
      "comment" : "When Focus or Quiet ends",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حتى أوقفه"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis ich es ausschalte"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hasta que lo desactive"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jusqu'à ce que je l'arrête"
          }
        },
