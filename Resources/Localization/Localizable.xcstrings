    "Tempo turns up when a reminder is less than 15 minutes away." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظهور Tempo يعني أن موعد تذكير سيحين خلال أقل من 15 دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo taucht auf, wenn eine Erinnerung weniger als 15 Minuten entfernt ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo aparece cuando faltan menos de 15 minutos para un recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo arrive quand un rappel est dans moins de 15 minutes."
          }
