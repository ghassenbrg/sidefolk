    "Sidefolk doesn't create hidden files or folders (names starting with a dot)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينشئ Sidefolk ملفات أو مجلدات مخفية (أسماء تبدأ بنقطة)."
          }
        },
        "de" : {
          "stringUnit" : {
