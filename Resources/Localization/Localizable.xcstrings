    "Type a request, or drop something on me." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اكتب طلبًا، أو أفلت شيئًا عليّ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib eine Anfrage ein oder zieh etwas auf mich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Escribe una petición o arrastra algo hasta mí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tapez une demande, ou déposez quelque chose sur moi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scrivi una richiesta, o trascina qualcosa su di me."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストを入力するか、何かをこちらにドロップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청을 입력하거나 저에게 무언가를 끌어다 놓으세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um pedido ou solte algo em mim."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入一个请求，或者把东西拖到我身上。"
          }
        }
      }
    },
