    "That took too long, so I stopped. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استغرق ذلك وقتًا طويلًا، لذا توقفت. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das hat zu lange gedauert, deshalb habe ich abgebrochen. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tardó demasiado, así que me detuve. No se ha cambiado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela prenait trop de temps, j’ai donc arrêté. Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ci voleva troppo, quindi ho smesso. Non è stato modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "時間がかかりすぎたため、停止しました。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "너무 오래 걸려서 멈췄어요. 아무것도 변경되지 않았어요."
