            "value" : "静かモードを終わります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 모드를 끌게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
