        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt in %@ den Sidefolk-Skill hinzu, der dem Agenten sagt, wann und wie er die Werkzeuge von Sidefolk nutzen soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
