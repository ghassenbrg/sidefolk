          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청 패널 단축키 길게 누르기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segurar o atalho para perguntar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住提问快捷键"
          }
        }
      }
    },
    "Hold the shortcut and talk, release to send. Esc cancels." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطوّلًا على الاختصار وتحدّث، ثم أفلت للإرسال. مفتاح Esc يلغي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte den Kurzbefehl gedrückt und sprich, zum Senden loslassen. Esc bricht ab."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado el atajo y habla; suéltalo para enviar. Con Esc se cancela."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez le raccourci et parlez, relâchez pour envoyer. Échap annule."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta l'abbreviazione e parla, rilascia per inviare. Esc annulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ショートカットを押したまま話し、離すと送信します。Escでキャンセルします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "단축키를 길게 누른 채 말하고, 손을 떼면 보내요. Esc 키로 취소해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure o atalho e fale; solte para enviar. Esc cancela."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住快捷键说话，松开即发送。按 Esc 键取消。"
          }
        }
      }
    },
    "Hold your talk shortcut. You can also press and hold %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مطوّلًا على اختصار التحدث. يمكنك أيضًا الضغط مطوّلًا على %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Halte deinen Kurzbefehl zum Sprechen gedrückt. Du kannst auch auf %@ klicken und halten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mantén pulsado tu atajo para hablar. También puedes mantener pulsado a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenez enfoncé votre raccourci pour parler. Vous pouvez aussi appuyer longuement sur %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tieni premuta la tua abbreviazione per parlare. Puoi anche tenere premuto %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話すためのショートカットを押し続けてください。%@を長押ししても話せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하기 단축키를 길게 누르세요. 컴패니언(%@)을 길게 눌러도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Segure seu atalho para falar. Você também pode pressionar e segurar %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按住你的说话快捷键。你也可以按住 %@。"
          }
        }
      }
    },
