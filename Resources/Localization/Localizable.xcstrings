          }
        }
      }
    },
    "Adds hooks to ~/.codex/hooks.json, so I notice when a session needs you or finishes. Codex asks you to trust them once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف خطافات (hooks) إلى ~/.codex/hooks.json حتى أنتبه عندما تحتاج إليك جلسة أو تنتهي. يطلب منك Codex الوثوق بها مرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt ~/.codex/hooks.json Hooks hinzu, damit ich merke, wenn eine Sitzung dich braucht oder fertig ist. Codex bittet dich einmalig, ihnen zu vertrauen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade hooks a ~/.codex/hooks.json para que me entere de cuándo una sesión te necesita o termina. Codex te pide que confíes en ellos una sola vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des hooks à ~/.codex/hooks.json, pour que je remarque quand une session a besoin de vous ou se termine. Codex vous demande de leur faire confiance une seule fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge hook a ~/.codex/hooks.json, così mi accorgo quando una sessione ha bisogno di te o finisce. Codex ti chiede una sola volta di considerarli attendibili."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.codex/hooks.jsonにフックを追加し、セッションで対応が必要になったときや終了したときに気づけるようにします。Codexから、一度だけ信頼するかどうか確認されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.codex/hooks.json에 훅을 추가해서 세션에서 확인이 필요하거나 세션이 끝나면 알아챌 수 있게 해요. Codex가 한 번 신뢰할지 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
