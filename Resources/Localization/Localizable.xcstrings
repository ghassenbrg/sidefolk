    "Always asks Codex for high reasoning effort; empty keeps the model above." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب دائمًا من Codex جهد تفكير عاليًا؛ إن تُرك فارغًا فسيُستخدم النموذج أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
