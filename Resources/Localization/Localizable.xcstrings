    },
    "This page shows no text I can read. It may need a browser or a sign-in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تعرض هذه الصفحة نصًا أستطيع قراءته. قد تحتاج إلى متصفح أو تسجيل دخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Seite zeigt keinen Text, den ich lesen kann. Vielleicht braucht sie einen Browser oder eine Anmeldung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta página no muestra texto que yo pueda leer. Puede que necesite un navegador o iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette page n’affiche aucun texte que je puisse lire. Elle demande peut-être un navigateur ou une connexion."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa pagina non mostra testo che io possa leggere. Forse richiede un browser o un accesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このページには読み取れるテキストがありません。ブラウザやサインインが必要かもしれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 페이지에는 읽을 수 있는 글이 없어요. 브라우저나 로그인이 필요할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta página não mostra nenhum texto que eu consiga ler. Talvez precise de um navegador ou de login."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这个页面没有我能读取的文字。它可能需要浏览器或登录。"
          }
        }
      }
    },
    "This removes every note, reminder, watcher, folder grant and extension, your history and logs, and the keys saved in your Keychain. Sidefolk starts fresh. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة كل ملاحظة وتذكير ومراقبة وإذن مجلد وملحق، وسجل طلباتك والسجلات، والمفاتيح المحفوظة في سلسلة المفاتيح. يبدأ Sidefolk من جديد. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Damit werden alle Notizen, Erinnerungen, Beobachtungen, Ordnerfreigaben und Erweiterungen entfernt, dein Verlauf und deine Protokolle sowie die Schlüssel in deinem Schlüsselbund. Sidefolk fängt neu an. Das lässt sich nicht widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina todas las notas, recordatorios, vigilancias, accesos a carpetas y extensiones, tu historial y tus registros, y las claves guardadas en tu llavero. Sidefolk empieza de cero. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime chaque note, rappel, surveillance, accès à un dossier et extension, votre historique et vos journaux, ainsi que les clés enregistrées dans votre trousseau. Sidefolk repart de zéro. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo rimuove ogni nota, promemoria, sentinella, accesso alle cartelle ed estensione, la tua cronologia e i log, e le chiavi salvate nel Portachiavi. Sidefolk riparte da zero. L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべてのメモ、リマインダー、監視、フォルダの許可、拡張機能、履歴とログ、キーチェーンに保存したキーが削除されます。Sidefolkは初期状態から始まります。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 메모, 미리 알림, 지켜보기, 폴더 권한, 확장 프로그램, 기록과 로그, 키체인에 저장된 키를 삭제해요. Sidefolk가 처음 상태로 시작돼요. 이 작업은 실행 취소할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso remove todas as notas, lembretes, monitoramentos, acessos a pastas e extensões, seu histórico e registros, e as chaves salvas nas suas Chaves. O Sidefolk recomeça do zero. Isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会移除所有笔记、提醒、监视、文件夹授权和扩展，你的历史记录和日志，以及保存在钥匙串中的密钥。Sidefolk 会重新开始。此操作无法撤销。"
          }
        }
      }
    },
    "This replaces Sidefolk's own %@ with a copy Sidefolk didn't sign. Its settings and what you always allowed for it won't carry over." : {
      "comment" : "Install sheet: an unsigned folder takes the place of a signed extension; its name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستبدل هذا %@ من Sidefolk بنسخة لم توقّعها Sidefolk. لن تنتقل إعداداته وما سمحت به دائمًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ersetzt Sidefolks %@ durch eine Kopie, die Sidefolk nicht signiert hat. Ihre Einstellungen und was du ihr immer erlaubt hast, werden nicht übernommen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto sustituye %@ de Sidefolk por una copia que Sidefolk no ha firmado. Sus ajustes y lo que siempre le permitiste no se conservarán."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci remplace %@ de Sidefolk par une copie que Sidefolk n’a pas signée. Ses réglages et ce que vous lui aviez toujours autorisé ne seront pas repris."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce %@ di Sidefolk con una copia che Sidefolk non ha firmato. Le sue impostazioni e ciò che le avevi sempre consentito non verranno mantenuti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkの%@を、Sidefolkが署名していないコピーに置き換えます。設定と「常に許可」した内容は引き継がれません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk의 %@을(를) Sidefolk가 서명하지 않은 사본으로 바꿔요. 설정과 항상 허용한 내용은 이어지지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso substitui %@ da Sidefolk por uma cópia que a Sidefolk não assinou. Os ajustes dela e o que você sempre permitiu não serão mantidos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这会把 Sidefolk 的 %@ 换成未经 Sidefolk 签名的副本。它的设置和你一直允许的内容不会保留。"
          }
        }
      }
    },
