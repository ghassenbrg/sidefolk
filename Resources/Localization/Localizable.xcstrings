    "%@ changed %@. I put it on hold until you review the change in Settings › Add-ons." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر %1$@ الأداة %2$@. أوقفتها مؤقتًا إلى أن تراجع التغيير في الإعدادات › الإضافات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ geändert. Ich habe es angehalten, bis du die Änderung in Einstellungen › Add-ons prüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
