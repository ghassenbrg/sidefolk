    },
    "The latest posts of blogs, news sites and podcasts from their RSS or Atom feeds, and a heads-up when a new one appears." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحدث منشورات المدونات ومواقع الأخبار والبودكاست من خلاصات RSS أو Atom، وتنبيه حين يظهر منشور جديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neuesten Beiträge von Blogs, Nachrichtenseiten und Podcasts aus ihren RSS- oder Atom-Feeds und ein Hinweis, wenn ein neuer erscheint."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las últimas publicaciones de blogs, sitios de noticias y pódcasts a través de sus fuentes RSS o Atom, y un aviso cuando aparece una nueva."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les derniers articles de blogs, de sites d’actualité et de podcasts via leurs flux RSS ou Atom, et une alerte quand un nouveau paraît."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli ultimi post di blog, siti di notizie e podcast dai loro feed RSS o Atom, e un avviso quando ne esce uno nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ブログ、ニュースサイト、ポッドキャストのRSSまたはAtomフィードから最新の投稿を表示し、新しい投稿があれば知らせます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "블로그, 뉴스 사이트, 팟캐스트의 RSS나 Atom 피드에서 최신 글을 보여 주고, 새 글이 올라오면 알려 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As últimas publicações de blogs, sites de notícias e podcasts pelos feeds RSS ou Atom, e um aviso quando sai uma nova."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通过 RSS 或 Atom 订阅源获取博客、新闻网站和播客的最新文章，有新文章时提醒你。"
          }
        }
      }
    },
    "The manifest describes %@, but the program doesn't offer a tool by that name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصف ملف البيان %@، لكن البرنامج لا يوفّر أداة بهذا الاسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Manifest beschreibt %@, aber das Programm bietet kein Werkzeug mit diesem Namen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El manifiesto describe %@, pero el programa no ofrece ninguna herramienta con ese nombre."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le manifeste décrit %@, mais le programme ne propose pas d’outil de ce nom."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il manifest descrive %@, ma il programma non offre uno strumento con quel nome."
          }
        },
        "ja" : {
          "stringUnit" : {
