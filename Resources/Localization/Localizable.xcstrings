    "I only heard silence from %@. Check it's the microphone you're talking into, in System Settings › Sound." : {
      "comment" : "A microphone's name, like “MacBook Pro Microphone”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمع من %@ سوى الصمت. تحقّق في إعدادات النظام › الصوت من أنه الميكروفون الذي تتحدث فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vom %@ kam nur Stille. Prüfe in Systemeinstellungen › Ton, ob das das Mikrofon ist, in das du sprichst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo oí silencio del %@. Comprueba en Ajustes del Sistema › Sonido que es el micrófono al que le hablas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je n’ai entendu que du silence du %@. Vérifiez dans Réglages Système › Son que c’est bien le microphone dans lequel vous parlez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dal %@ ho sentito solo silenzio. Controlla in Impostazioni di Sistema › Suono che sia il microfono in cui stai parlando."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@からは無音しか聞こえませんでした。システム設定 › サウンドで、話しかけているマイクが選ばれているか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에서 조용한 소리만 들렸어요. 시스템 설정 › 사운드에서 말하고 있는 마이크가 맞는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só ouvi silêncio do %@. Confira em Ajustes do Sistema › Som se é o microfone em que você está falando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
