    "Notes, reminders and watches still work. Questions need an AI." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas, los recordatorios y las vigilancias siguen funcionando. Las preguntas necesitan una IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes, les rappels et les surveillances fonctionnent toujours. Les questions nécessitent une IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, promemoria e sentinelle funzionano comunque. Per le domande serve un'IA."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 미리 알림, 지켜보기는 계속 작동해요. 질문에는 AI가 필요해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, lembretes e monitoramentos continuam funcionando. As perguntas precisam de uma IA."
          }
        }
      }
    },
    "Notes, reminders and watches work without AI. AI is only used for questions and open-ended requests." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas, los recordatorios y las vigilancias funcionan sin IA. La IA solo se usa para preguntas y peticiones abiertas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les notes, les rappels et les surveillances fonctionnent sans IA. L’IA ne sert qu’aux questions et aux demandes ouvertes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, promemoria e sentinelle funzionano senza IA. L'IA si usa solo per domande e richieste aperte."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 미리 알림, 지켜보기는 AI 없이도 작동해요. AI는 질문과 자유로운 요청에만 사용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, lembretes e monitoramentos funcionam sem IA. A IA só é usada para perguntas e pedidos abertos."
          }
        }
      }
    },
    "Notes, reminders, watches and settings as one JSON file. No keys." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, recordatorios, vigilancias y ajustes en un solo archivo JSON. Sin claves."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes, rappels, surveillances et réglages dans un seul fichier JSON. Sans les clés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, promemoria, sentinelle e impostazioni in un unico file JSON. Senza chiavi."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 미리 알림, 지켜보기, 설정을 JSON 파일 하나로 내보내요. 키는 포함되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, lembretes, monitoramentos e ajustes num só arquivo JSON. Sem chaves."
          }
        }
      }
    },
    "Notes, reminders, watches, history, logs and saved keys. This can't be undone." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, recordatorios, vigilancias, historial, registros y claves guardadas. Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notes, rappels, surveillances, historique, journaux et clés enregistrées. Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Note, promemoria, sentinelle, cronologia, log e chiavi salvate. L'operazione non può essere annullata."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 미리 알림, 지켜보기, 기록, 로그, 저장된 키. 이 작업은 실행 취소할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, lembretes, monitoramentos, histórico, registros e chaves salvas. Isso não pode ser desfeito."
          }
        }
      }
    },
