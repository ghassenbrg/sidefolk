    "Open it and drag Sidefolk to the Applications folder, replacing this one. Your notes, reminders and settings stay." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "افتح صورة القرص واسحب Sidefolk إلى مجلد التطبيقات ليحلّ محل هذه النسخة. تبقى ملاحظاتك وتذكيراتك وإعداداتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffne das Festplattenabbild und ziehe Sidefolk in den Ordner „Programme“, um diese Kopie zu ersetzen. Deine Notizen, Erinnerungen und Einstellungen bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ábrela y arrastra Sidefolk a la carpeta Aplicaciones para reemplazar esta copia. Tus notas, recordatorios y ajustes se conservan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvrez-la et faites glisser Sidefolk dans le dossier Applications pour remplacer cette copie. Vos notes, vos rappels et vos réglages sont conservés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aprila e trascina Sidefolk nella cartella Applicazioni per sostituire questa copia. Le tue note, i promemoria e le impostazioni restano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクイメージを開き、Sidefolkを「アプリケーション」フォルダにドラッグして、今のSidefolkと置き換えてください。メモ、リマインダー、設定はそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "열어서 Sidefolk를 응용 프로그램 폴더로 끌어다 놓아 지금 앱을 교체하세요. 메모, 미리 알림, 설정은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abra a imagem de disco e arraste o Sidefolk para a pasta Aplicativos, substituindo esta cópia. Suas notas, lembretes e ajustes continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打开它，把 Sidefolk 拖到“应用程序”文件夹，替换现有的这个。你的笔记、提醒和设置会保留。"
          }
        }
      }
    },
