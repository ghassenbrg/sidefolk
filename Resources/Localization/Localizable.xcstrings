    "Events from your Mac's calendar are read only here. Change them in Calendar." : {
      "comment" : "Under the Calendar's week, when it shows the Mac calendar's events",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحداث تقويم Mac للقراءة فقط هنا. غيّرها في تطبيق التقويم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Termine aus dem Kalender deines Macs kannst du hier nur ansehen. Ändere sie in Kalender."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los eventos del calendario de tu Mac son de solo lectura aquí. Cámbialos en Calendario."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les événements du calendrier de votre Mac sont en lecture seule ici. Modifiez-les dans Calendrier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli eventi del calendario del tuo Mac qui sono di sola lettura. Modificali in Calendario."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Macのカレンダーの予定はここでは閲覧のみです。変更はカレンダーで行ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mac 캘린더의 일정은 여기서 읽기만 할 수 있어요. 캘린더에서 바꾸세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os eventos do calendário do seu Mac são somente leitura aqui. Altere-os no Calendário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你 Mac 日历中的日程在这里只能查看。请在“日历”中修改。"
          }
        }
      }
    },
    "Every %@ is the fastest for this; I'll check every %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل %1$@ هي أسرع وتيرة لهذا النوع؛ سأتحقق كل %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schneller als alle %1$@ geht das hier nicht; ich prüfe alle %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every %1$@ is the fastest for this; I'll check every %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada %1$@ es lo más rápido posible para esto; comprobaré cada %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les %1$@, c’est le plus rapide possible ici ; je vérifierai toutes les %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni %1$@ è l'intervallo più breve possibile per questo; controllerò ogni %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この表示では%1$@ごとが最短です。%2$@ごとに確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@마다 확인하는 것이 이 항목에서 가장 빠른 주기예요. %2$@마다 확인할게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais rápido para isso é a cada %1$@; vou verificar a cada %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这类数值最快每 %1$@ 更新一次，所以我会每 %2$@ 检查一次。"
          }
        }
      }
    },
