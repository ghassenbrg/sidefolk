    "A minute after Sidefolk starts and then once a day. It always asks before installing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد دقيقة من بدء Sidefolk، ثم مرة واحدة كل يوم. يسأل دائمًا قبل التثبيت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Minute nach dem Start von Sidefolk und danach einmal am Tag. Installiert wird immer erst nach Rückfrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuto después de que Sidefolk se inicie y luego una vez al día. Siempre pregunta antes de instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une minute après le démarrage de Sidefolk, puis une fois par jour. Il demande toujours avant d’installer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuto dopo l'avvio di Sidefolk e poi una volta al giorno. Chiede sempre prima di installare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkの起動から1分後に1回、その後は1日に1回確認します。インストールする前には必ず許可を求めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk를 시작하고 1분 뒤에 한 번, 그 후로는 하루에 한 번 확인해요. 설치하기 전에는 항상 먼저 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um minuto depois de o Sidefolk iniciar e, depois, uma vez por dia. Sempre pergunta antes de instalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 启动一分钟后检查一次，之后每天检查一次。安装前一定会先询问你。"
          }
        }
      }
    },
