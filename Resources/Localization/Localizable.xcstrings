          "stringUnit" : {
            "state" : "translated",
            "value" : "我会结束安静模式。"
          }
        }
      }
    },
    "I'll stop watching that." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأتوقف عن مراقبة ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich beobachte das nicht mehr."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dejaré de vigilar eso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "J’arrêterai de surveiller cela."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Smetterò di tenerlo d’occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "その監視を止めます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그것을 더 이상 지켜보지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou parar de monitorar isso."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会停止监视那个。"
          }
        }
      }
    },
    "I'll tell you %@" : {
      "localizations" : {
        "ar" : {
