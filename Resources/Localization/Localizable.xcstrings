    "Its saved settings are incomplete." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداداته المحفوظة غير مكتملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die gespeicherten Einstellungen sind unvollständig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus ajustes guardados están incompletos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ses réglages enregistrés sont incomplets."
          }
        },
        "it" : {
