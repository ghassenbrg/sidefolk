    "Adds a link at ~/.local/bin/sidefolk so you can type “sidefolk run -- npm test” in a terminal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف رابطًا في ~/.local/bin/sidefolk لتتمكن من كتابة «sidefolk run -- npm test» في Terminal."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legt unter ~/.local/bin/sidefolk einen Link an, damit du „sidefolk run -- npm test“ im Terminal eingeben kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade un enlace en ~/.local/bin/sidefolk para que puedas escribir “sidefolk run -- npm test” en un terminal."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
