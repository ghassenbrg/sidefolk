          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios no se están ejecutando, así que no puedo crear uno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels ne sont pas lancés, je ne peux donc pas en créer un."
