    "Codex answers from now on. You can change that in Settings › AI." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيجيب Codex من الآن فصاعدًا. يمكنك تغيير ذلك في الإعدادات › الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab jetzt antwortet Codex. Das kannst du in Einstellungen › KI ändern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex responde a partir de ahora. Puedes cambiarlo en Ajustes › IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codex répond désormais. Vous pouvez changer cela dans Réglages › IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Da ora risponde Codex. Puoi cambiare questa scelta in Impostazioni › IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今後はCodexが答えます。設定 › AIで変更できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "앞으로는 Codex가 답해요. 설정 › AI에서 바꿀 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Codex responde a partir de agora. Você pode mudar isso em Ajustes › IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从现在起由 Codex 来回答。你可以在设置 › AI 中更改。"
          }
        }
      }
    },
