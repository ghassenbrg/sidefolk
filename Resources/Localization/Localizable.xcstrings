    "Not installed. Download LM Studio, get a model that can use tools, and start its server." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مثبّت. نزّل LM Studio، واحصل على نموذج يمكنه استخدام الأدوات، ثم شغّل خادمه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht installiert. Lade LM Studio herunter, hol dir ein Modell, das Werkzeuge verwenden kann, und starte den Server."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No instalado. Descarga LM Studio, consigue un modelo que pueda usar herramientas e inicia su servidor."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non installé. Téléchargez LM Studio, récupérez un modèle capable d’utiliser des outils et démarrez son serveur."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non installato. Scarica LM Studio, prendi un modello che sappia usare gli strumenti e avvia il suo server."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされていません。LM Studioをダウンロードし、ツールを使えるモデルを入手して、サーバを起動してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치되어 있지 않아요. LM Studio를 다운로드하고, 도구를 사용할 수 있는 모델을 받은 다음 서버를 시작하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não instalado. Baixe o LM Studio, obtenha um modelo que saiba usar ferramentas e inicie o servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "未安装。请下载 LM Studio，获取一个能使用工具的模型，然后启动它的服务器。"
          }
        }
      }
    },
    "Not installed. Download Ollama, then get a model that can use tools:" : {
