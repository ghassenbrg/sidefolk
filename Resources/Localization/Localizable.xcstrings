    "Running, but no model is loaded. Load one in LM Studio, then click Look again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل، لكن لم يُحمَّل أي نموذج. حمّل نموذجًا في LM Studio، ثم انقر على «البحث مجددًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft, aber kein Modell ist geladen. Lade eines in LM Studio und klicke dann auf „Erneut suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En marcha, pero no hay ningún modelo cargado. Carga uno en LM Studio y haz clic en Volver a buscar."
          }
