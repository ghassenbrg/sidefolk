    "Nobody answered by %@, so the task stopped here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُجب أحد بحلول %@، لذا توقفت المهمة هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis %@ kam keine Antwort, deshalb wurde die Aufgabe hier gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió (%@), así que la tarea se detuvo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a répondu avant %@, la tâche s’est donc arrêtée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto entro %@, quindi l'operazione si è fermata qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までに答えがなかったため、タスクはここで停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 아무도 답하지 않아서 작업이 여기서 멈췄어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém respondeu até %@, então a tarefa parou aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "到 %@ 仍无人回答，所以任务在这里停止了。"
          }
        }
      }
    },
    "Nobody answered by %@, so the task went on without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُجب أحد بحلول %@، لذا واصلت المهمة عملها من دون هذه الخطوة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bis %@ kam keine Antwort, deshalb ging die Aufgabe ohne diesen Schritt weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió (%@), así que la tarea siguió sin ese paso."
          }
        },
        "fr" : {
          "stringUnit" : {
