    "Mark it open first, or set a reminder without it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدّدها كغير منجزة أولًا، أو اضبط تذكيرًا بدونها."
          }
