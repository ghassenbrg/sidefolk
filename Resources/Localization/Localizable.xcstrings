    "Free, and your requests stay on this Mac (except with Ollama's Cloud models). Pick a model that can use tools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجاني، وتبقى طلباتك على هذا الـ Mac (باستثناء نماذج Ollama السحابية). اختر نموذجًا يمكنه استخدام الأدوات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kostenlos, und deine Anfragen bleiben auf diesem Mac (außer bei den Cloud-Modellen von Ollama). Wähle ein Modell, das Werkzeuge verwenden kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratis, y tus peticiones se quedan en este Mac (salvo con los modelos en la nube de Ollama). Elige un modelo que pueda usar herramientas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuit, et vos demandes restent sur ce Mac (sauf avec les modèles Cloud d’Ollama). Choisissez un modèle capable d’utiliser des outils."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito, e le tue richieste restano su questo Mac (tranne con i modelli Cloud di Ollama). Scegli un modello che sappia usare gli strumenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "無料で、リクエストはこのMacの外に出ません（Ollamaのクラウドモデルを除く）。ツールを使えるモデルを選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무료이고 요청이 이 Mac 밖으로 나가지 않아요(Ollama 클라우드 모델 제외). 도구를 사용할 수 있는 모델을 고르세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gratuito, e seus pedidos ficam neste Mac (exceto com os modelos na nuvem do Ollama). Escolha um modelo que saiba usar ferramentas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "免费，而且你的请求只留在这台 Mac 上（Ollama 的云端模型除外）。请选择能使用工具的模型。"
          }
        }
      }
