        }
      }
    },
    "I'll keep trying, a little less often each time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأواصل المحاولة، بوتيرة أقل قليلًا في كل مرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich versuche es weiter, jedes Mal etwas seltener."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seguiré intentándolo, cada vez con algo menos de frecuencia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je continue d’essayer, un peu moins souvent à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuo a provare, un po' meno spesso ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間隔を少しずつ空けながら、引き続き試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 시도할게요. 시도할 때마다 간격을 조금씩 늘릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou continuar tentando, com um pouco menos de frequência a cada vez."
