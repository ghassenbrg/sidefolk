    "I'll add myself to Claude Code and Codex. You'll see exactly what changes, and I keep a backup." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأضيف نفسي إلى Claude Code وCodex. سترى بالضبط ما يتغيّر، وأحتفظ بنسخة احتياطية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich trage mich bei Claude Code und Codex ein. Du siehst genau, was sich ändert, und ich lege eine Sicherung an."
          }
        },
        "es" : {
          "stringUnit" : {
