    "%@ It's already down, so I'll tell you if it comes back and goes down again." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ya no responde, así que te avisaré si vuelve a responder y luego deja de hacerlo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il est déjà inaccessible, donc je vous préviendrai s’il revient puis retombe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ È già offline, quindi ti avviso se torna online e poi va di nuovo offline."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이미 다운된 상태라서, 다시 작동했다가 또 다운되면 알려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Já está fora do ar, então aviso se voltar e cair de novo."
          }
        }
      }
