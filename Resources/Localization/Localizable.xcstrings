    "The new version would be allowed to do more, so it waits until you've seen what's new." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيُسمح للإصدار الجديد بفعل المزيد، لذا ينتظر حتى ترى ما الجديد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Version dürfte mehr, deshalb wartet sie, bis du gesehen hast, was neu ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La nueva versión podría hacer más, así que espera hasta que hayas visto qué cambia."
