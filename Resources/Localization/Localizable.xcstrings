        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não vou criar “%@”, porque esse tipo de item pode executar programas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我不会创建“%@”，因为这类项目可以运行程序。"
          }
        }
      }
    },
    "I won't move %@, because that kind of item can run programs." : {
