    "A glance now and then, never a stare." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نظرة بين حين وآخر، لا تحديق أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ab und zu ein Blick, nie ein Starren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una mirada de vez en cuando, sin quedarse mirando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un coup d’œil de temps en temps, jamais un regard fixe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un'occhiata ogni tanto, senza mai fissarti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ときどきちらっと見るだけ。じっと見つめたりはしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "가끔 흘끗 볼 뿐, 빤히 쳐다보지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma olhada de vez em quando, nunca um olhar fixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "偶尔看一眼，从不一直盯着。"
          }
        }
      }
    },
    "A link now points somewhere else on the way to %@, so I stopped looking there." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صار رابط في الطريق إلى %@ يشير إلى مكان آخر، لذا توقفت عن البحث هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Link auf dem Weg zu %@ zeigt jetzt woandershin, deshalb schaue ich dort nicht mehr nach."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora un enlace apunta a otro lugar en el camino hacia %@, así que dejé de buscar ahí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un lien pointe désormais ailleurs sur le chemin de %@, j’ai donc arrêté de regarder là."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un link ora porta altrove lungo il percorso verso %@, quindi ho smesso di cercare lì."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@への経路にあるリンクが別の場所を指すようになったため、そこを見るのをやめました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 경로 중간의 링크가 다른 곳을 가리키게 되어서 그곳 확인을 멈췄어요."
