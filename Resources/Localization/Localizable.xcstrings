    "%@ I'll keep checking and tell you when it's back up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سأواصل الفحص وأخبرك عندما يعود إلى العمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ich prüfe weiter und sage dir Bescheid, sobald es wieder erreichbar ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Seguiré comprobando y te avisaré cuando vuelva a responder."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Je continue de vérifier et vous préviens dès qu’il est de nouveau accessible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Continuo a controllare e ti avviso quando torna online."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@引き続き確認し、復旧したらお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 계속 확인하다가 다시 작동하면 알려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vou continuar verificando e aviso quando voltar ao ar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@我会继续检查，恢复正常后告诉你。"
          }
        }
      }
    },
    "%@ I'll keep trying." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ سأواصل المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ich versuche es weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Seguiré intentándolo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Je continue d’essayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Continuo a provare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@引き続き試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 계속 시도할게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Vou continuar tentando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@我会继续尝试。"
          }
        }
      }
    },
    "%@ It's already down, so I'll tell you if it comes back and goes down again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ إنه متوقف بالفعل، لذا سأخبرك إذا عاد ثم توقف مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Es ist schon jetzt nicht erreichbar. Ich sage dir Bescheid, wenn es wieder da ist und dann erneut ausfällt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Ya no responde, así que te avisaré si vuelve a responder y luego deja de hacerlo otra vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Il est déjà inaccessible, donc je vous préviendrai s’il revient puis retombe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ È già offline, quindi ti avviso se torna online e poi va di nuovo offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@すでにダウンしているため、復旧したあと再びダウンしたときにお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 이미 다운된 상태라서, 다시 작동했다가 또 다운되면 알려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ Já está fora do ar, então aviso se voltar e cair de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@它现在已经无法访问，所以等它恢复后再次中断时，我会告诉你。"
          }
        }
      }
    },
