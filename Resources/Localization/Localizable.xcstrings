          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropicから読み取れない応答が返されました。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic에서 읽을 수 없는 응답을 보냈어요. 아무것도 변경되지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Anthropic enviou uma resposta que não consegui ler. Nada foi alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic 返回了我无法读取的回答。没有做任何更改。"
          }
        }
      }
    },
    "Anthropic turned the request down for a billing reason. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفض Anthropic الطلب لسبب يتعلق بالفوترة. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic hat die Anfrage aus Abrechnungsgründen abgelehnt. Es wurde nichts geändert."
