    "Sidefolk asks every time it would read a page or use an online service you didn't name, and doesn't remember your answers." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل Sidefolk في كل مرة يريد فيها قراءة صفحة أو استخدام خدمة عبر الإنترنت لم تسمّها، ولا يتذكّر إجاباتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk fragt jedes Mal, wenn es eine Seite lesen oder einen Onlinedienst nutzen würde, den du nicht genannt hast, und merkt sich deine Antworten nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk pregunta cada vez que va a leer una página o usar un servicio en línea que no nombraste, y no recuerda tus respuestas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque fois que Sidefolk s’apprête à lire une page ou à utiliser un service en ligne que vous n’avez pas nommé, il demande, et il ne retient pas vos réponses."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk chiede ogni volta che sta per leggere una pagina o usare un servizio online che non hai nominato, e non ricorda le tue risposte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "指定していないページを読んだりオンラインサービスを使ったりするとき、Sidefolkは毎回確認し、その答えを記憶しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 지정하지 않은 페이지를 읽거나 온라인 서비스를 쓸 때마다 Sidefolk가 묻고, 답변은 기억하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk pergunta sempre que for ler uma página ou usar um serviço on-line que você não citou, e não guarda suas respostas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每当 Sidefolk 要读取你没有指明的页面，或使用你没有指明的在线服务时，都会询问你，并且不会记住你的回答。"
          }
        }
      }
    },
    "Sidefolk couldn't arrange to reopen, so the update was put back." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Sidefolk ترتيب إعادة الفتح، لذا جرى التراجع عن التحديث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk konnte das erneute Öffnen nicht einrichten, deshalb wurde das Update rückgängig gemacht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no pudo organizar su reapertura, así que se revirtió la actualización."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’a pas pu organiser sa réouverture, la mise à jour a donc été annulée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non ha potuto organizzare la riapertura, quindi l'aggiornamento è stato annullato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkを再び開く手配ができなかったため、アップデートを元に戻しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk를 다시 열도록 설정하지 못해서 업데이트를 되돌렸어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não conseguiu programar a reabertura, então a atualização foi desfeita."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 无法安排重新打开，所以已撤回这次更新。"
          }
        }
      }
    },
    "Sidefolk couldn't copy the new version beside itself." : {
