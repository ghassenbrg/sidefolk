    "What %@ and your agents do, the conversations you have and what was noticed for you show up here, with Undo where it can be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يفعله %@ ووكلاؤك، ومحادثاتك، وما لوحظ لأجلك يظهر هنا، مع التراجع حيث يمكن."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was %@ und deine Agenten tun, deine Gespräche und was für dich bemerkt wurde, erscheinen hier, mit Widerrufen, wo es geht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que hacen %@ y tus agentes, tus conversaciones y lo que se notó para ti aparecen aquí, con Deshacer donde se pueda."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que font %@ et vos agents, vos conversations et ce qui a été remarqué pour vous s’affichent ici, avec Annuler quand c’est possible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che fanno %@ e i tuoi agenti, le tue conversazioni e ciò che è stato notato per te appaiono qui, con Annulla dove possibile."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@とエージェントがしたこと、会話、あなたのために気づいたことがここに表示されます。取り消せるものには「取り消す」があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@과(와) 에이전트가 한 일, 대화, 당신을 위해 알아챈 것이 여기에 표시돼요. 되돌릴 수 있으면 실행 취소도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que %@ e seus agentes fazem, suas conversas e o que foi percebido para você aparecem aqui, com Desfazer quando possível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 和你的智能体所做的事、你的对话以及为你注意到的事都会显示在这里，能撤销的会提供撤销。"
          }
        }
      }
    },
