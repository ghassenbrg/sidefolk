    "Make sure %@ is running, and check the address in Settings › AI." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تأكد من أن %@ قيد التشغيل، وتحقّق من العنوان في الإعدادات › الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stelle sicher, dass %@ läuft, und prüfe die Adresse in Einstellungen › KI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que %@ se está ejecutando y comprueba la dirección en Ajustes › IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que %@ est lancé, et vérifiez l’adresse dans Réglages › IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che %@ sia in esecuzione e controlla l'indirizzo in Impostazioni › IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が動作していることを確かめ、設定 › AIでアドレスを確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 실행 중인지 확인하고, 설정 › AI에서 주소를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
