    "%@ kept crashing, so I turned it off. You can turn it back on in Settings › Add-ons." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظل %@ يتعطل، لذا أوقفته. يمكنك تشغيله مجددًا من الإعدادات › الإضافات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist immer wieder abgestürzt, deshalb habe ich die Erweiterung ausgeschaltet. Du kannst sie in Einstellungen › Add-ons wieder einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fallaba una y otra vez, así que la desactivé. Puedes volver a activarla en Ajustes › Complementos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’extension %@ plantait sans cesse, je l’ai donc désactivée. Vous pouvez la réactiver dans Réglages › Modules."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ continuava a bloccarsi, quindi l'ho disattivata. Puoi riattivarla in Impostazioni › Componenti aggiuntivi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@が繰り返しクラッシュしたため、オフにしました。設定 › アドオンで再びオンにできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 애드온이 계속 멈춰서 꺼 두었어요. 설정 › 애드온에서 다시 켤 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
