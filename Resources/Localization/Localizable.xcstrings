        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimenticane qualcuna che non conta più, poi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要になったものをいくつか忘れさせてから、もう一度お試しください。"
