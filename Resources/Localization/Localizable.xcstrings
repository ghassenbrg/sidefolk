    "A PDF's details and text, several PDFs combined into one, and some of their pages saved as a new PDF. Your originals stay as they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفاصيل ملف PDF ونصه، ودمج عدة ملفات PDF في ملف واحد، وحفظ بعض صفحاتها في ملف PDF جديد. تبقى ملفاتك الأصلية كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details und Text eines PDFs, mehrere PDFs zu einem zusammengefügt und einzelne Seiten als neues PDF gespeichert. Deine Originale bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los detalles y el texto de un PDF, varios PDF unidos en uno, y algunas de sus páginas guardadas como un PDF nuevo. Tus originales se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les détails et le texte d’un PDF, plusieurs PDF réunis en un seul, et certaines de leurs pages enregistrées dans un nouveau PDF. Vos originaux restent tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dettagli e il testo di un PDF, più PDF uniti in uno, e alcune pagine salvate come nuovo PDF. I tuoi originali restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDFの詳細とテキストの読み取り、複数のPDFの結合、一部のページを新しいPDFとして保存。元のファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF의 정보와 텍스트, 여러 PDF를 하나로 합치기, 일부 페이지를 새 PDF로 저장하기. 원본은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os detalhes e o texto de um PDF, vários PDFs juntos em um só, e algumas páginas salvas como um novo PDF. Seus originais ficam como estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "PDF 的信息和文字，把多个 PDF 合并成一个，以及把部分页面另存为新的 PDF。原始文件保持不变。"
          }
        }
      }
    },
