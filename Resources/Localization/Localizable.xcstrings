        }
      }
    },
    "What “tomorrow morning”, “this afternoon” and “this evening” mean. “Tonight” is 21:00." : {
      "comment" : "Settings › General › Words for times",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما تعنيه «صباح الغد» و«بعد الظهر» و«هذا المساء». و«الليلة» تعني 21:00."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was „morgen früh“, „heute Nachmittag“ und „heute Abend“ bedeuten. „Heute Nacht“ ist 21:00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que significan «mañana por la mañana», «esta tarde» y «esta noche». «Por la noche» es a las 21:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que veulent dire « demain matin », « cet après-midi » et « ce soir ». « Cette nuit » est 21:00."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa significano «domattina», «oggi pomeriggio» e «stasera». «Stanotte» sono le 21:00."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「明日の朝」「今日の午後」「今日の夕方」が指す時刻。「今夜」は 21:00 です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“내일 아침”, “오늘 오후”, “오늘 저녁”이 뜻하는 시각. “오늘 밤”은 21:00이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que significam “amanhã de manhã”, “hoje à tarde” e “hoje à noite”. “Esta noite” é às 21:00."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“明天早上”“今天下午”“今天傍晚”分别指几点。“今晚”是 21:00。"
          }
        }
      }
    },
