    "In System Settings › Privacy & Security › Automation, switch on %@ under Sidefolk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في إعدادات النظام › الخصوصية والأمن › الأتمتة، شغّل %@ تحت Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schalte in Systemeinstellungen › Datenschutz & Sicherheit › Automation unter Sidefolk %@ ein."
