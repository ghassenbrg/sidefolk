    "That secure (https) address tried to send me to an insecure (http) one, so I stopped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حاول هذا العنوان الآمن (https) توجيهي إلى عنوان غير آمن (http)، لذا توقفت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese sichere Adresse (https) wollte mich zu einer unsicheren (http) weiterleiten, deshalb habe ich aufgehört."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa dirección segura (https) intentó llevarme a una no segura (http), así que me detuve."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette adresse sécurisée (https) a tenté de me rediriger vers une adresse non sécurisée (http), j’ai donc arrêté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quell'indirizzo sicuro (https) ha provato a mandarmi a uno non sicuro (http), quindi ho smesso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全な（https）アドレスから安全でない（http）アドレスに転送されそうになったため、中止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안전한(https) 주소가 안전하지 않은(http) 주소로 보내려고 해서 멈췄어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esse endereço seguro (https) tentou me mandar para um inseguro (http), então parei."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
