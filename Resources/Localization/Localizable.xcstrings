    "Web addresses with a name and password in them aren't allowed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عناوين الويب التي تتضمن اسمًا وكلمة سر غير مسموح بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Webadressen mit Name und Passwort darin sind nicht erlaubt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se permiten direcciones web que incluyan un nombre de usuario y una contraseña."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les adresses Web contenant un nom et un mot de passe ne sont pas autorisées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gli indirizzi web con nome utente e password non sono consentiti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "名前とパスワードを含むWebアドレスは使えません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이름과 암호가 들어 있는 웹 주소는 허용되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endereços da web com nome de usuário e senha não são permitidos."
          }
        },
