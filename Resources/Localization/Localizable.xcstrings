    "Some tools changed since you installed it; they're on hold until you approve the change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت بعض الأدوات منذ تثبيته؛ وهي متوقفة مؤقتًا إلى أن توافق على التغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Werkzeuge haben sich seit der Installation geändert. Sie sind angehalten, bis du der Änderung zustimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas herramientas han cambiado desde que la instalaste; quedan en espera hasta que apruebes el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains outils ont changé depuis son installation ; ils sont en attente jusqu’à ce que vous approuviez la modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni strumenti sono cambiati da quando l'hai installata; restano sospesi finché non approvi la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール後に一部のツールが変更されました。変更を承認するまで保留にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치한 후 일부 도구가 변경되었어요. 변경 사항을 승인할 때까지 보류돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas ferramentas mudaram desde a instalação; estão em espera até você aprovar a mudança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自你安装以来，部分工具已更改；在你批准这项更改前，它们会被暂停。"
          }
        }
      }
    },
    "Someone to keep you company. They can't touch anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رفيق يؤنسك. لا يمكنه الوصول إلى أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jemand, der dir Gesellschaft leistet. Sie können auf nichts zugreifen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguien que te haga compañía. No pueden tocar nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quelqu’un pour vous tenir compagnie. Ils ne peuvent toucher à rien."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualcuno che ti faccia compagnia. Non possono toccare nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一緒にいてくれる相棒。何にも触れられません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "곁에 있어 줄 친구. 아무것에도 접근할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguém para fazer companhia. Eles não podem acessar nada."
