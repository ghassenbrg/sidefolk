        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "言われるまで静かにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말씀하실 때까지 조용히 있을게요."
          }
