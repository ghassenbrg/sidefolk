      }
    },
    "I won't rename something into a “.%@” item, because those can run programs." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No renombraré nada para convertirlo en un elemento “.%@”, porque esos elementos pueden ejecutar programas."
