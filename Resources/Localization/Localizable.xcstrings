    "Sends one tiny request to the model." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرسل طلبًا صغيرًا واحدًا إلى النموذج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sendet eine winzige Anfrage an das Modell."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envía una petición muy pequeña al modelo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Envoie une toute petite requête au modèle."
          }
        },
        "it" : {
