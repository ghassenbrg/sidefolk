    "A small peek at the edge of the screen until something needs you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إطلالة صغيرة من حافة الشاشة إلى أن يحتاج إليك شيء ما."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lugt nur ein wenig am Bildschirmrand hervor, bis dich etwas braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asoma un poco por el borde de la pantalla hasta que algo te necesite."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un petit coup d’œil depuis le bord de l’écran, jusqu’à ce que quelque chose ait besoin de vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spunta appena dal bordo dello schermo finché qualcosa non ha bisogno di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用事があるまで、画面の端からちょっとだけのぞいています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
