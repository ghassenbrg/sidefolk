    "The copy Sidefolk made of %@ is removed. The folder you added it from isn't touched: add it again from there at any time." : {
      "comment" : "Removing a 3D companion added from a folder",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُزال النسخة التي صنعها Sidefolk من %@. لا يُمس المجلد الذي أضفته منه: أضفه مرة أخرى من هناك في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Kopie von %@, die Sidefolk angelegt hat, wird entfernt. Der Ordner, aus dem du ihn hinzugefügt hast, bleibt unberührt: Füge ihn jederzeit erneut von dort hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se quita la copia de %@ que hizo Sidefolk. La carpeta desde la que lo añadiste no se toca: vuelve a añadirlo desde ahí cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copie de %@ faite par Sidefolk est retirée. Le dossier d'où vous l'avez ajouté n'est pas touché : ajoutez-le à nouveau depuis celui-ci à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La copia di %@ fatta da Sidefolk viene rimossa. La cartella da cui l'hai aggiunto non viene toccata: aggiungilo di nuovo da lì quando vuoi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが作った%@のコピーを削除します。追加元のフォルダはそのままです。いつでもそこから再追加できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 만든 %@의 복사본이 제거돼요. 추가할 때 쓴 폴더는 그대로예요. 언제든 거기서 다시 추가할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A cópia de %@ feita pelo Sidefolk é removida. A pasta de onde você o adicionou não é tocada: adicione-o de novo a partir dela quando quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 为 %@ 制作的副本将被移除。你添加它时所用的文件夹不受影响：随时可以从那里再次添加。"
          }
        }
      }
    },
