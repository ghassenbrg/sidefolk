        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuto dopo l'avvio di Sidefolk e poi una volta al giorno. Chiede sempre prima di installare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
