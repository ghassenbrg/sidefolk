            "value" : "Sidefolk konnte die neue Version nicht einspielen, deshalb hat sich nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no pudo poner la nueva versión en su sitio, así que no cambió nada."
