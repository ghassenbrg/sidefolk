        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림 기능이 실행되고 있지 않아서 설정할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
