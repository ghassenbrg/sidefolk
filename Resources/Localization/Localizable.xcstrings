    },
    "%@ was updated with Sidefolk and can now do more (%@). I turned it off until you switch it on in Settings › Extensions." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "جرى تحديث %1$@ مع Sidefolk وأصبح بإمكانه فعل المزيد (%2$@). أوقفته إلى أن تشغّله من الإعدادات › الملحقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ wurde mit Sidefolk aktualisiert und kann jetzt mehr (%2$@). Ich habe die Erweiterung ausgeschaltet, bis du sie in Einstellungen › Erweiterungen einschaltest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ was updated with Sidefolk and can now do more (%2$@). I turned it off until you switch it on in Settings › Extensions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ se actualizó con Sidefolk y ahora puede hacer más (%2$@). La desactivé hasta que la actives en Ajustes › Extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’extension %1$@ a été mise à jour avec Sidefolk et peut désormais faire plus (%2$@). Je l’ai désactivée jusqu’à ce que vous l’activiez dans Réglages › Extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ è stata aggiornata con Sidefolk e ora può fare di più (%2$@). L'ho disattivata finché non la attivi in Impostazioni › Estensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はSidefolkと一緒に更新され、できることが増えました（%2$@）。設定 › 拡張機能でオンにするまで、オフにしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 확장 프로그램이 Sidefolk와 함께 업데이트되어 할 수 있는 일이 늘었어요(%2$@). 설정 › 확장 프로그램에서 켤 때까지 꺼 두었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A extensão %1$@ foi atualizada com o Sidefolk e agora pode fazer mais (%2$@). Eu a desativei até você ativá-la em Ajustes › Extensões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已随 Sidefolk 更新，现在可以做更多事情（%2$@）。我已把它关闭，等你在设置 › 扩展中重新打开。"
          }
        }
      }
    },
