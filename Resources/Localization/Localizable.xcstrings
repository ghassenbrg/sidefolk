    "Use something like “tomorrow 9am”, “in 20 minutes”, “friday at 3pm”, “every weekday at 9” or an ISO date such as 2025-11-12T09:00:00." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم صيغة مثل «tomorrow 9am» أو «in 20 minutes» أو «friday at 3pm» أو «every weekday at 9» أو تاريخًا بصيغة ISO مثل 2025-11-12T09:00:00."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwende etwas wie „tomorrow 9am“, „in 20 minutes“, „friday at 3pm“, „every weekday at 9“ oder ein ISO-Datum wie 2025-11-12T09:00:00."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa algo como “tomorrow 9am”, “in 20 minutes”, “friday at 3pm”, “every weekday at 9” o una fecha ISO como 2025-11-12T09:00:00."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez par exemple « tomorrow 9am », « in 20 minutes », « friday at 3pm », « every weekday at 9 » ou une date ISO comme 2025-11-12T09:00:00."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa qualcosa come “tomorrow 9am”, “in 20 minutes”, “friday at 3pm”, “every weekday at 9” o una data ISO come 2025-11-12T09:00:00."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「tomorrow 9am」「in 20 minutes」「friday at 3pm」「every weekday at 9」のような表現か、2025-11-12T09:00:00のようなISO形式の日付を使ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“tomorrow 9am”, “in 20 minutes”, “friday at 3pm”, “every weekday at 9” 같은 표현이나 2025-11-12T09:00:00 같은 ISO 날짜를 사용하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
