    "Something went wrong while I was thinking. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدث خطأ أثناء تفكيري. لم يتغيّر شيء."
          }
