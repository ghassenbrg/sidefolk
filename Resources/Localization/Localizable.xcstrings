        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "세계 어디의 시각이든 알려 주고, 지역 간 시각도 변환해 줘요. 서머타임도 정확하게 계산해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
