          }
        }
      }
    },
    "I only see a few words on this page. If the rest needs a browser or a sign-in, I won't see it change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أرى سوى كلمات قليلة في هذه الصفحة. إن كان الباقي يحتاج إلى متصفح أو تسجيل دخول، فلن أرى تغيّره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sehe auf dieser Seite nur wenige Wörter. Wenn der Rest einen Browser oder eine Anmeldung braucht, sehe ich nicht, wenn er sich ändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
