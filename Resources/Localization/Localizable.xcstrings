    "Scout keeps what it read. The next change shows here, line by line." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ Scout بما قرأه. سيظهر التغيير التالي هنا، سطرًا سطرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout behält, was es gelesen hat. Die nächste Änderung erscheint hier, Zeile für Zeile."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout guarda lo que leyó. El próximo cambio aparecerá aquí, línea por línea."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout garde ce qu’il a lu. Le prochain changement s’affichera ici, ligne par ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout conserva ciò che ha letto. La prossima modifica appare qui, riga per riga."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scoutは読んだ内容を保存しています。次の変更はここに1行ずつ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout가 읽은 내용을 보관합니다. 다음 변경 사항이 여기에 한 줄씩 표시됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout guarda o que leu. A próxima mudança aparece aqui, linha por linha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scout 保存了读到的内容。下次变化会在这里逐行显示。"
          }
        }
      }
    },
    "Scout keeps what it reads from now on. The next change shows here, line by line." : {
      "localizations" : {
