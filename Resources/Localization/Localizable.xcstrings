          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我只能使用简单的选择器，例如 span.price、#total 或 td。"
          }
        }
      }
    },
    "I can show the temperature, feels like, humidity, wind, rain or conditions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنني عرض درجة الحرارة أو الإحساس بالحرارة أو الرطوبة أو الرياح أو المطر أو حالة الطقس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann die Temperatur, die gefühlte Temperatur, die Luftfeuchtigkeit, den Wind, den Regen oder die Wetterlage zeigen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedo mostrar la temperatura, la sensación térmica, la humedad, el viento, la lluvia o las condiciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je peux afficher la température, le ressenti, l’humidité, le vent, la pluie ou le temps."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso mostrare la temperatura, la temperatura percepita, l'umidità, il vento, la pioggia o le condizioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "表示できるのは、気温、体感温度、湿度、風、雨量、天気です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기온, 체감 온도, 습도, 바람, 강수량, 날씨 상태를 보여 드릴 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
