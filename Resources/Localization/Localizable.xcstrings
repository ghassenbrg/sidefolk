    "Adds a [mcp_servers.sidefolk] entry to ~/.codex/config.toml, so Codex can use Sidefolk's tools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف الإدخال [mcp_servers.sidefolk] إلى ~/.codex/config.toml حتى يتمكن Codex من استخدام أدوات Sidefolk."
          }
        },
