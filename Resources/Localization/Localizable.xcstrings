    "Drag from corner to corner, click a plot to clear it" : {
      "comment" : "Keys in the Play panel: Garden Plots, drawing rectangles",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب من زاوية إلى أخرى، وانقر قطعة لإزالتها"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Von Ecke zu Ecke ziehen, eine Parzelle anklicken zum Entfernen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra de esquina a esquina, haz clic en una parcela para quitarla"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez d'un coin à l'autre, cliquez sur une parcelle pour l'effacer"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina da angolo ad angolo, fai clic su un lotto per toglierlo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "角から角へドラッグ、区画をクリックで消す"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모서리에서 모서리로 드래그, 구획을 클릭하면 지우기"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste de canto a canto, clique num lote para tirá-lo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从一角拖到对角，点一块地来去掉"
          }
        }
      }
    },
    "Drag to arrange. The first live values set to show stand beside %@; %lld fit there, and the rest run on." : {
      "comment" : "The page listing every watcher",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب للترتيب. أول القيم المباشرة المضبوطة على الإظهار تقف بجانب %1$@؛ يتسع المكان لـ %2$lld منها، وتستمر البقية في العمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zum Anordnen ziehen. Die ersten Live-Werte, die angezeigt werden sollen, stehen neben %1$@; %2$lld passen dorthin, der Rest läuft weiter."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drag to arrange. The first live values set to show stand beside %1$@; %2$lld fit there, and the rest run on."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrastra para ordenar. Los primeros valores en vivo con ajuste de mostrar quedan junto a %1$@; caben %2$lld, y el resto sigue funcionando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Glissez pour organiser. Les premières valeurs en direct réglées sur l’affichage se placent à côté de %1$@ ; %2$lld y tiennent, les autres tournent sans s’afficher."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trascina per ordinare. I primi valori dal vivo impostati su mostra stanno accanto a %1$@; ne entrano %2$lld, gli altri continuano a funzionare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ドラッグして並べ替えます。表示に設定したライブ値は先頭から%1$@のそばに並び、%2$lld件まで入ります。残りは表示せずに動き続けます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "끌어서 정렬하세요. 보이도록 설정한 실시간 값은 앞에서부터 %1$@ 옆에 놓이고, %2$lld개까지 들어가요. 나머지는 보이지 않게 계속 실행돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arraste para organizar. Os primeiros valores ao vivo definidos para aparecer ficam ao lado de %1$@; cabem %2$lld, e o resto continua rodando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拖动来整理。设为显示的前几个实时数值会排在 %1$@ 旁边，那里放得下 %2$lld 个，其余的继续运行。"
          }
        }
      }
    },
    "Drag to move it, or use ← and → a quarter hour at a time" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحبه لنقله، أو استخدم ← و→ ربع ساعة في كل مرة"
          }
