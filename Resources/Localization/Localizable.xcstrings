    "What should I do with %@? Type it below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا أفعل بـ %@؟ اكتب ذلك أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was soll ich mit %@ machen? Gib es unten ein."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué hago con %@? Escríbelo abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Que dois-je faire de %@ ? Tapez-le ci-dessous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa devo fare con %@? Scrivilo qui sotto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@をどうしますか？下に入力してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목으로 무엇을 할까요? 아래에 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que devo fazer com %@? Digite abaixo."
