    },
    "Tempo, Scout and Byte sit beside the companion while a reminder, watch or agent is live." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مكان Tempo وScout وByte بجانب الرفيق ما دام هناك تذكير أو مراقبة أو وكيل نشط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo, Scout und Byte sitzen neben dem Begleiter, solange eine Erinnerung, eine Beobachtung oder ein Agent aktiv ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo, Scout y Byte se sientan junto al acompañante mientras hay un recordatorio, una vigilancia o un agente activo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo, Scout et Byte s’installent à côté du compagnon tant qu’un rappel, une surveillance ou un agent est actif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo, Scout e Byte si siedono accanto al compagno mentre un promemoria, una sentinella o un agente è attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダー、監視、エージェントが動いている間、Tempo、Scout、Byteが相棒のそばにいます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림, 지켜보기, 에이전트가 작동하는 동안 Tempo, Scout, Byte가 컴패니언 곁에 앉아 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
