    "Typed requests are understood in English without AI; with AI, in any language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفهم الطلبات المكتوبة بالإنجليزية دون ذكاء اصطناعي؛ ومع الذكاء الاصطناعي، بأي لغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne KI verstehe ich getippte Anfragen nur auf Englisch, mit KI in jeder Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin IA, las peticiones escritas se entienden en inglés; con IA, en cualquier idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans IA, les demandes tapées sont comprises en anglais ; avec une IA, dans toutes les langues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Senza IA, le richieste scritte vengono capite in inglese; con l'IA, in qualsiasi lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "入力したリクエストは、AIなしでは英語のみ、AIありではどの言語でも理解できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 요청은 AI 없이는 영어로만 이해하고, AI가 있으면 모든 언어로 이해해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
