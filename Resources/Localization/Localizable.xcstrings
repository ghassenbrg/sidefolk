    "Made on this Mac. Nothing is sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُنتَج على هذا الـ Mac. لا يُرسل شيء إلى أي مكان."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird auf diesem Mac erzeugt. Es wird nichts verschickt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se generan en este Mac. No se envía nada a ningún sitio."
          }
        },
        "fr" : {
