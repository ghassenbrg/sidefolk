    "The next one would be %@; ask the user whether that works, or pick another time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيكون الموعد التالي %@؛ اسأل المستخدم إن كان ذلك مناسبًا، أو اختر وقتًا آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die nächste wäre %@. Frag die Person, ob das passt, oder wähle eine andere Zeit."
