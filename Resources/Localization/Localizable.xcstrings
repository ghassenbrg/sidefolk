    "Runs with your full permissions" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل بكامل أذوناتك"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft mit all deinen Rechten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta con todos tus permisos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute avec toutes vos autorisations"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguito con tutti i tuoi permessi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーと同じすべての権限で動作"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 모든 권한으로 실행"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda com todas as suas permissões"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你的全部权限运行"
          }
        }
      }
    },
    "Runs with your full permissions: it can read and change your files, use the internet and run programs" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل بكامل أذوناتك: يمكنه قراءة ملفاتك وتغييرها واستخدام الإنترنت وتشغيل البرامج"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Läuft mit all deinen Rechten: kann deine Dateien lesen und ändern, das Internet nutzen und Programme ausführen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta con todos tus permisos: puede leer y cambiar tus archivos, usar internet y ejecutar programas"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "S’exécute avec toutes vos autorisations : peut lire et modifier vos fichiers, utiliser Internet et lancer des programmes"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Viene eseguito con tutti i tuoi permessi: può leggere e modificare i tuoi file, usare internet ed eseguire programmi"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ユーザーと同じすべての権限で動作：ファイルの読み込みと変更、インターネットの使用、プログラムの実行が可能"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용자의 모든 권한으로 실행: 파일을 읽고 변경하고, 인터넷을 사용하고, 프로그램을 실행할 수 있음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Roda com todas as suas permissões: pode ler e alterar seus arquivos, usar a internet e executar programas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "以你的全部权限运行：它可以读取和更改你的文件、访问互联网以及运行程序"
          }
        }
      }
    },
