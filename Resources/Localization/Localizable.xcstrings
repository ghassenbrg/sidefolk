          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 会创建一个文件夹，内含 Harbor 的副本和一份简短指南，然后跟随它。"
          }
        }
      }
    },
    "Sidefolk needs your OK to use %@" : {
