    "A due date can't repeat. For something that comes back, set a repeating reminder instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن تكرار تاريخ الاستحقاق. لما يعود مرة بعد مرة، اضبط تذكيرًا متكررًا بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Fälligkeitsdatum kann sich nicht wiederholen. Für etwas, das wiederkehrt, lege stattdessen eine wiederkehrende Erinnerung an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una fecha de vencimiento no puede repetirse. Para algo que vuelve, crea mejor un recordatorio que se repita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une échéance ne peut pas se répéter. Pour ce qui revient, créez plutôt un rappel répétitif."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una scadenza non può ripetersi. Per qualcosa che ritorna, crea invece un promemoria ripetuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "期限は繰り返せません。繰り返したいことには、繰り返しのリマインダーを設定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기한은 반복할 수 없어요. 다시 돌아오는 일이라면 반복 미리 알림을 설정해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma data de vencimento não pode se repetir. Para algo que volta, crie um lembrete repetido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "截止日期不能重复。对于会反复出现的事,请改为设置重复提醒。"
          }
        }
      }
    },
