          }
        }
      }
    },
    "I'll keep this value beside me, up to date." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأبقي هذه القيمة بجانبي، محدّثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
