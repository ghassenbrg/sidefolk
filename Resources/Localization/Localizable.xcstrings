    "Can ask for your place. It says it uses it %@." : {
      "comment" : "Install sheet: permissions.place; the author's purpose, “to show the weather where you are”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنه طلب موقعك. ويقول إنه يستخدمه %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann nach deinem Standort fragen. Laut eigener Angabe nutzt sie ihn, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede pedir tu ubicación. Dice que la usa %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut demander votre position. Elle dit l’utiliser %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può chiedere la tua posizione. Dice di usarla %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "位置情報を求めることがあります。用途の説明：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위치를 요청할 수 있어요. 용도 설명: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode pedir sua localização. Diz que a usa %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以请求获取你的位置。它说明用途为：%@。"
          }
        }
      }
    },
    "Can ask to send you reminders at moments it plans. It says it uses them %@." : {
      "comment" : "Install sheet: permissions.schedule; the author's purpose, “to remind you of the moments you choose”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنه طلب إرسال تذكيرات إليك في أوقات يخطط لها. ويقول إنه يستخدمها %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann anfragen, dir Erinnerungen zu Zeitpunkten zu senden, die sie selbst plant. Laut eigener Angabe nutzt sie diese, %@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede pedir enviarte recordatorios en los momentos que planifica. Dice que los usa %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut demander à vous envoyer des rappels aux moments qu’elle planifie. Elle dit les utiliser %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può chiedere di inviarti promemoria nei momenti che pianifica. Dice di usarli %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張機能が計画したタイミングでリマインダーを送る許可を求めることがあります。用途の説明：%@。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램이 계획한 시점에 미리 알림을 보내도록 요청할 수 있어요. 용도 설명: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode pedir para enviar lembretes nos momentos que planeja. Diz que os usa %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "可以请求在它计划的时间点向你发送提醒。它说明用途为：%@。"
          }
        }
      }
    },
    "Can ask your AI to write something, up to %lld times a day. It says it uses it %@." : {
      "comment" : "Install sheet: permissions.ai; the daily limit, then the author's purpose, “to write quiz questions”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنها أن تطلب من الذكاء الاصطناعي لديك كتابة شيء، حتى %1$lld مرة في اليوم. تقول إنها تستخدمه %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kann deine KI etwas schreiben lassen, bis zu %1$lld-mal am Tag. Sie sagt, sie nutzt das %2$@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can ask your AI to write something, up to %1$lld times a day. It says it uses it %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede pedirle a tu IA que escriba algo, hasta %1$lld veces al día. Dice que lo usa %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peut demander à votre IA d’écrire quelque chose, jusqu’à %1$lld fois par jour. Elle dit s’en servir %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
