    "Your calendar can be here too, beside your reminders, in its own colours." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن يكون تقويمك هنا أيضًا، بجانب تذكيراتك، بألوانه الخاصة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Kalender kann auch hier sein, neben deinen Erinnerungen, in seinen eigenen Farben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu calendario también puede estar aquí, junto a tus recordatorios, con sus propios colores."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre calendrier peut être ici aussi, à côté de vos rappels, dans ses propres couleurs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anche il tuo calendario può stare qui, accanto ai tuoi promemoria, con i suoi colori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのカレンダーも、リマインダーと並んで、それぞれの色でここに表示できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 캘린더도 미리 알림 옆에 고유한 색으로 여기 표시할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seu calendário também pode ficar aqui, ao lado dos seus lembretes, com as cores dele."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的日历也可以显示在这里,与提醒并列,保留各自的颜色。"
          }
        }
      }
    },
