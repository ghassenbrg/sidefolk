          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 Harbor 사본과 짧은 안내가 담긴 폴더를 만들고 따라갑니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
