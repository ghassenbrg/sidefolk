    "When %@ watches a page, repeats a reminder or follows an agent, it shows here with a way to pause or stop it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عندما يراقب %@ صفحة أو يكرر تذكيرًا أو يتابع وكيلًا، يظهر ذلك هنا مع طريقة لإيقافه مؤقتًا أو نهائيًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn %@ eine Seite beobachtet, eine Erinnerung wiederholt oder einem Agenten folgt, erscheint es hier, mit einer Möglichkeit zum Pausieren oder Beenden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando %@ vigila una página, repite un recordatorio o sigue a un agente, aparece aquí con una forma de pausarlo o detenerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand %@ surveille une page, répète un rappel ou suit un agent, cela s’affiche ici avec un moyen de le mettre en pause ou de l’arrêter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ tiene d’occhio una pagina, ripete un promemoria o segue un agente, appare qui con un modo per metterlo in pausa o fermarlo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@がページを監視したり、リマインダーを繰り返したり、エージェントを見守ったりすると、一時停止や停止の方法と一緒にここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 페이지를 지켜보거나 미리 알림을 반복하거나 에이전트를 따라가면, 일시 정지나 중지 방법과 함께 여기에 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando %@ monitora uma página, repete um lembrete ou acompanha um agente, isso aparece aqui com um jeito de pausar ou parar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 %@ 监视网页、重复提醒或跟进智能体时，会显示在这里，并可暂停或停止。"
          }
        }
      }
    },
