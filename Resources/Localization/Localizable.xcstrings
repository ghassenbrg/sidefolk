    "Revoke any of these and Sidefolk asks again next time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسحب أيًا منها وسيسأل Sidefolk مجددًا في المرة القادمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entziehst du eine davon, fragt Sidefolk beim nächsten Mal wieder."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revoca cualquiera de estos y Sidefolk volverá a preguntar la próxima vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Révoquez l’une d’elles et Sidefolk redemandera la prochaine fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ne revochi uno, Sidefolk chiederà di nuovo la prossima volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "解除すると、次回Sidefolkが再び確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "해제하면 다음번에 Sidefolk가 다시 물어봐요."
