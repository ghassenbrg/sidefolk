    "Okay, no reminder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسنًا، دون تذكير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okay, keine Erinnerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De acuerdo, sin recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’accord, pas de rappel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va bene, nessun promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "了解です。リマインダーは設定しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알겠어요, 미리 알림은 설정하지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certo, sem lembrete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好的，不设提醒。"
          }
        }
      }
    },
