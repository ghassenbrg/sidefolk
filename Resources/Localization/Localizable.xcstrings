        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld estensioni, %2$lld server di strumenti e %3$lld competenze. Ognuno funziona solo con ciò che dice il suo passaporto."
          }
        },
        "ja" : {
