            "value" : "Codex 中的 Sidefolk 技能"
          }
        }
      }
    },
    "Sidefolk starts quietly when you log in." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدأ Sidefolk بهدوء عند تسجيل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk startet unauffällig, wenn du dich anmeldest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk se abre discretamente al iniciar sesión."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk démarre discrètement quand vous ouvrez votre session."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk si avvia in silenzio quando accedi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
