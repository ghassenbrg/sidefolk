    "Adds hooks to ~/.claude/settings.json, so I notice when a session needs you or finishes." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف خطافات (hooks) إلى ~/.claude/settings.json حتى أنتبه عندما تحتاج إليك جلسة أو تنتهي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt ~/.claude/settings.json Hooks hinzu, damit ich merke, wenn eine Sitzung dich braucht oder fertig ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade hooks a ~/.claude/settings.json para que me entere de cuándo una sesión te necesita o termina."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute des hooks à ~/.claude/settings.json, pour que je remarque quand une session a besoin de vous ou se termine."
          }
