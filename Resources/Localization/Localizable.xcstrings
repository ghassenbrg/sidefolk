    "Check that Sidefolk has access to that folder in System Settings › Privacy & Security › Files and Folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من أن Sidefolk لديه حق الوصول إلى هذا المجلد في إعدادات النظام › الخصوصية والأمن › الملفات والمجلدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe in Systemeinstellungen › Datenschutz & Sicherheit › Dateien und Ordner, ob Sidefolk Zugriff auf diesen Ordner hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que Sidefolk tenga acceso a esa carpeta en Ajustes del Sistema › Privacidad y seguridad › Archivos y carpetas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que Sidefolk a accès à ce dossier dans Réglages Système › Confidentialité et sécurité › Fichiers et dossiers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla che Sidefolk abbia accesso a quella cartella in Impostazioni di Sistema › Privacy e sicurezza › File e cartelle."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システム設定 › プライバシーとセキュリティ › ファイルとフォルダで、Sidefolkがそのフォルダにアクセスできるか確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시스템 설정 › 개인정보 보호 및 보안 › 파일 및 폴더에서 Sidefolk가 그 폴더에 접근할 수 있는지 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se o Sidefolk tem acesso a essa pasta em Ajustes do Sistema › Privacidade e Segurança › Arquivos e Pastas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
