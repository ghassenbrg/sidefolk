    "Replaces your data with a backup's. What's here now is kept aside for 7 days, so you can undo." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستبدل بياناتك ببيانات نسخة احتياطية. ما هو موجود الآن يُحفظ جانبًا 7 أيام لتتمكن من التراجع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ersetzt deine Daten durch die eines Backups. Was jetzt hier ist, wird 7 Tage beiseitegelegt, damit du es widerrufen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reemplaza tus datos por los de una copia. Lo que hay ahora se guarda aparte 7 días, para poder deshacerlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplace vos données par celles d’une sauvegarde. Ce qui est ici maintenant est mis de côté 7 jours, pour pouvoir annuler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sostituisce i tuoi dati con quelli di un backup. Ciò che c’è ora viene messo da parte per 7 giorni, così puoi annullare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "データをバックアップのもので置き換えます。今あるものは7日間取っておかれ、取り消せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데이터를 백업의 것으로 바꿔요. 지금 있는 것은 7일 동안 따로 보관되어 되돌릴 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Substitui seus dados pelos de um backup. O que está aqui agora fica guardado por 7 dias, para você poder desfazer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用备份中的数据替换你的数据。现在的数据会保留 7 天，方便你撤销。"
          }
        }
      }
    },
