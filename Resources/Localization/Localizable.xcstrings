    "%@ changed %@. I put it on hold until you review the change in Settings › Extensions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غيّر %1$@ الأداة %2$@. أوقفتها مؤقتًا إلى أن تراجع التغيير في الإعدادات › الملحقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hat %2$@ geändert. Ich habe es angehalten, bis du die Änderung in Einstellungen › Erweiterungen prüfst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ changed %2$@. I put it on hold until you review the change in Settings › Extensions."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha cambiado %2$@. Queda en espera hasta que revises el cambio en Ajustes › Extensiones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a modifié %2$@, qui reste en attente jusqu’à ce que vous vérifiiez la modification dans Réglages › Extensions."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha modificato %2$@. L'ho sospeso finché non controlli la modifica in Impostazioni › Estensioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@が%2$@を変更しました。設定 › 拡張機能で変更を確認するまで保留にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 %2$@ 도구가 바뀌었어요. 설정 › 확장 프로그램에서 변경 사항을 검토할 때까지 보류해 두었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ alterou %2$@. Deixei a extensão em espera até você revisar a mudança em Ajustes › Extensões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
