    "Rock beats scissors: I win!" : {
      "comment" : "The companion speaks",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الحجرة تغلب المقص: الفوز لي!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stein schlägt Schere: Ich gewinne!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La piedra gana a la tijera: ¡gano yo!"
          }
        },
