        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有你或 Sidefolk 本身可以创建技能。"
          }
        }
      }
    },
    "Only you or Sidefolk itself can delete skills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حذف المهارات مقصور عليك وعلى Sidefolk نفسه."
          }
