          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann nur Weblinks (http oder https) an eine Notiz anhängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo puedo adjuntar enlaces web (http o https) a una nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
