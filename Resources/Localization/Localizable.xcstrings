    "The companion and its small notices stay on your ordinary desktops, and Ask still opens wherever you are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى الرفيق وإشعاراته الصغيرة على أسطح المكتب العادية، ويُفتح Ask أينما كنت."
          }
        },
        "de" : {
          "stringUnit" : {
