    "Your events on Today and in the morning brief. macOS asks you once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحداثك في «اليوم» وفي «موجز الصباح». يسألك macOS مرة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Termine unter Heute und im Morgenüberblick. macOS fragt dich einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus eventos en Hoy y en el Resumen matinal. macOS te lo pregunta una vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos événements dans Aujourd’hui et dans le Résumé du matin. macOS vous le demande une fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I tuoi eventi in Oggi e nel Riepilogo del mattino. macOS te lo chiede una volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「今日」と朝のまとめに予定を表示します。macOSが一度だけ確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘과 아침 브리핑에 일정이 보여요. macOS가 한 번 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus eventos em Hoje e no Resumo da manhã. O macOS pergunta uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的日程会显示在“今天”和晨间简报中。macOS 会询问你一次。"
          }
        }
      }
    },
    "Your key is in the Keychain and is only sent to %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاحك في سلسلة المفاتيح ولا يُرسل إلا إلى %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Schlüssel liegt im Schlüsselbund und wird nur an %@ gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave está en el llavero y solo se envía a %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé est dans le trousseau et n’est envoyée qu’à %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave è nel Portachiavi e viene inviata solo a %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはキーチェーンに保管され、%@にのみ送信されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 키체인에 있고 %@에만 전송돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave fica nas Chaves e só é enviada para %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的密钥保存在钥匙串中，只会发送给 %@。"
          }
        }
      }
    },
    "Your key was saved for %@. Sidefolk only sends a key to the server it was saved for." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ مفتاحك لـ %@. لا يرسل Sidefolk المفتاح إلا إلى الخادم الذي حُفظ له."
          }
        },
        "de" : {
          "stringUnit" : {
