    "Tap %@ to open the Ask panel, hold it to talk. You can also press and hold %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على %1$@ لفتح لوحة «اسأل»، أو اضغط مطوّلًا عليه للتحدث. يمكنك أيضًا الضغط مطوّلًا على %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücke %1$@ kurz, um das Fragefenster zu öffnen, oder halte es zum Sprechen gedrückt. Du kannst auch auf %2$@ klicken und halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Tap %1$@ to open the Ask panel, hold it to talk. You can also press and hold %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pulsa %1$@ para abrir el panel Preguntar; mantenlo pulsado para hablar. También puedes mantener pulsado a %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur %1$@ pour ouvrir le panneau Demander, maintenez-le enfoncé pour parler. Vous pouvez aussi appuyer longuement sur %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Premi %1$@ per aprire il pannello Chiedi; tieni premuto per parlare. Puoi anche tenere premuto %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@を押すと入力パネルが開き、押し続けると話せます。%2$@を長押ししても話せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 단축키를 누르면 요청 패널이 열리고, 길게 누르면 말할 수 있어요. 컴패니언(%2$@)을 길게 눌러도 돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em %1$@ para abrir o painel Perguntar e segure para falar. Você também pode pressionar e segurar %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按一下 %1$@ 打开提问面板，按住则开始说话。你也可以按住 %2$@。"
          }
        }
      }
    },
