    },
    "Sidefolk couldn't open its data folder. Nothing was deleted or changed.\n\nTry restarting your Mac. If this keeps happening, export diagnostics from ~/Library/Logs/Sidefolk and check the data folder at %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no pudo abrir su carpeta de datos. No se ha eliminado ni cambiado nada.\n\nPrueba a reiniciar el Mac. Si sigue pasando, exporta el diagnóstico desde ~/Library/Logs/Sidefolk y revisa la carpeta de datos en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’a pas pu ouvrir son dossier de données. Rien n’a été supprimé ni modifié.\n\nEssayez de redémarrer votre Mac. Si le problème persiste, exportez les diagnostics depuis ~/Library/Logs/Sidefolk et vérifiez le dossier de données à l’emplacement %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non ha potuto aprire la sua cartella dei dati. Non è stato eliminato né modificato nulla.\n\nProva a riavviare il Mac. Se continua a succedere, esporta la diagnostica da ~/Library/Logs/Sidefolk e controlla la cartella dei dati in %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 데이터 폴더를 열지 못했어요. 아무것도 삭제하거나 변경하지 않았어요.\n\nMac을 재시동해 보세요. 이 문제가 계속되면 ~/Library/Logs/Sidefolk에서 진단 정보를 내보내고 %@의 데이터 폴더를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não conseguiu abrir a pasta de dados. Nada foi apagado nem alterado.\n\nTente reiniciar o Mac. Se isso continuar acontecendo, exporte o diagnóstico de ~/Library/Logs/Sidefolk e verifique a pasta de dados em %@."
          }
        }
      }
    },
    "Sidefolk couldn't settle the permissions for this action." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no pudo resolver los permisos de esta acción."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’a pas pu déterminer les autorisations pour cette action."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non ha potuto definire i permessi per questa azione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 이 동작의 권한을 확정하지 못했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não conseguiu definir as permissões para esta ação."
          }
        }
      }
    },
    "Sidefolk couldn't start" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no pudo iniciarse"
