    "Notes, reminders, watches, history, logs and saved keys. This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظات والتذكيرات والمراقبات وسجل الطلبات والسجلات والمفاتيح المحفوظة. لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen, Erinnerungen, Beobachtungen, Verlauf, Protokolle und gespeicherte Schlüssel. Das lässt sich nicht widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notas, recordatorios, vigilancias, historial, registros y claves guardadas. Esta acción no se puede deshacer."
          }
