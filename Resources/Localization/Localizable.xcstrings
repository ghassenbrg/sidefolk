          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一按下，麦克风就会打开。"
          }
        }
      }
    },
    "The microphone went away while you were talking. Nothing was sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الميكروفون أثناء حديثك. لم يُرسل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon ist ausgefallen, während du gesprochen hast. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono dejó de estar disponible mientras hablabas. No se ha enviado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le microphone s’est déconnecté pendant que vous parliez. Rien n’a été envoyé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono si è scollegato mentre parlavi. Non è stato inviato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "話している途中でマイクが使えなくなりました。何も送信されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "말하는 도중에 마이크 연결이 끊겼어요. 아무것도 보내지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone ficou indisponível enquanto você falava. Nada foi enviado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你说话时麦克风断开了。没有发送任何内容。"
          }
        }
      }
    },
    "The model “%@” can't use tools, so I can't act with it. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع النموذج «%@» استخدام الأدوات، لذا لا يمكنني العمل به. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Modell „%@“ kann keine Werkzeuge verwenden, daher kann ich damit nicht handeln. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El modelo “%@” no puede usar herramientas, así que no puedo actuar con él. No se ha cambiado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le modèle « %@ » ne peut pas utiliser d’outils, je ne peux donc pas agir avec lui. Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il modello “%@” non sa usare gli strumenti, quindi non posso usarlo per agire. Non è stato modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "モデル「%@」はツールを使えないため、このモデルでは操作できません。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 모델은 도구를 사용할 수 없어서 이 모델로는 작업할 수 없어요. 아무것도 변경되지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O modelo “%@” não sabe usar ferramentas, então não consigo agir com ele. Nada foi alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "模型“%@”无法使用工具，所以我无法用它执行操作。没有做任何更改。"
          }
        }
      }
    },
    "The new version carries no signature Sidefolk can read, so it wasn't installed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يحمل الإصدار الجديد توقيعًا يستطيع Sidefolk قراءته، لذا لم يُثبَّت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die neue Version trägt keine Signatur, die Sidefolk lesen kann, deshalb wurde sie nicht installiert."
          }
        },
        "es" : {
