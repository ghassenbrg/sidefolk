    "A break with your companion: a trivia quiz that keeps your score, and chance to pick a number or choose from a list." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استراحة مع رفيقك: مسابقة أسئلة تحفظ نقاطك، والصدفة تختار لك رقمًا أو عنصرًا من قائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Pause mit deinem Begleiter: ein Quiz, das deinen Punktestand behält, und der Zufall, der eine Zahl oder etwas aus einer Liste auswählt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un descanso con tu compañero: un trivial que guarda tu puntuación y el azar para elegir un número o algo de una lista."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pause avec votre compagnon : un quiz qui garde votre score, et le hasard pour tirer un nombre ou choisir dans une liste."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pausa con il tuo compagno: un quiz che tiene il punteggio e il caso che sceglie un numero o un elemento da una lista."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパニオンとひと休み：スコアを記録するクイズと、数字やリストの中から運で選ぶくじ引き。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언과 잠깐 쉬어 가요: 점수를 기억하는 퀴즈, 그리고 운에 맡겨 숫자나 목록에서 하나 고르기."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pausa com seu companheiro: um quiz que guarda sua pontuação e o acaso para escolher um número ou um item de uma lista."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和你的伙伴休息一下：玩一个记录分数的问答游戏，还可以让运气来挑一个数字，或从列表里选一项。"
          }
        }
      }
    },
    "A break with your companion: flip a coin, roll dice, let chance pick, play rock, paper, scissors, or a trivia quiz that keeps your score." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استراحة مع رفيقك: ارمِ عملة، أو ارمِ النرد، أو دع الصدفة تختار، أو العب حجرة ورقة مقص، أو مسابقة أسئلة تحفظ نقاطك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Pause mit deinem Begleiter: Münze werfen, würfeln, den Zufall wählen lassen, Schere, Stein, Papier spielen oder ein Quiz, das deinen Punktestand behält."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un descanso con tu compañero: lanza una moneda, tira dados, deja que el azar elija, juega a piedra, papel o tijera, o a un trivial que guarda tu puntuación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une pause avec votre compagnon : pile ou face, lancer de dés, tirage au sort, pierre-feuille-ciseaux, ou un quiz qui garde votre score."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una pausa con il tuo compagno: lancia una moneta, tira i dadi, lascia scegliere al caso, gioca a sasso, carta, forbici o a un quiz che tiene il punteggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパニオンとひと休み：コイン投げ、サイコロ、くじ引き、じゃんけん、スコアを記録するクイズ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언과 잠깐 쉬어 가요: 동전 던지기, 주사위 굴리기, 무작위로 고르기, 가위바위보, 점수를 기억하는 퀴즈."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma pausa com seu companheiro: jogue uma moeda, role dados, deixe o acaso escolher, jogue pedra, papel e tesoura ou um quiz que guarda sua pontuação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "和你的伙伴休息一下：抛硬币、掷骰子、随机挑选、玩石头剪刀布，或者玩一个记录分数的问答游戏。"
          }
        }
      }
    },
