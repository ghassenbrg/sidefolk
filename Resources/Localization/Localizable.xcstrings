          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il meteo di oggi e la settimana in arrivo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日の天気と1週間の予報"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 날씨와 한 주의 예보"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O clima de hoje e a semana que vem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日天气和未来一周的预报"
          }
        }
      }
    },
    "Today's weather and the week ahead for any place, and a heads-up before rain, from Open-Meteo. Only the place you ask about leaves your Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طقس اليوم والأسبوع القادم لأي مكان، وتنبيه قبل المطر، من Open-Meteo. لا يغادر الـ Mac الخاص بك سوى المكان الذي تسأل عنه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das heutige Wetter und die Vorschau auf die Woche für jeden Ort, dazu ein Hinweis vor Regen – von Open-Meteo. Nur der Ort, nach dem du fragst, verlässt deinen Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El clima de hoy y de la semana que viene en cualquier lugar, y un aviso antes de que llueva, con datos de Open-Meteo. Solo el lugar por el que preguntas sale de tu Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La météo du jour et de la semaine à venir pour n’importe quel lieu, avec une alerte avant la pluie, grâce à Open-Meteo. Seul le lieu que vous demandez quitte votre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il meteo di oggi e della settimana in arrivo per qualsiasi luogo, e un avviso prima della pioggia, da Open-Meteo. Solo il luogo che chiedi lascia il tuo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あらゆる場所の今日の天気と1週間の予報、雨の前のお知らせを、Open-Meteoから取得します。Macの外に出るのは、尋ねた場所だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "어느 곳이든 오늘의 날씨와 앞으로 한 주의 예보, 비 오기 전 알림을 Open-Meteo에서 가져와요. Mac 밖으로 나가는 건 물어본 장소뿐이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O clima de hoje e a semana que vem para qualquer lugar, e um aviso antes da chuva, via Open-Meteo. Só o lugar sobre o qual você pergunta sai do seu Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "任何地方的今日天气和未来一周的预报，以及下雨前的提前提醒，数据来自 Open-Meteo。只有你询问的地点会离开你的 Mac。"
          }
        }
      }
    },
