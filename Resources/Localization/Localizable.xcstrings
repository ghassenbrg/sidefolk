    "Battery, disk and memory at a glance, and a nudge when the battery or the disk runs low." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البطارية والقرص والذاكرة في لمحة، وتنبيه عندما تنخفض البطارية أو تقل مساحة القرص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batterie, Speicherplatz und Arbeitsspeicher auf einen Blick, dazu ein Hinweis, wenn die Batterie schwach oder der Speicherplatz knapp wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batería, disco y memoria de un vistazo, y un aviso cuando la batería está baja o queda poco espacio en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La batterie, le disque et la mémoire d’un coup d’œil, avec une alerte quand la batterie est faible ou que l’espace disque manque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Batteria, disco e memoria a colpo d'occhio, e un avviso quando la batteria è scarica o lo spazio su disco sta finendo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バッテリー、ディスク、メモリの状態をひと目で確認でき、バッテリーやディスクの残りが少なくなるとお知らせします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "배터리, 디스크, 메모리 상태를 한눈에 보여 주고, 배터리나 디스크가 부족해지면 알려 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bateria, disco e memória de relance, e um aviso quando a bateria ou o espaço em disco estiver acabando."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一眼查看电池、磁盘和内存的状态，电池电量或磁盘空间不足时会提醒你。"
          }
        }
