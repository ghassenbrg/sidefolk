    "This Mac can't listen in this language. Pick another one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede escuchar en este idioma. Elige otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut pas écouter dans cette langue. Choisissez-en une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non può ascoltare in questa lingua. Scegline un'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
