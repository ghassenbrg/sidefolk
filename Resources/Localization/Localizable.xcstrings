          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 做过的每件事、由谁发起，以及哪些获得了允许。"
          }
        }
      }
    },
    "Everything Sidefolk does, and who asked for it, shows up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
