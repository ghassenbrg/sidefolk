    "Sidefolk couldn't put the new version in place, so nothing changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Sidefolk وضع الإصدار الجديد في مكانه، لذا لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
