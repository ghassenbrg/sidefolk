        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "清单中描述了 %@，但程序没有提供这个名称的工具。"
          }
        }
      }
    },
    "The manifest describes %@, but the program doesn't offer tools by that name." : {
