    "I'm already watching %lld things that nobody asked for directly. Stop one before starting another." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أراقب بالفعل %lld من الأشياء التي لم يطلبها أحد مباشرةً. أوقف واحدًا قبل بدء آخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich beobachte schon %lld Dinge, um die niemand direkt gebeten hat. Beende eines, bevor du ein weiteres startest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya estoy vigilando %lld cosas que nadie pidió directamente. Detén una antes de iniciar otra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je surveille déjà %lld choses que personne n’a demandées directement. Arrêtes-en une avant d’en lancer une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sto già osservando %lld cose che nessuno ha chiesto direttamente. Fermane una prima di avviarne un’altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "直接頼まれていないものをすでに%lld件見守っています。別のものを始める前に、どれかを止めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "직접 요청받지 않은 항목을 이미 %lld개 지켜보고 있어요. 다른 항목을 시작하기 전에 하나를 중지해 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Já estou observando %lld coisas que ninguém pediu diretamente. Pare uma antes de iniciar outra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我已经在监视 %lld 项没有人直接要求的内容。开始新的之前，请先停止一项。"
          }
        }
      }
    },
