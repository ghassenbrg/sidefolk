    "Replays the first hello on your desktop. Nothing is reset." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد عرض التحية الأولى على سطح المكتب. لا يُعاد ضبط أي شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spielt die erste Begrüßung auf deinem Schreibtisch noch einmal ab. Nichts wird zurückgesetzt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Repite el primer saludo en tu escritorio. No se restablece nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rejoue le premier bonjour sur votre bureau. Rien n’est réinitialisé."
