    "Notes, reminders and watches still work. Questions need an AI." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملاحظات والتذكيرات والمراقبات تواصل العمل. الأسئلة تحتاج إلى ذكاء اصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen, Erinnerungen und Beobachtungen funktionieren weiter. Für Fragen braucht es eine KI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las notas, los recordatorios y las vigilancias siguen funcionando. Las preguntas necesitan una IA."
          }
        },
        "fr" : {
          "stringUnit" : {
