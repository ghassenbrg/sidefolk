    "Everything Sidefolk did, who asked, and what was allowed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما فعله Sidefolk، ومن طلبه، وما سُمح به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Sidefolk getan hat, wer es angefragt hat und was erlaubt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hizo Sidefolk, quién lo pidió y qué se permitió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que Sidefolk a fait, qui l’a demandé et ce qui a été autorisé."
