    "The program offers %@, which the manifest doesn't describe, so it runs as medium risk with default settings." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El programa ofrece %@, que el manifiesto no describe, así que se ejecuta con riesgo medio y los ajustes predeterminados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme propose %@, que le manifeste ne décrit pas : il s’exécute donc avec un risque moyen et les réglages par défaut."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il programma offre %@, che il manifest non descrive, quindi viene eseguito come rischio medio con le impostazioni predefinite."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "프로그램이 매니페스트에 설명되지 않은 %@ 도구를 제공해서, 기본 설정으로 중간 위험도로 실행돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O programa oferece %@, que o manifesto não descreve, então roda como risco médio com os ajustes padrão."
          }
        }
      }
    },
