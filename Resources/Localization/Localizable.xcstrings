          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’est arrêtée de façon inattendue %1$lld fois en %2$lld minutes, Sidefolk l’a donc désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è interrotta in modo imprevisto %1$lld volte in %2$lld minuti, quindi Sidefolk l'ha disattivata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld分間に%1$lld回、予期せず停止したため、Sidefolkがオフにしました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld분 동안 %1$lld번 예기치 않게 멈춰서 Sidefolk가 꺼 두었어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parou inesperadamente %1$lld vezes em %2$lld minutos, então o Sidefolk desativou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它在 %2$lld 分钟内意外停止了 %1$lld 次，所以 Sidefolk 把它关闭了。"
          }
        }
      }
    },
    "It stopped unexpectedly too often (%lld× in %lld min), so Sidefolk turned it off." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف بشكل غير متوقع مرات كثيرة جدًا (%1$lld× خلال %2$lld د)، لذا أوقفه Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie wurde zu oft unerwartet beendet (%1$lld× in %2$lld Min.), deshalb hat Sidefolk sie ausgeschaltet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
