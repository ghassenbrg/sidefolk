    "%@ downloads the newest %@ every time it starts. Pin a version, like %@@1.2.3." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّل %1$@ أحدث إصدار من %2$@ في كل مرة يبدأ فيها. حدّد إصدارًا ثابتًا، مثل %3$@@1.2.3."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ lädt bei jedem Start die neueste Version von %2$@. Lege eine Version fest, etwa %3$@@1.2.3."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ downloads the newest %2$@ every time it starts. Pin a version, like %3$@@1.2.3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ descarga la versión más reciente de %2$@ cada vez que se inicia. Fija una versión, como %3$@@1.2.3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ télécharge la dernière version de %2$@ à chaque démarrage. Fixez une version, par exemple %3$@@1.2.3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ scarica la versione più recente di %2$@ a ogni avvio. Fissa una versione, come %3$@@1.2.3."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@は起動するたびに最新の%2$@をダウンロードします。%3$@@1.2.3のようにバージョンを固定してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 명령은 시작할 때마다 %2$@ 최신 버전을 내려받아요. %3$@@1.2.3처럼 버전을 고정하세요."
          }
        },
        "pt-BR" : {
