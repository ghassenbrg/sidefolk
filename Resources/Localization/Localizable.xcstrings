    "Focus holds whispers until it ends; Quiet lets through only what can't wait." : {
      "comment" : "Settings › Attention",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التركيز يحتفظ بالهمسات حتى ينتهي؛ والهدوء لا يمرّر إلا ما لا يحتمل الانتظار."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fokus hält leise Hinweise bis zum Ende zurück; der Ruhemodus lässt nur durch, was nicht warten kann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Concentración guarda los susurros hasta el final; el Silencio solo deja pasar lo que no puede esperar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Concentration garde les murmures jusqu'à la fin ; Discret ne laisse passer que l'urgent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Concentrazione tiene i sussurri fino alla fine; il Silenzio lascia passare solo ciò che non può aspettare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "集中は終わるまでささやきを預かり、静かは待てないものだけを通します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "집중은 끝날 때까지 속삭임을 보관하고, 조용한 모드는 기다릴 수 없는 것만 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Foco segura os sussurros até o fim; o Silêncio só deixa passar o que não pode esperar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "专注会保留轻声提示直到结束；安静只放行不能等的事。"
          }
        }
      }
    },
