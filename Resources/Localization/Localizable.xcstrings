    "Small notices that need nothing wait until you leave the full-screen app, whichever you choose." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنتظر الإشعارات الصغيرة التي لا تطلب شيئًا حتى تغادر التطبيق بملء الشاشة، أيًّا كان اختيارك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kleine Hinweise, die nichts brauchen, warten, bis du die Vollbild-App verlässt, egal was du wählst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los avisos pequeños que no piden nada esperan a que salgas de la app a pantalla completa, elijas lo que elijas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les petites notifications sans action attendent que vous quittiez l’app en plein écran, quel que soit votre choix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I piccoli avvisi che non chiedono nulla aspettano che tu esca dall’app a schermo intero, qualunque sia la scelta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も求めない小さなお知らせは、どれを選んでもフルスクリーンのアプリを離れるまで待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 요구하지 않는 작은 알림은 무엇을 고르든 전체 화면 앱을 나갈 때까지 기다립니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pequenos avisos que não pedem nada esperam você sair do app em tela cheia, seja qual for a escolha."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需操作的小通知,无论你选哪项,都会等到你离开全屏应用。"
          }
        }
      }
    },
