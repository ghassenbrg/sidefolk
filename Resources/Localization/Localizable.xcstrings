    "Your API key was saved for a different address, so I didn't send it. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظ مفتاح API لعنوان مختلف، لذا لم أرسله. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein API-Schlüssel wurde für eine andere Adresse gespeichert, deshalb habe ich ihn nicht gesendet. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de API se guardó para otra dirección, así que no la envié. No se ha cambiado nada."
