        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.json에 훅을 추가해서 세션에서 확인이 필요하거나 세션이 끝나면 알아챌 수 있게 해요."
          }
        },
        "pt-BR" : {
