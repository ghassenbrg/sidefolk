        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk를 시작할 수 없음"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não conseguiu iniciar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 无法启动"
          }
        }
      }
    },
    "Sidefolk doesn't create hidden files or folders (names starting with a dot)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا ينشئ Sidefolk ملفات أو مجلدات مخفية (أسماء تبدأ بنقطة)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk erstellt keine versteckten Dateien oder Ordner (Namen, die mit einem Punkt beginnen)."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no crea archivos ni carpetas ocultos (nombres que empiezan por un punto)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne crée pas de fichiers ni de dossiers masqués (noms commençant par un point)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non crea file o cartelle nascosti (nomi che iniziano con un punto)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkは不可視のファイルやフォルダ（名前がドットで始まるもの）を作成しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 숨김 파일이나 폴더(이름이 마침표로 시작하는 것)를 만들지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não cria arquivos nem pastas ocultos (nomes que começam com ponto)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 不会创建隐藏的文件或文件夹（名称以点开头的）。"
          }
        }
      }
    },
    "Sidefolk doesn't offer a tool called %@ to other agents." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر Sidefolk أداة باسم %@ للوكلاء الآخرين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk bietet anderen Agenten kein Werkzeug namens %@ an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no ofrece a otros agentes ninguna herramienta llamada %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne propose pas d’outil nommé %@ aux autres agents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non offre agli altri agenti uno strumento chiamato %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkは%@というツールをほかのエージェントに提供していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 다른 에이전트에 %@ 도구를 제공하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não oferece uma ferramenta chamada %@ a outros agentes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 没有向其他智能体提供名为 %@ 的工具。"
          }
        }
      }
    },
    "Sidefolk doesn't touch %@ — it's protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يلمس Sidefolk %@ — فهو محمي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk rührt %@ nicht an – das ist geschützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no toca %@: está protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche pas à %@ — c’est protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non tocca %@: è protetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は保護されているため、Sidefolkは触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 %@ 항목을 건드리지 않아요. 보호된 항목이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não mexe em %@ — é um item protegido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 不会动 %@——它受到保护。"
          }
        }
      }
    },
    "Sidefolk doesn't touch hidden files or folders." : {
