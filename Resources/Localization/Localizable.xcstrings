    "Pauses every watch and live value; reminders, agents and extensions go on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يوقف كل مراقبة وقيمة مباشرة مؤقتًا؛ وتستمر التذكيرات والوكلاء والملحقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausiert jede Beobachtung und jeden Live-Wert; Erinnerungen, Agenten und Erweiterungen laufen weiter."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa cada vigilancia y valor en vivo; los recordatorios, agentes y extensiones siguen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Met en pause chaque surveillance et valeur en direct ; les rappels, agents et extensions continuent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa ogni osservazione e valore dal vivo; promemoria, agenti ed estensioni continuano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "すべての監視とライブ値を一時停止します。リマインダー、エージェント、拡張機能は続きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모든 지켜보기와 실시간 값을 일시 정지해요. 미리 알림, 에이전트, 확장 프로그램은 계속돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa todo monitoramento e valor ao vivo; lembretes, agentes e extensões continuam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "暂停所有监视和实时数值；提醒、智能体和扩展会继续。"
          }
        }
      }
    },
    "Pay as you go with the provider. Keys stay in your Keychain." : {
