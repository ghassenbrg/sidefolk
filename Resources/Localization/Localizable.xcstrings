    "Requests are understood in English without AI; with AI, in any language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفهم الطلبات بالإنجليزية دون ذكاء اصطناعي؛ ومعه بأي لغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne KI werden Anfragen auf Englisch verstanden, mit KI in jeder Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin IA, las peticiones se entienden en inglés; con IA, en cualquier idioma."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sans IA, les demandes sont comprises en anglais ; avec une IA, dans toutes les langues."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste sono comprese in inglese senza IA; con l'IA, in qualsiasi lingua."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIなしでは英語のみ、AIありではどの言語でも依頼を理解できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 없이는 영어 요청만 이해하고, AI를 쓰면 어떤 언어든 이해해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sem IA, os pedidos são entendidos em inglês; com IA, em qualquer idioma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不使用 AI 时，只能理解英文请求；使用 AI 时，任何语言都可以。"
          }
        }
      }
    },
