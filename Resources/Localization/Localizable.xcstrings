    "Your notes and messages go only to the AI you chose, and only what's needed for the request." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تذهب ملاحظاتك ورسائلك إلا إلى الذكاء الاصطناعي الذي اخترته، ولا يُرسل منها إلا ما يحتاج إليه الطلب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Notizen und Nachrichten gehen nur an die KI, die du gewählt hast, und nur so viel, wie die Anfrage braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus notas y mensajes solo van a la IA que elegiste, y solo lo necesario para la petición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
