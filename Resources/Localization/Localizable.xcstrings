    "Not installed. Run this in Terminal (or use Homebrew: brew install --cask codex), sign in with your ChatGPT account, then click Look again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مثبّت. شغّل هذا في Terminal (أو استخدم Homebrew: brew install --cask codex)، وسجّل الدخول بحسابك في ChatGPT، ثم انقر على «البحث مجددًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nicht installiert. Führe das hier im Terminal aus (oder nutze Homebrew: brew install --cask codex), melde dich mit deinem ChatGPT-Konto an und klicke dann auf „Erneut suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No instalado. Ejecuta esto en Terminal (o usa Homebrew: brew install --cask codex), inicia sesión con tu cuenta de ChatGPT y haz clic en Volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non installé. Exécutez ceci dans Terminal (ou utilisez Homebrew : brew install --cask codex), connectez-vous avec votre compte ChatGPT, puis cliquez sur Vérifier à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non installato. Esegui questo comando nel Terminale (o usa Homebrew: brew install --cask codex), accedi con il tuo account ChatGPT, poi fai clic su Cerca di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストールされていません。ターミナルで次を実行し（またはHomebrewで：brew install --cask codex）、ChatGPTのアカウントでサインインしてから、「再確認」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
