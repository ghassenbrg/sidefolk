    },
    "That looks like a binary file (an image, archive or app), so I can't read it as text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبدو أن هذا ملف ثنائي (صورة أو أرشيف أو تطبيق)، لذا لا يمكنني قراءته كنص."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das sieht nach einer Binärdatei aus (ein Bild, ein Archiv oder eine App), daher kann ich sie nicht als Text lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parece un archivo binario (una imagen, un archivo comprimido o una app), así que no puedo leerlo como texto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
