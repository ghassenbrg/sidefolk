    "Stops after telling you once" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتوقف بعد إخبارك مرة واحدة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Endet, nachdem ich dir einmal Bescheid gesagt habe"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detiene tras avisarte una vez"
          }
        },
