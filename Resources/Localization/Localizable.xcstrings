    "The manifest describes %@, but the program doesn't offer a tool by that name." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصف ملف البيان %@، لكن البرنامج لا يوفّر أداة بهذا الاسم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Manifest beschreibt %@, aber das Programm bietet kein Werkzeug mit diesem Namen an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
