    },
    "I'll add myself to Claude Code and Codex. You'll see exactly what changes, and I keep a backup." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me añadiré a Claude Code y a Codex. Verás exactamente qué cambia, y guardaré una copia de seguridad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vais m’ajouter à Claude Code et à Codex. Vous verrez exactement ce qui change, et je garde une sauvegarde."
