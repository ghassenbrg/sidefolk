        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매니페스트에는 %@ 도구가 설명되어 있지만, 프로그램이 그런 이름의 도구를 제공하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
