    "Saved in your Keychain. Listing voices is free; each spoken line uses characters of your ElevenLabs plan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "محفوظ في سلسلة المفاتيح. عرض الأصوات مجاني؛ أما كل سطر منطوق فيستهلك أحرفًا من خطتك في ElevenLabs."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wird in deinem Schlüsselbund gespeichert. Das Auflisten der Stimmen ist kostenlos; jede gesprochene Zeile verbraucht Zeichen deines ElevenLabs-Tarifs."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardada en tu llavero. Ver la lista de voces es gratis; cada frase hablada gasta caracteres de tu plan de ElevenLabs."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrée dans votre trousseau. Lister les voix est gratuit ; chaque phrase prononcée consomme des caractères de votre forfait ElevenLabs."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvata nel tuo Portachiavi. Elencare le voci è gratuito; ogni frase pronunciata consuma caratteri del tuo piano ElevenLabs."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーチェーンに保存されます。声の一覧の取得は無料ですが、読み上げるたびにElevenLabsのプランの文字数を使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키체인에 저장돼요. 음성 목록을 불러오는 것은 무료이고, 말할 때마다 ElevenLabs 요금제의 글자 수가 사용돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salva nas suas Chaves. Listar vozes é de graça; cada frase falada usa caracteres do seu plano do ElevenLabs."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存在你的钥匙串中。列出语音是免费的；每说一句话都会消耗你的 ElevenLabs 套餐中的字符额度。"
          }
        }
      }
    },
