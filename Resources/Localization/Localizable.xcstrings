    "Ask the user to cancel some first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اطلب من المستخدم إلغاء بعضها أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bitte die Person, zuerst einige zu streichen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al usuario que cancele alguno primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez d’abord à l’utilisateur d’en annuler quelques-uns."
          }
        },
        "it" : {
