          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El usuario desactivó esto para otros agentes en Ajustes › Privacidad › Otros agentes de Sidefolk. Pídele que lo haga en Sidefolk."
