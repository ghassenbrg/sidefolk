    "What you switched off under “What Sidefolk may do” stays off." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que desactivaste en “Lo que Sidefolk puede hacer” sigue desactivado."
