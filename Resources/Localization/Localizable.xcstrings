        }
      }
    },
    "It's downloaded and checked. Sidefolk restarts once you've been away for a few minutes, or the next time you quit it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نُزِّل وفُحص. يُعاد تشغيل Sidefolk بعد ابتعادك لبضع دقائق، أو في المرة التالية التي تُنهيه فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Version ist geladen und geprüft. Sidefolk startet neu, sobald du ein paar Minuten weg warst, oder wenn du es das nächste Mal beendest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está descargada y comprobada. Sidefolk se reinicia cuando lleves unos minutos fuera, o la próxima vez que lo cierres."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette version est téléchargée et vérifiée. Sidefolk redémarre quand vous vous êtes absenté quelques minutes, ou la prochaine fois que vous le quittez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione è scaricata e verificata. Sidefolk si riavvia quando sei via da qualche minuto, o la prossima volta che lo chiudi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードと確認は済んでいます。数分間席を外したとき、または次に終了したときに Sidefolk が再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드와 확인이 끝났어요. 몇 분 동안 자리를 비우거나 다음에 종료할 때 Sidefolk가 다시 시작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Está baixada e verificada. O Sidefolk reinicia quando você ficar alguns minutos ausente, ou na próxima vez que você o encerrar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已下载并检查。你离开几分钟后，或下次退出时，Sidefolk 会重新启动。"
          }
        }
      }
    },
