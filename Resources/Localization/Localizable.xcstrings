    "I can only attach web links (http or https) to a note." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنني أن أرفق بالملاحظة إلا روابط الويب (http أو https)."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann nur Weblinks (http oder https) an eine Notiz anhängen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo puedo adjuntar enlaces web (http o https) a una nota."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne peux joindre à une note que des liens Web (http ou https)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso allegare a una nota solo link web (http o https)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモに添付できるのはWebリンク（httpまたはhttps）だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모에는 웹 링크(http 또는 https)만 첨부할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só consigo anexar links da web (http ou https) a uma nota."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我只能把网页链接（http 或 https）附加到笔记上。"
          }
        }
      }
    },
    "I can only use simple selectors, like span.price, #total or td." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكنني استخدام سوى محددات بسيطة، مثل span.price أو #total أو td."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich kann nur einfache Selektoren verwenden, etwa span.price, #total oder td."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo puedo usar selectores sencillos, como span.price, #total o td."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne sais utiliser que des sélecteurs simples, comme span.price, #total ou td."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Posso usare solo selettori semplici, come span.price, #total o td."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使えるのは、span.price、#total、tdのような単純なセレクタだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "span.price, #total, td 같은 단순한 선택자만 쓸 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
