    "Nothing added yet. Install an extension from a folder, add an MCP server, or ask Sidefolk to build one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُضف شيء بعد. ثبّت ملحقًا من مجلد، أو أضف خادم MCP، أو اطلب من Sidefolk إنشاء ملحق."
