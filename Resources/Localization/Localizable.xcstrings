    "%@ kept crashing, so I turned it off. You can turn it back on in Settings › Extensions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظل %@ يتعطل، لذا أوقفته. يمكنك تشغيله مجددًا من الإعدادات › الملحقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist immer wieder abgestürzt, deshalb habe ich die Erweiterung ausgeschaltet. Du kannst sie in Einstellungen › Erweiterungen wieder einschalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ fallaba una y otra vez, así que la desactivé. Puedes volver a activarla en Ajustes › Extensiones."
