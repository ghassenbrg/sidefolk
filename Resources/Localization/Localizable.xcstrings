    "%lld items in it move to the Trash for 30 days. Restored items go to the Inbox." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "ستُنقل %lld عناصر فيها إلى سلة المهملات لمدة 30 يومًا. تذهب العناصر المستعادة إلى «الوارد»."
                }
              },
              "many" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "سيُنقل %lld عنصرًا فيها إلى سلة المهملات لمدة 30 يومًا. تذهب العناصر المستعادة إلى «الوارد»."
                }
              },
              "one" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "سيُنقل العنصر الموجود فيها إلى سلة المهملات لمدة 30 يومًا. تذهب العناصر المستعادة إلى «الوارد»."
                }
              },
              "other" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "سيُنقل %lld عنصر فيها إلى سلة المهملات لمدة 30 يومًا. تذهب العناصر المستعادة إلى «الوارد»."
                }
              },
              "two" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "سيُنقل العنصران الموجودان فيها إلى سلة المهملات لمدة 30 يومًا. تذهب العناصر المستعادة إلى «الوارد»."
                }
              },
              "zero" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "لا عناصر فيها. تذهب العناصر المستعادة إلى «الوارد»."
