    },
    "I won't create “%@”, because that kind of item can run programs." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن أنشئ «%@»، لأن هذا النوع من العناصر يمكنه تشغيل البرامج."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich erstelle „%@“ nicht, weil solche Objekte Programme ausführen können."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No crearé “%@”, porque ese tipo de elemento puede ejecutar programas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne vais pas créer « %@ », car ce type d’élément peut exécuter des programmes."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non creo “%@”, perché quel tipo di elemento può eseguire programmi."
          }
