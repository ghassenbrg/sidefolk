    "Anthropic couldn't accept that request. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Anthropic قبول هذا الطلب. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic konnte diese Anfrage nicht annehmen. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic no pudo aceptar esa solicitud. No se ha cambiado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic n’a pas pu accepter cette demande. Rien n’a été modifié."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic non ha potuto accettare la richiesta. Non è stato modificato nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropicはそのリクエストを受け付けられませんでした。何も変更されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic에서 그 요청을 받아들일 수 없었어요. 아무것도 변경되지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Anthropic não pôde aceitar esse pedido. Nada foi alterado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anthropic 无法接受这个请求。没有做任何更改。"
          }
        }
      }
    },
    "Anthropic doesn't offer the model “%@” to your account. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يوفّر Anthropic النموذج «%@» لحسابك. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
