        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが行ったすべての操作、依頼者、許可された内容。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 한 모든 일과 누가 요청했는지, 무엇이 허용됐는지."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
