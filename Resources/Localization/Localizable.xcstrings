    "Asks before anything that changes something outside Sidefolk, even if you allowed it before." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل قبل أي شيء يغيّر ما هو خارج Sidefolk، حتى لو سمحت به من قبل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt vor allem, was etwas außerhalb von Sidefolk ändert, auch wenn du es schon einmal erlaubt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta antes de cualquier cosa que cambie algo fuera de Sidefolk, aunque lo hayas permitido antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande avant tout ce qui modifie quelque chose en dehors de Sidefolk, même si vous l’avez déjà autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede prima di tutto ciò che modifica qualcosa fuori da Sidefolk, anche se l'avevi già consentito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkの外で何かを変更する操作は、以前に許可していても、そのつど確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 밖의 무언가를 바꾸는 일은 전에 허용한 적이 있어도 매번 먼저 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta antes de qualquer coisa que altere algo fora do Sidefolk, mesmo que você já tenha permitido antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "凡是会改动 Sidefolk 之外内容的操作，都会先询问，即使你以前允许过。"
          }
        }
      }
    },
