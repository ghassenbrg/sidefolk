        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "데스크탑에서 첫 인사를 다시 보여 줘요. 아무것도 초기화되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
