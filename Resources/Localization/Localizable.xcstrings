    "I'll keep quiet until you say so." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سألتزم الهدوء حتى تطلب غير ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich bleibe im Ruhemodus, bis du es sagst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me quedaré en silencio hasta que me digas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je resterai discret jusqu’à ce que vous me le disiez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resterò in silenzio finché non me lo dici."
