    "More moments, more often, and eyes that follow the pointer across the screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحظات أكثر وبتكرار أكبر، وعينان تتبعان المؤشر عبر الشاشة كلها."
          }
        },
        "de" : {
          "stringUnit" : {
