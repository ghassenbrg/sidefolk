          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 正在为你保留 %2$lld 件事，直到安静结束。"
          }
        }
      }
    },
    "%@ is holding %lld things. They come as one card when Focus ends." : {
      "comment" : "Settings › Attention: what waits during Focus",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ %1$@ بـ %2$lld أشياء. ستصلك في بطاقة واحدة عند انتهاء التركيز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hält %2$lld Dinge zurück. Sie kommen als eine Karte, wenn der Fokus endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is holding %2$lld things. They come as one card when Focus ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda %2$lld cosas. Llegarán en una sola tarjeta cuando termine la Concentración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
