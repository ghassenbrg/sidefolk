    "Tool servers come back switched off: they run with your permissions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود خوادم الأدوات متوقفة: فهي تعمل بصلاحياتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkzeug-Server kommen ausgeschaltet zurück: Sie laufen mit deinen Rechten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores de herramientas vuelven desactivados: se ejecutan con tus permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
