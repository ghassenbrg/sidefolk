            "state" : "translated",
            "value" : "仅在需要时"
          }
        }
      }
    },
    "Only you or Sidefolk itself can create skills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء المهارات مقصور عليك وعلى Sidefolk نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur du oder Sidefolk selbst können Skills erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las habilidades solo las puedes crear tú o el propio Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les compétences ne peuvent être créées que par vous ou par Sidefolk lui-même."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo tu o Sidefolk stesso potete creare abilità."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "スキルを作成できるのは、ユーザー本人かSidefolk自身だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
