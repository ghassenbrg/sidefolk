        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモ、リマインダー、監視、履歴、ログ、保存したキー。この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모, 미리 알림, 지켜보기, 기록, 로그, 저장된 키. 이 작업은 실행 취소할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
