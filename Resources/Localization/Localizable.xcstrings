    "It runs in a sandbox limited to the lines above. You can turn it off or uninstall it any time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل في بيئة معزولة تقتصر على ما ورد أعلاه. يمكنك إيقافه أو إلغاء تثبيته في أي وقت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft in einer Sandbox, die auf die Punkte oben beschränkt ist. Du kannst sie jederzeit ausschalten oder deinstallieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se ejecuta en un entorno aislado limitado a lo indicado arriba. Puedes desactivarla o desinstalarla cuando quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’exécute dans un bac à sable limité aux lignes ci-dessus. Vous pouvez la désactiver ou la désinstaller à tout moment."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
