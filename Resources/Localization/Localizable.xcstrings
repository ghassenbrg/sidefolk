        }
      }
    },
    "Its headphones, antenna, eyes and what it wears." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "السماعتان والهوائي والعينان والملابس."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopfhörer, Antenne, Augen und Outfit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sus auriculares, su antena, sus ojos y lo que lleva puesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son casque, son antenne, ses yeux et sa tenue."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
