      }
    },
    "Sidefolk doesn't touch %@ — it's protected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يلمس Sidefolk %@ — فهو محمي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk rührt %@ nicht an – das ist geschützt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no toca %@: está protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche pas à %@ — c’est protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non tocca %@: è protetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@は保護されているため、Sidefolkは触れません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 %@ 항목을 건드리지 않아요. 보호된 항목이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não mexe em %@ — é um item protegido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 不会动 %@——它受到保护。"
          }
        }
      }
    },
    "Sidefolk doesn't touch hidden files or folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
