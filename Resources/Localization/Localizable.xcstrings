          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「設定」›「アップデート」での選択どおり、自動的にインストールされました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설정 › 업데이트에서 선택한 대로 자동으로 설치됐어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A atualização se instalou sozinha, como você escolheu em Ajustes › Atualizações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已按你在“设置 › 更新”中的选择自动安装。"
          }
        }
      }
    },
    "It keeps running while it's on, and can use all of this by itself, without asking each time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تظل تعمل ما دامت مفعّلة، ويمكنها استخدام كل هذا بنفسها دون أن تسأل في كل مرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie läuft weiter, solange sie an ist, und kann all das von sich aus nutzen, ohne jedes Mal zu fragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue funcionando mientras está activada y puede usar todo esto por sí sola, sin preguntar cada vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle reste active tant qu’elle est activée, et peut utiliser tout cela d’elle-même, sans demander à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resta in esecuzione finché è attiva e può usare tutto questo da sola, senza chiedere ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンのあいだは動き続け、ここにあることを毎回確認せずに自分で使えます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "켜져 있는 동안 계속 실행되며, 매번 묻지 않고 이 모든 것을 스스로 사용할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ela continua rodando enquanto está ativada e pode usar tudo isso sozinha, sem perguntar toda vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "开启期间它会一直运行，并且可以自行使用以上所有权限，不会每次都询问。"
          }
        }
      }
    },
    "It kept using more than half a CPU core for a minute." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظل يستخدم أكثر من نصف نواة معالج لمدة دقيقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hat eine Minute lang mehr als einen halben CPU-Kern belegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estuvo usando más de medio núcleo de CPU durante un minuto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle a utilisé plus d’un demi-cœur de processeur pendant une minute d’affilée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha continuato a usare più di metà di un core della CPU per un minuto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1分間にわたって、CPUコアの半分以上を使い続けました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1분 동안 CPU 코어 절반 이상을 계속 사용했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
