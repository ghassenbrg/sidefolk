    "Edit notes, move them, mark tasks done, arrange your collections, or move notes to the Trash. Only you can empty the Trash." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عدّل الملاحظات وانقلها، وحدّد المهام كمنجزة، ورتّب مجموعاتك، أو انقل الملاحظات إلى سلة المهملات. وحدك من يستطيع إفراغ سلة المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bearbeite Notizen, verschiebe sie, hake Aufgaben ab, ordne deine Sammlungen an oder lege Notizen in den Papierkorb. Nur du kannst den Papierkorb leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edita notas, muévelas, marca tareas como hechas, ordena tus colecciones o pasa notas a la Papelera. Solo tú puedes vaciar la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifiez des notes, déplacez-les, marquez des tâches comme faites, organisez vos collections ou placez des notes dans la Corbeille. Seul vous pouvez vider la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifica le note, spostale, segna le attività come fatte, riordina le tue raccolte o sposta le note nel Cestino. Solo tu puoi svuotare il Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの編集や移動、タスクの完了、コレクションの並べ替え、メモのゴミ箱への移動ができます。ゴミ箱を空にできるのはご自身だけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 편집하고 옮기고, 할 일을 완료하고, 모음을 정렬하고, 메모를 휴지통으로 옮길 수 있어요. 휴지통은 직접 비울 때만 비워져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Edite notas, mova-as, marque tarefas como feitas, organize suas coleções ou mova notas para o Lixo. Só você pode esvaziar o Lixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以编辑笔记、移动笔记、将任务标为已完成、整理合集,或将笔记移到废纸篓。只有你可以清倒废纸篓。"
          }
        }
      }
    },
    "Edit notes, move them, mark tasks done, or move them to the Trash. Only you can empty the Trash." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعديل الملاحظات ونقلها ووضع علامة على المهام المنجزة أو نقلها إلى سلة المهملات. أنت وحدك من يمكنه إفراغ سلة المهملات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Notizen bearbeiten, verschieben, Aufgaben abhaken oder in den Papierkorb legen. Nur du kannst den Papierkorb leeren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Editar notas, moverlas, marcar tareas como hechas o trasladarlas a la Papelera. Solo tú puedes vaciar la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modifier des notes, les déplacer, cocher des tâches, ou les placer dans la Corbeille. Vous seul pouvez vider la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modificare note, spostarle, segnare attività come fatte o spostarle nel Cestino. Solo tu puoi svuotare il Cestino."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メモの編集や移動、タスクの完了、ゴミ箱への移動を行います。ゴミ箱を空にできるのはあなただけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "메모를 편집하고, 옮기고, 할 일을 완료로 표시하거나 휴지통으로 이동합니다. 휴지통은 나만 비울 수 있습니다."
          }
