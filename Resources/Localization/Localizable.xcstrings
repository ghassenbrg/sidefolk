    "You didn't answer in time, so the task stopped here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُجب في الوقت المناسب، لذا توقفت المهمة هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast nicht rechtzeitig geantwortet, deshalb wurde die Aufgabe hier gestoppt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No respondiste a tiempo, así que la tarea se detuvo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez pas répondu à temps, la tâche s’est donc arrêtée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non hai risposto in tempo, quindi l'operazione si è fermata qui."
          }
