    "Sidefolk stopped using Claude Code because it couldn't keep it isolated." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقف Sidefolk عن استخدام Claude Code لأنه لم يتمكن من إبقائه معزولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk verwendet Claude Code nicht mehr, weil es sich nicht isolieren ließ."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk dejó de usar Claude Code porque no podía mantenerlo aislado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk a cessé d’utiliser Claude Code, faute de pouvoir l’isoler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ha smesso di usare Claude Code perché non poteva tenerlo isolato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Codeを隔離した状態に保てなかったため、SidefolkはClaude Codeの使用を停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code를 격리된 상태로 유지할 수 없어서 Sidefolk에서 Claude Code 사용을 중단했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk parou de usar o Claude Code porque não conseguiu mantê-lo isolado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 无法保持 Claude Code 的隔离，所以停止使用它。"
          }
