        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non te l'ha ancora chiesto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSからはまだ確認されていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 아직 묻지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS ainda não perguntou."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 还没有询问过你。"
          }
        }
      }
    },
    "macOS hasn't let Sidefolk read your calendars." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يسمح macOS لـ Sidefolk بقراءة تقويماتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS hat Sidefolk nicht erlaubt, deine Kalender zu lesen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS no ha dejado que Sidefolk lea tus calendarios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS n’a pas laissé Sidefolk lire vos calendriers."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non ha permesso a Sidefolk di leggere i tuoi calendari."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがSidefolkにカレンダーの読み取りを許可していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 Sidefolk의 캘린더 읽기를 허용하지 않았습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS não deixou o Sidefolk ler seus calendários."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 未允许 Sidefolk 读取你的日历。"
          }
        }
      }
    },
    "macOS is downloading it into its own storage, not into Sidefolk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينزّله macOS إلى مساحة التخزين الخاصة به، لا إلى Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lädt es in seinen eigenen Speicher, nicht in Sidefolk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo está descargando en su propio almacenamiento, no en Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS le télécharge dans son propre stockage, pas dans Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS lo sta scaricando nel proprio spazio di archiviazione, non in Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSがシステム自身のストレージにダウンロードしています。Sidefolkには保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS가 Sidefolk가 아닌 시스템 저장 공간에 다운로드하고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS está baixando no armazenamento dele, não no do Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 正在把它下载到系统自己的存储空间，而不是 Sidefolk 中。"
          }
        }
      }
    },
    "macOS may ask you to allow Sidefolk in Local Network the first time it looks for devices nearby." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد يطلب منك macOS السماح لـ Sidefolk في الشبكة المحلية أول مرة تبحث فيها عن أجهزة قريبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS fragt dich vielleicht, Sidefolk unter Lokales Netzwerk zu erlauben, wenn sie zum ersten Mal Geräte in der Nähe sucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede que macOS te pida permitir Sidefolk en Red local la primera vez que busque dispositivos cercanos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS peut vous demander d’autoriser Sidefolk dans Réseau local la première fois qu’elle cherche des appareils à proximité."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS potrebbe chiederti di consentire Sidefolk in Rete locale la prima volta che cerca dispositivi vicini."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "近くのデバイスを初めて探すとき、macOS が「ローカルネットワーク」で Sidefolk を許可するよう求めることがあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주변 기기를 처음 찾을 때 macOS가 로컬 네트워크에서 Sidefolk를 허용해 달라고 할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS pode pedir que você permita o Sidefolk em Rede Local na primeira vez que ela procurar dispositivos por perto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它第一次查找附近设备时，macOS 可能会请你在“本地网络”中允许 Sidefolk。"
          }
        }
      }
    },
    "macOS needs to download this language's speech model once. It goes into the system's storage." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج macOS إلى تنزيل نموذج الكلام لهذه اللغة مرة واحدة. ويُحفظ في مساحة تخزين النظام."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS muss das Spracherkennungsmodell für diese Sprache einmal herunterladen. Es wird im Systemspeicher abgelegt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS tiene que descargar una vez el modelo de voz de este idioma. Se guarda en el almacenamiento del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS doit télécharger une fois le modèle de reconnaissance vocale de cette langue. Il est placé dans le stockage du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS deve scaricare una volta il modello vocale di questa lingua. Viene salvato nello spazio di archiviazione del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この言語の音声認識モデルを、macOSが一度ダウンロードする必要があります。システムのストレージに保存されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 이 언어의 음성 인식 모델을 한 번 다운로드해야 해요. 시스템 저장 공간에 저장돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS precisa baixar uma vez o modelo de fala deste idioma. Ele fica no armazenamento do sistema."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 需要先下载一次这种语言的语音识别模型。它会存放在系统的存储空间中。"
          }
        }
      }
    },
    "macOS runs this copy from a protected place because it was opened where it was downloaded." : {
      "comment" : "Why an update is downloaded rather than installed (App Translocation)",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل macOS هذه النسخة من مكان محمي لأنها فُتحت في المكان الذي نُزّلت فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS führt diese Kopie von einem geschützten Ort aus, weil sie dort geöffnet wurde, wo sie heruntergeladen wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ejecuta esta copia desde un lugar protegido porque se abrió donde se descargó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS exécute cette copie depuis un emplacement protégé parce qu’elle a été ouverte là où elle a été téléchargée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS esegue questa copia da una posizione protetta perché è stata aperta dove è stata scaricata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ダウンロードした場所のまま開かれたため、macOSがこのSidefolkを保護された場所から実行しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 위치에서 그대로 열어서 macOS가 이 Sidefolk를 보호된 위치에서 실행하고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS executa esta cópia de um local protegido porque ela foi aberta onde foi baixada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "因为是在下载的位置直接打开的，所以 macOS 让这份 Sidefolk 在受保护的位置运行。"
          }
        }
      }
    },
    "macOS wants you to approve Sidefolk in Login Items." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب macOS موافقتك على Sidefolk في عناصر تسجيل الدخول."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS möchte, dass du Sidefolk in den Anmeldeobjekten erlaubst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS quiere que apruebes Sidefolk en Ítems de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vous demande d’autoriser Sidefolk dans Réglages Système › Général › Ouverture."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vuole che tu approvi Sidefolk in Elementi login."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ログイン項目でSidefolkを承認する必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS에서 로그인 항목에 Sidefolk를 승인해야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS quer que você aprove o Sidefolk em Itens de Início."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 需要你在登录项中批准 Sidefolk。"
          }
        }
      }
    },
