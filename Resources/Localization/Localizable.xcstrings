    "A small peek at the edge of the screen until something needs you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إطلالة صغيرة من حافة الشاشة إلى أن يحتاج إليك شيء ما."
          }
        },
        "de" : {
          "stringUnit" : {
