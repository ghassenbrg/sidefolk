            "value" : "Compétence Sidefolk dans Claude Code"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abilità Sidefolk in Claude Code"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude CodeのSidefolkスキル"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code의 Sidefolk 스킬"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Habilidade do Sidefolk no Claude Code"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code 中的 Sidefolk 技能"
          }
        }
      }
    },
    "Sidefolk skill in Codex" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مهارة Sidefolk في Codex"
          }
        },
        "de" : {
