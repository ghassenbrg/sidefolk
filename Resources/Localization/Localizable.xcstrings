    "That location is too broad to share. Add a specific folder in Settings › Privacy & Permissions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الموقع أوسع من أن تتم مشاركته. أضف مجلدًا محددًا في الإعدادات › الخصوصية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Ort ist zu allgemein für eine Freigabe. Füge in Einstellungen › Datenschutz einen bestimmten Ordner hinzu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esa ubicación es demasiado amplia para compartirla. Añade una carpeta concreta en Ajustes › Privacidad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
