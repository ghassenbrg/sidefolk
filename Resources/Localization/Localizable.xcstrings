          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un minuto después de que Sidefolk se inicie y luego una vez al día. Siempre pregunta antes de instalar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une minute après le démarrage de Sidefolk, puis une fois par jour. Il demande toujours avant d’installer."
