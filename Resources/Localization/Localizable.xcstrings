    "Adds the Sidefolk skill in %@, which tells the agent when and how to use Sidefolk's tools." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف مهارة Sidefolk في %@، وهي تخبر الوكيل متى وكيف يستخدم أدوات Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fügt in %@ den Sidefolk-Skill hinzu, der dem Agenten sagt, wann und wie er die Werkzeuge von Sidefolk nutzen soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade la habilidad de Sidefolk en %@, que le indica al agente cuándo y cómo usar las herramientas de Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoute la compétence Sidefolk dans %@, qui indique à l’agent quand et comment utiliser les outils de Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge l'abilità Sidefolk in %@, che dice all'agente quando e come usare gli strumenti di Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@にSidefolkのスキルを追加します。Sidefolkのツールをいつ、どのように使うかをエージェントに伝えるものです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@에 Sidefolk 스킬을 추가해요. 에이전트가 Sidefolk의 도구를 언제, 어떻게 쓰면 되는지 알려 주는 스킬이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adiciona a habilidade do Sidefolk em %@, que diz ao agente quando e como usar as ferramentas do Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在 %@ 中添加 Sidefolk 技能，告诉智能体何时以及如何使用 Sidefolk 的工具。"
          }
