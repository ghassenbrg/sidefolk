    "What %@ keeps in mind about you, and where each fact came from." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما يحتفظ به %@ عنك، ومن أين أتت كل معلومة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was %@ über dich im Kopf behält und woher jeder Fakt stammt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que %@ tiene presente sobre ti y de dónde viene cada dato."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que %@ garde en tête à votre sujet, et d’où vient chaque fait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che %@ tiene a mente su di te e da dove viene ogni fatto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@があなたについて覚えていることと、それぞれの出どころ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@이(가) 당신에 대해 기억하는 것과 각 사실의 출처."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que %@ guarda sobre você e de onde veio cada fato."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 记住的关于你的事，以及每条信息的来源。"
          }
        }
      }
    },
    "What %@ says is always shown on screen too. Quiet mode keeps %@ silent, and so does a call or typing again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلام %1$@ يظهر دائمًا على الشاشة أيضًا. وضع الهدوء يُسكت %2$@، وكذلك المكالمة أو معاودة الكتابة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Was %1$@ sagt, steht immer auch auf dem Bildschirm. Im Ruhemodus bleibt %2$@ stumm, ebenso während eines Anrufs oder wenn du wieder tippst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What %1$@ says is always shown on screen too. Quiet mode keeps %2$@ silent, and so does a call or typing again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que dice %1$@ también se muestra siempre en pantalla. Con el modo silencio %2$@ no habla, y tampoco durante una llamada ni si vuelves a escribir."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que dit %1$@ s’affiche toujours aussi à l’écran. Le mode discret fait taire %2$@, et il en va de même pendant un appel ou quand vous recommencez à taper."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ciò che dice %1$@ compare sempre anche sullo schermo. Con la modalità silenziosa %2$@ non parla, e non parla nemmeno durante una chiamata o se riprendi a scrivere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@の言葉は、必ず画面にも表示されます。静かモード中、通話中、または入力を再開したときは、%2$@は声を出しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@의 말은 항상 화면에도 표시돼요. 조용한 모드일 때, 통화 중일 때, 다시 입력하기 시작할 때는 %2$@의 목소리가 나오지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O que %1$@ diz também aparece sempre na tela. O modo silencioso deixa %2$@ sem falar, e uma chamada ou voltar a digitar também."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 说的话也始终会显示在屏幕上。安静模式、通话中，或你又开始打字时，%2$@ 都不会出声。"
          }
        }
      }
    },
