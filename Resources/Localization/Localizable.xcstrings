    "Typed requests are understood in English without AI; with AI, in any language." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُفهم الطلبات المكتوبة بالإنجليزية دون ذكاء اصطناعي؛ ومع الذكاء الاصطناعي، بأي لغة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ohne KI verstehe ich getippte Anfragen nur auf Englisch, mit KI in jeder Sprache."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
