          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voz de IA. %@ nunca lee en voz alta enlaces, rutas de archivos ni código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une voix d’IA. %@ ne lit jamais à voix haute les liens, les chemins de fichiers ni le code."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voce IA. %@ non legge mai ad alta voce link, percorsi di file o codice."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIの声です。%@はリンク、ファイルパス、コードを読み上げません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 음성입니다. %@은(는) 링크, 파일 경로, 코드를 소리 내어 읽지 않습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma voz de IA. %@ nunca lê em voz alta links, caminhos de arquivo ou código."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 语音。%@ 从不朗读链接、文件路径或代码。"
          }
        }
      }
    },
    "An AI voice. %@ says one short line, and never reads out links, file paths or code." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "صوت مولَّد بالذكاء الاصطناعي. كلام %@ سطر واحد قصير، ولا يُقرأ فيه رابط أو مسار ملف أو شيفرة أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine KI-Stimme. %@ sagt eine kurze Zeile und liest nie Links, Dateipfade oder Code vor."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voz de IA. %@ dice una frase corta y nunca lee en voz alta enlaces, rutas de archivos ni código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
