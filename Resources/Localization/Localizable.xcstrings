    "When — e.g. “tomorrow 9am” or “every 30 minutes”; leave empty to keep %@" : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "متى — مثل «tomorrow 9am» أو «every 30 minutes»؛ اتركه فارغًا للإبقاء على %@"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wann – z. B. „tomorrow 9am“ oder „every 30 minutes“; leer lassen, um %@ zu behalten"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuándo — p. ej. “tomorrow 9am” o “every 30 minutes”; déjalo vacío para mantener %@"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quand — par ex. « tomorrow 9am » ou « every 30 minutes » ; laissez vide pour garder %@"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando — ad es. “tomorrow 9am” o “every 30 minutes”; lascia vuoto per mantenere %@"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日時 — 例：「tomorrow 9am」「every 30 minutes」。空欄にすると%@のままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시점 — 예: “tomorrow 9am” 또는 “every 30 minutes”. 비워 두면 현재 설정(%@)이 유지돼요"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando — por exemplo, “tomorrow 9am” ou “every 30 minutes”; deixe vazio para manter %@"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何时——例如“tomorrow 9am”或“every 30 minutes”；留空则保留 %@"
          }
        }
      }
    },
