    "This opens a link or app with what it's given, so I check with you first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا يفتح رابطًا أو تطبيقًا بما يُعطى له، لذا أتحقق منك أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das öffnet einen Link oder eine App mit dem, was es bekommt, deshalb frage ich dich zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
