          "stringUnit" : {
            "state" : "translated",
            "value" : "Klone öffentliche Repositorys in einen Ordner deiner Wahl, prüfe und aktualisiere die vorhandenen und lies ihren Verlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clonar repositorios públicos en una carpeta que elijas, y comprobar, actualizar y leer el historial de los que ya tienes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cloner des dépôts publics dans un dossier de votre choix, puis vérifier l’état de ceux que vous avez, les mettre à jour et lire leur historique."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clonare repository pubblici in una cartella a tua scelta e controllare, aggiornare e leggere la cronologia di quelli che hai."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開リポジトリを選んだフォルダにクローンし、手元のリポジトリの状態確認、更新、履歴の閲覧ができます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 저장소를 선택한 폴더로 복제하고, 가지고 있는 저장소의 상태를 확인하고 업데이트하고 기록을 읽을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Clone repositórios públicos para uma pasta de sua escolha e verifique, atualize e leia o histórico dos que você já tem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "把公开仓库克隆到你选择的文件夹，并检查、更新已有的仓库，查看它们的提交历史。"
          }
        }
      }
    },
