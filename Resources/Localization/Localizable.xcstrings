    "We both played paper: a draw!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كلانا اختار الورقة: تعادل!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wir haben beide Papier gespielt: Unentschieden!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los dos hemos sacado papel: ¡empate!"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nous avons joué feuille tous les deux : égalité !"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abbiamo giocato entrambi carta: pareggio!"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どちらもパーで、あいこです！"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "둘 다 보를 냈어요. 비겼어요!"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nós dois jogamos papel: empate!"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我们都出了布：平局！"
          }
        }
      }
    },
