            "state" : "translated",
            "value" : "応答は%@でした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응답: %@."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
