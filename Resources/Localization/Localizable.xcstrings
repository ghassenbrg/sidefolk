    "Today's weather and the week ahead" : {
      "comment" : "Weather: one line under its name",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "طقس اليوم والأسبوع القادم"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Wetter heute und die Woche voraus"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
