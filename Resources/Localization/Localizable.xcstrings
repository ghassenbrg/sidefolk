            "value" : "لا شيء بعد. عندما تختار «السماح دائمًا»، يظهر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nichts. Wenn du „Immer erlauben“ wählst, steht es hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún nada. Cuando elijas “Permitir siempre”, aparecerá aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rien pour l’instant. Quand vous choisissez « Toujours autoriser », l’action apparaît ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ancora niente. Quando scegli “Consenti sempre”, compare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだありません。「常に許可」を選ぶと、ここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 없어요. “항상 허용”을 선택하면 여기에 표시돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada ainda. Quando você escolhe “Sempre permitir”, aparece aqui."
