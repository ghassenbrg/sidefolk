    "Start from a copy of Harbor in a folder, or use a theme folder you have. Sidefolk repaints each time you save." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ من نسخة من Harbor في مجلد، أو استخدم مجلد سمة لديك. يعيد Sidefolk الرسم في كل مرة تحفظ فيها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beginne mit einer Kopie von Harbor in einem Ordner oder nutze einen vorhandenen Theme-Ordner. Sidefolk zeichnet sich bei jedem Sichern neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Empieza con una copia de Harbor en una carpeta, o usa una carpeta de tema que ya tengas. Sidefolk se vuelve a pintar cada vez que guardas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Partez d'une copie de Harbor dans un dossier, ou utilisez un dossier de thème existant. Sidefolk se redessine à chaque enregistrement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Parti da una copia di Harbor in una cartella, o usa una cartella di tema che hai già. Sidefolk si ridisegna a ogni salvataggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダに Harbor のコピーを作って始めるか、手元のテーマフォルダを使います。保存するたびに Sidefolk が描き直します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더에 Harbor 사본으로 시작하거나 가지고 있는 테마 폴더를 사용하세요. 저장할 때마다 Sidefolk가 다시 그려집니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comece com uma cópia do Harbor em uma pasta, ou use uma pasta de tema que você já tem. O Sidefolk se redesenha a cada vez que você salva."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从文件夹中的 Harbor 副本开始，或使用你已有的主题文件夹。每次保存，Sidefolk 都会重新绘制。"
          }
        }
      }
    },
    "Start here" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ هنا"
          }
