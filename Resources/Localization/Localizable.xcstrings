    "%@ is holding %lld things until Quiet ends." : {
      "comment" : "Settings › Attention: what waits during Quiet",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ %1$@ بـ %2$lld أشياء حتى ينتهي الهدوء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hält %2$lld Dinge zurück, bis der Ruhemodus endet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ is holding %2$lld things until Quiet ends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda %2$lld cosas hasta que termine el Silencio."
          }
