    "After %lld minutes, the task carries on without it. The step waits in Now, where you can still run it." : {
      "localizations" : {
        "ar" : {
          "variations" : {
            "plural" : {
              "few" : {
                "stringUnit" : {
                  "state" : "translated",
                  "value" : "بعد %lld دقائق، تواصل المهمة عملها من دون هذه الخطوة. وتنتظر الخطوة في «الآن»، حيث يمكنك تنفيذها."
                }
              },
              "many" : {
