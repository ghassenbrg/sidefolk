    "I won't move, rename or delete %@. It's one of the main folders in your home folder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن أنقل %@ أو أعيد تسميته أو أحذفه. إنه أحد المجلدات الرئيسية في مجلد المستخدم الخاص بك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich werde %@ weder verschieben noch umbenennen noch löschen. Das ist einer der Hauptordner in deinem Benutzerordner."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No moveré, renombraré ni eliminaré %@. Es una de las carpetas principales de tu carpeta de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je ne vais pas déplacer, renommer ni supprimer %@. C’est l’un des dossiers principaux de votre dossier de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sposto, non rinomino e non elimino %@. È una delle cartelle principali della tua cartella Inizio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
