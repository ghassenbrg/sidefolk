    "There's no collection called “%@”, and other apps can't create one." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مجموعة باسم «%@»، ولا يمكن للتطبيقات الأخرى إنشاء واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Sammlung namens „%@“, und andere Apps können keine erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna colección llamada “%@”, y otras apps no pueden crearla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe pas de collection nommée « %@ », et les autres apps ne peuvent pas en créer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esiste una raccolta chiamata “%@”, e le altre app non possono crearne una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」という名前のコレクションはなく、ほかのアプリからは作成できません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 모음이 없고, 다른 앱은 모음을 만들 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe uma coleção chamada “%@”, e outros apps não podem criar uma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有名为“%@”的合集，而其他应用不能创建合集。"
          }
        }
      }
    },
    "There's no collection called “%@”, and other apps can't create one. Save it without a collection (it goes to the Inbox), or ask the user to create it in Sidefolk first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد مجموعة باسم «%@»، ولا يمكن للتطبيقات الأخرى إنشاءها. احفظه دون مجموعة (فيذهب إلى «الوارد»)، أو اطلب من المستخدم إنشاءها في Sidefolk أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Sammlung namens „%@“, und andere Apps können keine erstellen. Speichere es ohne Sammlung (es landet im Eingang) oder bitte die Person, sie zuerst in Sidefolk zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hay ninguna colección llamada “%@”, y otras apps no pueden crearla. Guárdalo sin colección (va a la Bandeja de entrada) o pide al usuario que la cree antes en Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’existe aucune collection nommée « %@ », et les autres apps ne peuvent pas en créer. Enregistrez-le sans collection (il va dans la Boîte de réception), ou demandez à l’utilisateur de la créer d’abord dans Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non esiste nessuna raccolta chiamata “%@”, e le altre app non possono crearla. Salvalo senza raccolta (finisce nella raccolta In arrivo) o chiedi all'utente di crearla prima in Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」というコレクションはなく、ほかのアプリからは作成できません。コレクションを指定せずに保存する（インボックスに入ります）か、先にSidefolkで作成するようユーザーに頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”라는 모음이 없고, 다른 앱은 모음을 만들 수 없어요. 모음 없이 저장하거나(수신함에 들어가요), 먼저 Sidefolk에서 만들어 달라고 사용자에게 요청하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não existe uma coleção chamada “%@”, e outros apps não podem criar uma. Salve sem coleção (vai para a Caixa de Entrada) ou peça à pessoa que a crie primeiro no Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有名为“%@”的合集，其他应用也无法创建合集。请不指定合集直接保存（会放入收件箱），或先请用户在 Sidefolk 中创建它。"
          }
        }
      }
    },
    "There's no more room beside me. Move another live value away first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يعد هناك مكان بجانبي. انقل قيمة مباشرة أخرى أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neben mir ist kein Platz mehr. Verschiebe zuerst einen anderen Live-Wert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya no hay sitio junto a mí. Antes, aparta otro valor en vivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il n’y a plus de place à côté de moi. Déplacez d’abord une autre valeur en direct."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non c’è più posto accanto a me. Prima sposta un altro valore dal vivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "そばにこれ以上置く場所がありません。先にほかのライブ値を移してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "내 옆에 더 둘 자리가 없어요. 먼저 다른 실시간 값을 옮겨 주세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
