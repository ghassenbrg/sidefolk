            "value" : "Le site a répondu %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ha risposto %@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "応答は%@でした。"
          }
        },
        "ko" : {
