    },
    "Not allowed for Sidefolk. Allow it in System Settings, or choose a place instead." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مسموح لـ Sidefolk. اسمح بذلك في إعدادات النظام، أو اختر مكانًا بدلًا من ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für Sidefolk nicht erlaubt. Erlaube es in den Systemeinstellungen oder wähle stattdessen einen Ort."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
