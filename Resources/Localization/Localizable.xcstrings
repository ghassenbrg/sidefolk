    "%@ changed while Sidefolk was editing it. Nothing was written; try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر %@ بينما كان Sidefolk يعدّله. لم يُكتب شيء؛ حاول مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ wurde geändert, während Sidefolk daran gearbeitet hat. Es wurde nichts geschrieben. Versuche es erneut."
