    "Some of it was already done; Activity shows what." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أُنجز بعضه بالفعل؛ يعرض «النشاط» ما أُنجز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Teil war schon erledigt; „Aktivität“ zeigt, welcher."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte ya estaba hecha; Actividad muestra cuál."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une partie était déjà faite ; Activité indique laquelle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una parte era già stata fatta; il Registro mostra cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一部はすでに完了しています。内容はアクティビティで確認できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "일부는 이미 처리했어요. 무엇을 했는지는 활동에서 볼 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma parte já foi feita; a Atividade mostra o quê."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分操作已经完成；可以在“活动”中查看具体内容。"
          }
        }
      }
    },
    "Some tools changed since you installed it; they're on hold until you approve the change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت بعض الأدوات منذ تثبيته؛ وهي متوقفة مؤقتًا إلى أن توافق على التغيير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Werkzeuge haben sich seit der Installation geändert. Sie sind angehalten, bis du der Änderung zustimmst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas herramientas han cambiado desde que la instalaste; quedan en espera hasta que apruebes el cambio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certains outils ont changé depuis son installation ; ils sont en attente jusqu’à ce que vous approuviez la modification."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alcuni strumenti sono cambiati da quando l'hai installata; restano sospesi finché non approvi la modifica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール後に一部のツールが変更されました。変更を承認するまで保留にしています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치한 후 일부 도구가 변경되었어요. 변경 사항을 승인할 때까지 보류돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas ferramentas mudaram desde a instalação; estão em espera até você aprovar a mudança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自你安装以来，部分工具已更改；在你批准这项更改前，它们会被暂停。"
          }
        }
      }
    },
    "Something called %@ already uses the id %@." : {
