    "These changed or appeared since you installed it: %@. Approve only if you expected an update from %@." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه تغيّرت أو ظهرت منذ تثبيته: %1$@. لا توافق إلا إذا كنت تتوقع تحديثًا من %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit der Installation geändert oder neu: %1$@. Stimme nur zu, wenn du ein Update von %2$@ erwartet hast."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These changed or appeared since you installed it: %1$@. Approve only if you expected an update from %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos elementos cambiaron o aparecieron desde que la instalaste: %1$@. Apruébalo solo si esperabas una actualización de %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces éléments ont changé ou sont apparus depuis son installation : %1$@. N’approuvez que si vous attendiez une mise à jour de %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi elementi sono cambiati o comparsi da quando l'hai installata: %1$@. Approva solo se ti aspettavi un aggiornamento da %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール後に次のものが変更または追加されました：%1$@。%2$@からのアップデートを予期していた場合のみ承認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치한 후 다음 항목이 변경되거나 새로 생겼어요: %1$@. %2$@에서 업데이트가 있을 거라고 예상한 경우에만 승인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto mudou ou apareceu desde a instalação: %1$@. Só aprove se você esperava uma atualização de %2$@."
