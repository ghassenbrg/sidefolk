    "My answer got cut off before I could finish. Try asking for less at once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطعت إجابتي قبل أن أُنهيها. جرّب أن تطلب أقل دفعة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
