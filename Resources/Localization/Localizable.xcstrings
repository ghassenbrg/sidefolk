      }
    },
    "%@ is a hard link: the same file also has another name, possibly in a folder you haven't shared, so I won't open or move it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ رابط صلب: للملف نفسه اسم آخر أيضًا، ربما في مجلد لم تشاركه، لذا لن أفتحه أو أنقله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ ist ein harter Link: Dieselbe Datei hat noch einen anderen Namen, vielleicht in einem Ordner, den du nicht freigegeben hast. Deshalb öffne oder verschiebe ich sie nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ es un enlace físico: el mismo archivo tiene también otro nombre, quizá en una carpeta que no has compartido, así que no lo abriré ni lo moveré."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ est un lien physique : ce même fichier porte aussi un autre nom, peut-être dans un dossier que vous n’avez pas partagé, je ne vais donc ni l’ouvrir ni le déplacer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ è un hard link: lo stesso file ha anche un altro nome, forse in una cartella che non hai condiviso, quindi non lo apro né lo sposto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@はハードリンクです。同じファイルが別の名前でも存在し、共有していないフォルダにある可能性もあるため、開いたり移動したりしません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 항목은 하드 링크예요. 같은 파일이 공유하지 않은 폴더에 다른 이름으로도 있을 수 있어서 열거나 옮기지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ é um link físico: o mesmo arquivo também tem outro nome, talvez numa pasta que você não compartilhou, então não vou abrir nem mover."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 是硬链接：同一个文件还有另一个名称，可能位于你未共享的文件夹中，所以我不会打开或移动它。"
          }
        }
      }
    },
