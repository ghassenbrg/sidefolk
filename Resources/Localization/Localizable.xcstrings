        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 확장 프로그램이 계속 멈춰서 꺼 두었어요. 설정 › 확장 프로그램에서 다시 켤 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ falhava sem parar, então desativei. Você pode reativar em Ajustes › Extensões."
