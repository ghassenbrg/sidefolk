    "Reminders and watches only work while I'm running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تعمل التذكيرات والمراقبات إلا أثناء تشغيلي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen und Beobachtungen funktionieren nur, solange ich laufe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios y las vigilancias solo funcionan mientras estoy en marcha."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels et les surveillances ne fonctionnent que si je suis en marche."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria e sentinelle funzionano solo mentre Sidefolk è aperto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーと監視は、Sidefolkの実行中にだけ動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "미리 알림과 지켜보기는 제가 실행 중일 때만 작동해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lembretes e monitoramentos só funcionam enquanto eu estiver em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提醒和监视只在我运行时有效。"
          }
        }
      }
    },
    "Reminders can reach you when the companion is hidden or you're in another Space." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن أن تصلك التذكيرات عندما يكون الرفيق مخفيًا أو تكون في مساحة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erinnerungen erreichen dich auch, wenn der Begleiter ausgeblendet ist oder du in einem anderen Space bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los recordatorios pueden llegarte aunque el acompañante esté oculto o estés en otro espacio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les rappels peuvent vous joindre quand le compagnon est masqué ou que vous êtes sur un autre bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria possono raggiungerti quando il compagno è nascosto o sei in un altro Spazio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "相棒が隠れているときや、別の操作スペースにいるときでも、リマインダーが届きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언이 숨어 있거나 다른 Space에 있을 때도 미리 알림을 받을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os lembretes podem chegar a você quando o companheiro está oculto ou você está em outro Espaço."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "伙伴被隐藏或你在其他空间时，提醒也能送达。"
          }
        }
      }
    },
