        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "받은 내용을 이 Mac 밖으로 보낼 수 있어서 먼저 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso pode enviar o que recebe para fora deste Mac, então confiro com você antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它可以把收到的内容发送到这台 Mac 之外，所以我先问你。"
          }
        }
      }
    },
    "This can't be undone." : {
