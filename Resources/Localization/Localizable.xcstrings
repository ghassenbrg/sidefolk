    "“%@” can't be used as a file name. It must be just a name, with no “/”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن استخدام «%@» اسمًا لملف. يجب أن يكون اسمًا فقط، دون «/»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„%@“ kann nicht als Dateiname verwendet werden. Es muss ein reiner Name sein, ohne „/“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” no se puede usar como nombre de archivo. Debe ser solo un nombre, sin “/”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » ne peut pas servir de nom de fichier. Il doit s’agir d’un simple nom, sans « / »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” non può essere usato come nome di file. Deve essere solo un nome, senza “/”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%@」はファイル名として使えません。「/」を含まない名前だけにしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 이름은 파일 이름으로 쓸 수 없어요. “/” 없이 이름만 써야 해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” não pode ser usado como nome de arquivo. Precisa ser só um nome, sem “/”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@”不能用作文件名。它只能是一个名称，不能包含“/”。"
          }
        }
      }
    },
