          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não conseguiu iniciar"
          }
        }
      }
    },
    "Sidefolk doesn't create hidden files or folders (names starting with a dot)." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no crea archivos ni carpetas ocultos (nombres que empiezan por un punto)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne crée pas de fichiers ni de dossiers masqués (noms commençant par un point)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non crea file o cartelle nascosti (nomi che iniziano con un punto)."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 숨김 파일이나 폴더(이름이 마침표로 시작하는 것)를 만들지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não cria arquivos nem pastas ocultos (nomes que começam com ponto)."
          }
        }
      }
    },
    "Sidefolk doesn't offer a tool called %@ to other agents." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no ofrece a otros agentes ninguna herramienta llamada %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne propose pas d’outil nommé %@ aux autres agents."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non offre agli altri agenti uno strumento chiamato %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 다른 에이전트에 %@ 도구를 제공하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não oferece uma ferramenta chamada %@ a outros agentes."
          }
        }
      }
    },
    "Sidefolk doesn't touch %@ — it's protected." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no toca %@: está protegido."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche pas à %@ — c’est protégé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non tocca %@: è protetto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 %@ 항목을 건드리지 않아요. 보호된 항목이에요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não mexe em %@ — é um item protegido."
          }
        }
      }
    },
    "Sidefolk doesn't touch hidden files or folders." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no toca archivos ni carpetas ocultos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche pas aux fichiers ni aux dossiers masqués."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non tocca file o cartelle nascosti."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 숨김 파일이나 폴더를 건드리지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não mexe em arquivos nem pastas ocultos."
          }
        }
      }
    },
    "Sidefolk doesn't work on the whole disk." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no trabaja sobre el disco entero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne travaille pas sur le disque entier."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non lavora sull'intero disco."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 디스크 전체를 대상으로 작업하지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não trabalha no disco inteiro."
          }
        }
      }
    },
    "Sidefolk is already running" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ya se está ejecutando"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk est déjà ouvert"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk è già in esecuzione"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 이미 실행 중임"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk já está aberto"
          }
        }
      }
    },
    "Sidefolk isn't running, so here's your reminder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk no se está ejecutando, así que aquí tienes tu recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’est pas ouvert, alors voici votre rappel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non è in esecuzione, quindi ecco il tuo promemoria."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 실행 중이 아니어서 여기로 미리 알림을 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk não está aberto, então aqui está seu lembrete."
          }
        }
      }
    },
    "Sidefolk keeps these in mind in every conversation." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas."
          }
        }
      }
    },
    "Sidefolk keeps these in mind in every conversation. Change or delete anything." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación. Cambia o elimina lo que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation. Modifiez ou supprimez ce que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione. Puoi modificare o eliminare qualsiasi cosa."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요. 무엇이든 변경하거나 삭제할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas. Altere ou apague o que quiser."
          }
        }
      }
    },
    "Sidefolk only touches files inside these folders. Anything it deletes goes to the Trash." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk solo toca archivos dentro de estas carpetas. Todo lo que elimina va a la Papelera."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne touche qu’aux fichiers de ces dossiers. Tout ce qu’il supprime va dans la Corbeille."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tocca solo i file dentro queste cartelle. Ciò che elimina finisce nel Cestino."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 이 폴더 안의 파일만 다뤄요. 삭제하는 것은 모두 휴지통으로 가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk só mexe em arquivos dentro destas pastas. Tudo o que ele apaga vai para a Lixeira."
          }
        }
      }
    },
    "Sidefolk only works inside your own home folder." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk solo trabaja dentro de tu carpeta de inicio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne travaille que dans votre propre dossier de départ."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk lavora solo dentro la tua cartella Inizio."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 사용자의 홈 폴더 안에서만 작업해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk só trabalha dentro da sua pasta de início."
          }
        }
      }
    },
    "Sidefolk saves a backup next to each file before changing it. Disconnect removes only what it added." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk guarda una copia de seguridad junto a cada archivo antes de cambiarlo. Desconectar quita solo lo que añadió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk enregistre une sauvegarde à côté de chaque fichier avant de le modifier. Déconnecter ne retire que ce qu’il a ajouté."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk salva un backup accanto a ogni file prima di modificarlo. Disconnetti rimuove solo ciò che ha aggiunto."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 각 파일을 변경하기 전에 옆에 백업을 저장해요. 연결 해제는 Sidefolk가 추가한 것만 제거해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk salva um backup ao lado de cada arquivo antes de alterá-lo. Desconectar remove só o que ele adicionou."
          }
        }
      }
    },
