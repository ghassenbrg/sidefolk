    "Asks once for each kind of action and remembers “Always allow”." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل مرة واحدة لكل نوع من الإجراءات ويتذكّر «السماح دائمًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt einmal pro Art von Aktion und merkt sich „Immer erlauben“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta una vez por cada tipo de acción y recuerda “Permitir siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande une fois pour chaque type d’action et retient « Toujours autoriser »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede una volta per ogni tipo di azione e ricorda “Consenti sempre”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "操作の種類ごとに一度だけ確認し、「常に許可」を記憶します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 종류마다 한 번씩 묻고, “항상 허용”을 기억해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
