    "Ask the user to cancel some first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide al usuario que cancele alguno primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez d’abord à l’utilisateur d’en annuler quelques-uns."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi all'utente di annullarne prima qualcuno."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "먼저 일부를 취소해 달라고 사용자에게 요청하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Peça à pessoa que cancele alguns primeiro."
          }
        }
      }
    },
    "Ask “what did I save about…” any time. Drop files or links on me, double-click me for your notebook, or find me in the menu bar." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta “what did I save about…” cuando quieras. Arrastra archivos o enlaces hasta mí, haz doble clic en mí para abrir tu cuaderno o búscame en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demandez « what did I save about… » à tout moment. Déposez des fichiers ou des liens sur moi, double-cliquez sur moi pour ouvrir votre carnet, ou retrouvez-moi dans la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiedi “what did I save about…” quando vuoi. Trascina file o link su di me, fai doppio clic su di me per aprire il taccuino, o trovami nella barra dei menu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "언제든 “what did I save about…”처럼 물어보세요. 파일이나 링크를 끌어다 놓거나, 두 번 클릭해서 수첩을 열거나, 메뉴 막대에서 찾을 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunte “what did I save about…” quando quiser. Solte arquivos ou links em mim, clique duas vezes em mim para abrir seu caderno, ou me encontre na barra de menus."
          }
        }
      }
    },
    "Ask, remind, note, watch…" : {
