    "Save it without a collection (it goes to the Inbox), or ask the user to create it in Sidefolk first." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "احفظه دون مجموعة (فيذهب إلى «الوارد»)، أو اطلب من المستخدم إنشاءها في Sidefolk أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Speichere sie ohne Sammlung (sie landet dann im Eingang), oder bitte die Person, die Sammlung zuerst in Sidefolk zu erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guárdala sin colección (va a la Bandeja de entrada) o pide al usuario que la cree antes en Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrez-la sans collection (elle ira dans la Boîte de réception), ou demandez d’abord à l’utilisateur de créer la collection dans Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Salvala senza raccolta (finisce nella raccolta In arrivo), o chiedi all'utente di crearla prima in Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コレクションを指定せずに保存する（インボックスに入ります）か、先にSidefolkで作成するようユーザーに頼んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모음 없이 저장하거나(수신함으로 가요), 먼저 Sidefolk에서 모음을 만들어 달라고 사용자에게 요청하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
