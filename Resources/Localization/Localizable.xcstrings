          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉你一次后就停止"
          }
        }
      }
    },
    "Sums, percentages, unit conversions and date maths worked out exactly, so an answer never rests on a guess." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عمليات حسابية ونسب مئوية وتحويل وحدات وحساب تواريخ بدقة، فلا يعتمد الجواب على التخمين أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rechnungen, Prozente, Einheiten und Datumsrechnung genau ausgerechnet, damit eine Antwort nie auf einer Schätzung beruht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuentas, porcentajes, conversiones de unidades y cálculos de fechas hechos con exactitud, para que una respuesta nunca dependa de una suposición."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calculs, pourcentages, conversions d’unités et calculs de dates faits exactement, pour qu’une réponse ne repose jamais sur une estimation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Conti, percentuali, conversioni di unità e calcoli di date fatti con esattezza, così una risposta non si basa mai su una stima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "計算、パーセント、単位の換算、日付の計算を正確に行うので、答えが推測に頼ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계산, 백분율, 단위 변환, 날짜 계산을 정확하게 해서 답이 짐작에 기대지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contas, porcentagens, conversões de unidades e cálculos de datas feitos com exatidão, para que uma resposta nunca dependa de um palpite."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精确完成计算、百分比、单位换算和日期计算，答案绝不靠猜。"
          }
        }
      }
    },
    "Sunrise, sunset and the moon" : {
