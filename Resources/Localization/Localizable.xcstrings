    "Your data from before the restore comes back, and what you did since the restore is set aside. Sidefolk restarts." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعود بياناتك من قبل الاستعادة، ويُحفظ ما فعلته بعدها جانبًا. سيُعاد تشغيل Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Daten von vor der Wiederherstellung kommen zurück, und was du seitdem getan hast, wird beiseitegelegt. Sidefolk startet neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vuelven tus datos de antes de la restauración, y lo que hiciste desde entonces se guarda aparte. Sidefolk se reinicia."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos données d’avant la restauration reviennent, et ce que vous avez fait depuis est mis de côté. Sidefolk redémarre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tornano i tuoi dati di prima del ripristino, e ciò che hai fatto da allora viene messo da parte. Sidefolk si riavvia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "復元前のデータが戻り、復元後に行ったことは取っておかれます。Sidefolkは再起動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "복원 전 데이터가 돌아오고, 그 뒤에 한 일은 따로 보관돼요. Sidefolk가 다시 시작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus dados de antes da restauração voltam, e o que você fez desde então fica guardado. O Sidefolk reinicia."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "恢复前的数据会回来，恢复后所做的会被放在一边。Sidefolk 将重新启动。"
          }
        }
      }
    },
