            "value" : "Sidefolk no pudo buscar actualizaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk n’a pas pu rechercher de mises à jour."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk non ha potuto controllare gli aggiornamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkがアップデートを確認できませんでした。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 업데이트를 확인하지 못했어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
