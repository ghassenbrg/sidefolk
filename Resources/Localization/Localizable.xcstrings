    },
    "Sidefolk keeps these in mind in every conversation." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع Sidefolk هذه في اعتباره في كل محادثة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk behält das in jedem Gespräch im Hinterkopf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkはどの会話でもこれらを覚えています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 在每次对话中都会记着这些。"
          }
        }
      }
    },
    "Sidefolk keeps these in mind in every conversation. Change or delete anything." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضع Sidefolk هذه في اعتباره في كل محادثة. يمكنك تغيير أي منها أو حذفه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk behält das in jedem Gespräch im Hinterkopf. Ändere oder lösche, was du willst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk los tiene en cuenta en cada conversación. Cambia o elimina lo que quieras."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk garde ces informations en tête dans chaque conversation. Modifiez ou supprimez ce que vous voulez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk tiene a mente queste cose in ogni conversazione. Puoi modificare o eliminare qualsiasi cosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkはどの会話でもこれらを覚えています。自由に変更・削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk는 모든 대화에서 이 내용을 기억하고 있어요. 무엇이든 변경하거나 삭제할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk leva isto em conta em todas as conversas. Altere ou apague o que quiser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 在每次对话中都会记着这些。你可以随意更改或删除。"
          }
        }
      }
    },
    "Sidefolk looks only when you choose Check Now, here or in the menu bar." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يبحث Sidefolk إلا عندما تختار «بحث الآن»، هنا أو في شريط القائمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk sucht nur, wenn du „Jetzt suchen“ wählst, hier oder in der Menüleiste."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk solo comprueba cuando eliges Comprobar ahora, aquí o en la barra de menús."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk ne vérifie que quand vous choisissez Vérifier maintenant, ici ou dans la barre des menus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk controlla solo quando scegli Controlla ora, qui o nella barra dei menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここかメニューバーで「今すぐ確認」を選んだときだけ確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기나 메뉴 막대에서 지금 확인을 선택할 때만 확인해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Sidefolk só busca quando você escolhe Buscar Agora, aqui ou na barra de menus."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅在你于此处或菜单栏中选择“立即检查”时才检查。"
          }
        }
      }
    },
    "Sidefolk makes a folder with a copy of Harbor and a short guide, then follows it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينشئ Sidefolk مجلدًا فيه نسخة من Harbor ودليل قصير، ثم يتابعه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk legt einen Ordner mit einer Kopie von Harbor und einer kurzen Anleitung an und folgt ihm dann."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
