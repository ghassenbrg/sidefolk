    "The time anywhere in the world, and a time converted between places, with daylight saving worked out exactly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الوقت في أي مكان في العالم، وتحويل الوقت بين الأماكن، مع حساب التوقيت الصيفي بدقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Uhrzeit an jedem Ort der Welt und Umrechnungen zwischen Orten, mit exakt berücksichtigter Sommerzeit."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La hora en cualquier lugar del mundo y una hora convertida entre lugares, con el horario de verano calculado con exactitud."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’heure partout dans le monde, et une heure convertie d’un lieu à un autre, avec les changements d’heure calculés avec exactitude."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'ora in qualsiasi parte del mondo e un orario convertito tra luoghi, con l'ora legale calcolata con precisione."
          }
