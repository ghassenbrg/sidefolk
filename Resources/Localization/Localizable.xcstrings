        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je continue d’essayer, un peu moins souvent à chaque fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Continuo a provare, un po' meno spesso ogni volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "間隔を少しずつ空けながら、引き続き試します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "계속 시도할게요. 시도할 때마다 간격을 조금씩 늘릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou continuar tentando, com um pouco menos de frequência a cada vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会继续尝试，每次间隔稍长一些。"
          }
        }
      }
    },
    "I'll sit down here and keep track of things for you: notes, reminders, and things to watch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سأبقى هنا وأتابع الأمور من أجلك: الملاحظات والتذكيرات وما يجب مراقبته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich setze mich hierhin und behalte die Dinge für dich im Blick: Notizen, Erinnerungen und alles, was beobachtet werden soll."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me quedo aquí para estar pendiente de tus cosas: notas, recordatorios y cosas que vigilar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je m’installe ici et je garde un œil sur tout pour vous : notes, rappels et choses à surveiller."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi siedo qui e tengo traccia delle cose per te: note, promemoria e cose da tenere d'occhio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ここに座って、メモやリマインダー、監視したいことを見ておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "여기 앉아서 메모, 미리 알림, 지켜볼 것들을 챙길게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vou ficar aqui acompanhando as coisas para você: notas, lembretes e o que monitorar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我就待在这里，帮你记着各种事情：笔记、提醒，还有要监视的东西。"
          }
        }
      }
    },
    "I'll tell you %@" : {
      "localizations" : {
        "ar" : {
