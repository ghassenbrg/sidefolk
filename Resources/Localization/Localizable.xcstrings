    "Asks once for each kind of action and remembers “Always allow”." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسأل مرة واحدة لكل نوع من الإجراءات ويتذكّر «السماح دائمًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fragt einmal pro Art von Aktion und merkt sich „Immer erlauben“."
