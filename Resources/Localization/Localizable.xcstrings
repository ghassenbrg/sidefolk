    },
    "Extensions Sidefolk wrote at your request. Nothing in a draft runs until you review it and install it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ملحقات كتبها Sidefolk بناءً على طلبك. لا يعمل أي شيء في المسودة حتى تراجعها وتثبّتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen, die Sidefolk auf deine Bitte geschrieben hat. Nichts in einem Entwurf läuft, bis du ihn geprüft und installiert hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extensiones que Sidefolk escribió a petición tuya. Nada de un borrador se ejecuta hasta que lo revisas y lo instalas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Des extensions que Sidefolk a écrites à votre demande. Rien dans un brouillon ne s’exécute avant que vous l’ayez examiné et installé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estensioni che Sidefolk ha scritto su tua richiesta. Niente in una bozza viene eseguito finché non la esamini e la installi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストに応じてSidefolkが書いた拡張機能です。下書きの内容は、確認してインストールするまで何も実行されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청에 따라 Sidefolk가 작성한 확장 프로그램이에요. 초안은 검토하고 설치하기 전까지 아무것도 실행되지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extensões que o Sidefolk escreveu a seu pedido. Nada em um rascunho roda até você revisar e instalar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 按你的要求编写的扩展。草稿中的任何内容都不会运行，直到你查看并安装它。"
          }
        }
      }
    },
    "Extensions aren't running." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الملحقات لا تعمل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen laufen nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones no se están ejecutando."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions ne sont pas lancées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni non sono in esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張機能が動作していません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램이 실행되고 있지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As extensões não estão em execução."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展没有在运行。"
          }
        }
      }
    },
    "Extensions run in a sandbox limited to what they asked for at install. MCP servers run with your full permissions." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعمل الملحقات في بيئة معزولة تقتصر على ما طلبته عند التثبيت. أما خوادم MCP فتعمل بكامل أذوناتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erweiterungen laufen in einer Sandbox, die auf das beschränkt ist, was sie bei der Installation angefragt haben. MCP-Server laufen mit all deinen Rechten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las extensiones se ejecutan en un entorno aislado limitado a lo que pidieron al instalarse. Los servidores MCP se ejecutan con todos tus permisos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les extensions s’exécutent dans un bac à sable limité à ce qu’elles ont demandé à l’installation. Les serveurs MCP s’exécutent avec toutes vos autorisations."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le estensioni vengono eseguite in una sandbox limitata a ciò che hanno chiesto all'installazione. I server MCP vengono eseguiti con tutti i tuoi permessi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拡張機能は、インストール時に求めた範囲に限られたサンドボックス内で動作します。MCPサーバは、ユーザーと同じすべての権限で動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확장 프로그램은 설치할 때 요청한 범위로 제한된 샌드박스에서 실행돼요. MCP 서버는 사용자의 모든 권한으로 실행돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As extensões rodam num sandbox limitado ao que pediram na instalação. Os servidores MCP rodam com todas as suas permissões."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "扩展在沙盒中运行，只能使用安装时申请的权限。MCP 服务器则拥有你的全部权限。"
          }
        }
      }
    },
