    "Only while a card waits beside the companion: ↩ answers, ⎋ puts it away, ↑↓ moves through the held ones." : {
      "comment" : "Settings › General: what the card shortcut does",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط عندما تنتظر بطاقة بجانب الرفيق: ↩ للرد، ⎋ لإبعادها، ↑↓ للتنقل بين البطاقات المنتظرة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur solange eine Karte neben dem Begleiter wartet: ↩ antwortet, ⎋ legt sie weg, ↑↓ geht durch die gehaltenen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo mientras una tarjeta espera junto al compañero: ↩ responde, ⎋ la guarda, ↑↓ recorre las que esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement quand une carte attend près du compagnon : ↩ répond, ⎋ la range, ↑↓ parcourt les cartes en attente."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo mentre una scheda aspetta accanto al compagno: ↩ risponde, ⎋ la mette da parte, ↑↓ scorre quelle in attesa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパニオンのそばでカードが待っているときだけ：↩ で答え、⎋ でしまい、↑↓ で保留中のカードを移動します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴패니언 옆에 카드가 기다릴 때만: ↩ 답하기, ⎋ 치우기, ↑↓ 보류 중인 카드 사이 이동."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só enquanto um cartão espera ao lado do companheiro: ↩ responde, ⎋ guarda, ↑↓ percorre os que esperam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当伙伴旁有卡片等待时：↩ 回复，⎋ 收起，↑↓ 在待处理的卡片间移动。"
          }
        }
      }
    },
    "Only you or Sidefolk itself can create skills." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنشاء المهارات مقصور عليك وعلى Sidefolk نفسه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
