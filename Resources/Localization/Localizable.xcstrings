    "Okay, no reminder." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسنًا، دون تذكير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Okay, keine Erinnerung."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De acuerdo, sin recordatorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D’accord, pas de rappel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Va bene, nessun promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "了解です。リマインダーは設定しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "알겠어요, 미리 알림은 설정하지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certo, sem lembrete."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "好的，不设提醒。"
          }
        }
      }
    },
    "On this Mac, with Apple's dictation model." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este Mac, con el modelo de dictado de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ce Mac, avec le modèle de dictée d’Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo Mac, con il modello di dettatura di Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上で、Appleの音声入力モデルを使います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Apple 받아쓰기 모델로 처리해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste Mac, com o modelo de ditado da Apple."
          }
        }
      }
    },
    "On this Mac, with Apple's speech model. Nothing you say leaves it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este Mac, con el modelo de voz de Apple. Nada de lo que dices sale de él."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur ce Mac, avec le modèle de reconnaissance vocale d’Apple. Rien de ce que vous dites ne quitte le Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su questo Mac, con il modello vocale di Apple. Ciò che dici non esce dal Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMac上で、Appleの音声認識モデルを使います。話した内容がMacの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서 Apple의 음성 인식 모델로 처리해요. 말한 내용은 Mac 밖으로 나가지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neste Mac, com o modelo de fala da Apple. Nada do que você diz sai dele."
          }
        }
      }
    },
    "One thing needs you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أمر واحد يحتاج إليك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Sache braucht dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cosa te necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Une chose vous attend."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una cosa ha bisogno di te."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "対応が必要なことが1件あります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "확인할 일이 하나 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uma coisa precisa de você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有一件事需要你。"
          }
        }
      }
    },
    "Only compact voices are installed, and they sound robotic. Download an enhanced or premium voice for a warmer one." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo hay voces compactas instaladas y suenan robóticas. Descarga una voz mejorada o premium para que suene más cálida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules des voix compactes sont installées, et elles sonnent de façon robotique. Téléchargez une voix améliorée ou premium pour un rendu plus chaleureux."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sono installate solo voci compatte, che suonano robotiche. Scarica una voce migliorata o premium per una più calda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コンパクトな音声しかインストールされておらず、機械的に聞こえます。拡張またはプレミアムの音声をダウンロードすると、より温かみのある声になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컴팩트 음성만 설치되어 있고, 로봇 같은 소리가 나요. 더 따뜻한 음성을 쓰려면 향상된 품질이나 프리미엄 음성을 다운로드하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só há vozes compactas instaladas, e elas soam robóticas. Baixe uma voz aprimorada ou premium para uma mais calorosa."
          }
        }
      }
    },
    "Only if it's installed somewhere unusual." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط إذا كان مثبّتًا في مكان غير معتاد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn es an einem ungewöhnlichen Ort installiert ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si está instalado en un lugar poco habitual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement s’il est installé à un endroit inhabituel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se è installato in un posto insolito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "通常とは異なる場所にインストールした場合のみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "특이한 위치에 설치한 경우에만 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se estiver instalado num lugar incomum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当它安装在不常见的位置时才需要。"
          }
        }
      }
    },
    "Only if the server needs one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فقط إذا كان الخادم يحتاج إليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur wenn der Server einen braucht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo si el servidor la necesita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement si le serveur en a besoin."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se il server ne richiede una."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバが必要とする場合のみ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버에서 키가 필요한 경우에만 입력하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se o servidor precisar de uma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "仅当服务器需要时才填写。"
          }
        }
      }
    },
    "Only notes already copied into the notebook can be removed from Apple Notes. Copy them first." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se pueden quitar de la app Notas las notas que ya se copiaron al cuaderno. Cópialas primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les notes déjà copiées dans le carnet peuvent être retirées de l’app Notes. Copiez-les d’abord."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dall'app Note si possono rimuovere solo le note già copiate nel taccuino. Copiale prima."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appleのメモから削除できるのは、すでにノートブックにコピーしたメモだけです。先にコピーしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "수첩에 이미 복사한 메모만 Apple 메모에서 제거할 수 있어요. 먼저 복사하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só é possível remover do app Notas as notas que já foram copiadas para o caderno. Copie-as primeiro."
          }
        }
      }
    },
    "Only urgent things will interrupt you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لن يقاطعك إلا ما هو عاجل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur Dringendes unterbricht dich."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo te interrumpirán las cosas urgentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seules les choses urgentes vous interrompront."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo le cose urgenti ti interromperanno."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "割り込むのは緊急のことだけです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "급한 일만 알려 드릴게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só coisas urgentes vão interromper você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有紧急的事会打扰你。"
          }
        }
      }
    },
    "Only when I spoke" : {
      "localizations" : {
