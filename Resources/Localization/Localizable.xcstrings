    "A photo's details, and copies of pictures converted to JPEG, PNG or HEIC, made smaller, or without their location. Your originals stay as they are." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تفاصيل صورة، ونسخ من الصور محوّلة إلى JPEG أو PNG أو HEIC، أو مصغّرة، أو بلا موقعها. تبقى ملفاتك الأصلية كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Details eines Fotos und Kopien von Bildern als JPEG, PNG oder HEIC, verkleinert oder ohne Ortsangabe. Deine Originale bleiben, wie sie sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los detalles de una foto, y copias de imágenes convertidas a JPEG, PNG o HEIC, más pequeñas o sin su ubicación. Tus originales se quedan como están."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les détails d’une photo, et des copies d’images converties en JPEG, PNG ou HEIC, réduites, ou sans leur position. Vos originaux restent tels quels."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I dettagli di una foto, e copie di immagini convertite in JPEG, PNG o HEIC, rimpicciolite o senza la posizione. I tuoi originali restano come sono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写真の詳細と、JPEG・PNG・HEICへの変換、縮小、位置情報を除いた画像のコピー。元のファイルはそのまま残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사진의 정보, 그리고 JPEG·PNG·HEIC로 변환하거나 작게 줄이거나 위치 정보를 뺀 사본. 원본은 그대로 남아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os detalhes de uma foto, e cópias de imagens convertidas para JPEG, PNG ou HEIC, menores ou sem a localização. Seus originais ficam como estão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "照片的信息，以及转换为 JPEG、PNG 或 HEIC、缩小尺寸或去掉位置信息的图片副本。原始文件保持不变。"
          }
        }
      }
    },
