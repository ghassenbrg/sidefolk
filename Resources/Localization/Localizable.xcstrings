    "Not watching anything. I can tell you when a page changes, a site goes down or a file arrives." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا أراقب شيئًا. يمكنني إخبارك عندما تتغيّر صفحة أو يتوقف موقع أو يصل ملف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich beobachte gerade nichts. Ich kann dir Bescheid sagen, wenn sich eine Seite ändert, eine Website ausfällt oder eine Datei ankommt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No estoy vigilando nada. Puedo avisarte cuando cambie una página, un sitio deje de responder o llegue un archivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune surveillance en cours. Je peux vous prévenir quand une page change, qu’un site tombe ou qu’un fichier arrive."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non sto tenendo d'occhio niente. Posso avvisarti quando una pagina cambia, un sito va offline o arriva un file."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も監視していません。ページの変更、サイトのダウン、ファイルの到着などをお知らせできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지켜보는 것이 없어요. 페이지가 바뀌거나, 사이트가 다운되거나, 파일이 도착하면 알려 드릴 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada sendo monitorado. Posso avisar quando uma página mudar, um site cair ou um arquivo chegar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目前没有监视任何东西。网页有变化、网站无法访问或文件到达时，我都可以告诉你。"
          }
        }
      }
    },
