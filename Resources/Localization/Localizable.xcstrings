    "At the time you chose. They may come quieter, never not at all." : {
      "comment" : "Settings › Attention › Reminders",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الوقت الذي اخترته. قد تأتي بهدوء أكبر، لكنها لا تُلغى أبدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zur gewählten Zeit. Sie können leiser kommen, aber nie gar nicht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A la hora que elegiste. Pueden llegar más discretos, nunca no llegar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À l’heure choisie. Ils peuvent arriver plus discrètement, jamais pas du tout."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "All’ora che hai scelto. Possono arrivare più discreti, mai non arrivare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選んだ時刻に届きます。控えめにはできますが、なしにはできません。"
