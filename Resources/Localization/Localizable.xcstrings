    "Cursor, VS Code, Zed or any app that speaks MCP: copy a setup snippet." : {
      "comment" : "Settings › Connections",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor أو VS Code أو Zed أو أي تطبيق يدعم MCP: انسخ مقتطف الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed oder jede App, die MCP spricht: ein Einrichtungs-Snippet kopieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed o cualquier app que hable MCP: copia un fragmento de configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed ou toute app qui parle MCP : copiez un extrait de configuration."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed o qualsiasi app che parla MCP: copia uno snippet di configurazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor、VS Code、Zed など MCP に対応したアプリ：設定用のスニペットをコピー。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed 등 MCP를 지원하는 앱: 설정 스니펫을 복사하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed ou qualquer app que fale MCP: copie um trecho de configuração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor、VS Code、Zed 或任何支持 MCP 的 App：复制一段设置代码。"
          }
        }
      }
    },
    "Cursor, VS Code, Zed or any app that speaks MCP: copy the command, a setup snippet for each, and where the Sidefolk skill is." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor أو VS Code أو Zed أو أي تطبيق يدعم MCP: انسخ الأمر، ومقتطف إعداد لكل منها، ومكان مهارة Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed oder jede App, die MCP versteht: Kopiere den Befehl, je ein Einrichtungs-Snippet und den Ort des Sidefolk-Skills."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed o cualquier app que hable MCP: copia el comando, un fragmento de configuración para cada una y dónde está la habilidad de Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed ou toute app compatible MCP : copiez la commande, un extrait de configuration pour chacune, et l’emplacement de la compétence Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed o qualsiasi app che parli MCP: copia il comando, uno snippet di configurazione per ciascuna e dove si trova l'abilità Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor、VS Code、Zed、またはMCPに対応したアプリ：コマンド、各アプリ向けの設定スニペット、Sidefolkスキルの場所をコピーできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed 등 MCP를 지원하는 모든 앱을 위해 명령, 앱별 설정 스니펫, Sidefolk 스킬의 위치를 복사할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor, VS Code, Zed ou qualquer app que fale MCP: copie o comando, um trecho de configuração para cada um e o local da habilidade do Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cursor、VS Code、Zed 或任何支持 MCP 的应用：拷贝命令、各应用的设置代码片段，以及 Sidefolk 技能所在的位置。"
          }
        }
      }
    },
