      }
    },
    "The microphone is on only while you hold the shortcut, and what you say is understood on this Mac. The recording is never kept; the words join your requests like typed ones." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يعمل الميكروفون إلا أثناء ضغطك مطوّلًا على الاختصار، ويُفهم ما تقوله على هذا الـ Mac. لا يُحفظ التسجيل أبدًا؛ وتنضم الكلمات إلى طلباتك مثل الطلبات المكتوبة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon ist nur an, solange du den Kurzbefehl hältst, und was du sagst, wird auf diesem Mac verstanden. Die Aufnahme wird nie aufbewahrt; der erkannte Text wird wie getippter Text zu deiner Anfrage."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono solo está activo mientras mantienes pulsado el atajo, y lo que dices se interpreta en este Mac. La grabación nunca se conserva; las palabras se suman a tus peticiones como si las hubieras escrito."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le microphone n’est actif que tant que vous maintenez le raccourci, et ce que vous dites est reconnu sur ce Mac. L’enregistrement n’est jamais conservé ; les mots rejoignent vos demandes comme s’ils étaient tapés."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono è acceso solo mentre tieni premuta l'abbreviazione, e ciò che dici viene compreso su questo Mac. La registrazione non viene mai conservata; le parole si uniscono alle tue richieste come quelle scritte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクはショートカットを押している間だけオンになり、話した内容はこのMac上で認識されます。録音は保存されません。認識された言葉は、入力した依頼と同じように扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크는 단축키를 누르고 있는 동안에만 켜지고, 말한 내용은 이 Mac에서 인식해요. 녹음은 저장되지 않으며, 인식된 글은 직접 입력한 요청과 똑같이 처리돼요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone só fica ligado enquanto você segura o atalho, e o que você diz é entendido neste Mac. A gravação nunca é guardada; as palavras entram nos seus pedidos como se fossem digitadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有按住快捷键时麦克风才会开启，你说的话在这台 Mac 上识别。录音不会被保存；识别出的文字会像输入的内容一样加入你的请求。"
          }
        }
      }
    },
    "The microphone is ready. Hold to talk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الميكروفون جاهز. اضغط مطوّلًا للتحدث."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon ist bereit. Halte den Kurzbefehl zum Sprechen gedrückt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono está listo. Mantén pulsado para hablar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le microphone est prêt. Maintenez le raccourci pour parler."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono è pronto. Tieni premuto per parlare."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マイクの準備ができました。押し続けて話してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "마이크가 준비됐어요. 길게 눌러 말하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone está pronto. Segure para falar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "麦克风已就绪。请按住说话。"
          }
        }
      }
    },
    "The microphone opens the moment you press it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يُفتح الميكروفون لحظة الضغط عليه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon öffnet sich, sobald du ihn drückst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono se abre en cuanto pulsas el atajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le microphone s’ouvre dès que vous appuyez sur le raccourci."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il microfono si apre nell'istante in cui premi l'abbreviazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "押した瞬間にマイクがオンになります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "누르는 순간 마이크가 켜져요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O microfone abre assim que você pressiona."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "一按下，麦克风就会打开。"
          }
        }
      }
    },
    "The microphone went away while you were talking. Nothing was sent." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطع الميكروفون أثناء حديثك. لم يُرسل شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Mikrofon ist ausgefallen, während du gesprochen hast. Es wurde nichts gesendet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El micrófono dejó de estar disponible mientras hablabas. No se ha enviado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
