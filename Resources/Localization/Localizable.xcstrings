        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk의 companions 폴더에 있는 데이터로 만든 컴패니언이에요. 위에서 고른 색상과 목도리를 착용해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
