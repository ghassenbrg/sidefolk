    "Always asks Codex for high reasoning effort; empty keeps the model above." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يطلب دائمًا من Codex جهد تفكير عاليًا؛ إن تُرك فارغًا فسيُستخدم النموذج أعلاه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fordert bei Codex immer hohen Denkaufwand an. Leer lassen, um beim Modell oben zu bleiben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pide siempre a Codex un esfuerzo de razonamiento alto; si se deja vacío, se mantiene el modelo de arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande toujours à Codex un effort de raisonnement élevé ; vide, garde celui du modèle ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede sempre a Codex un ragionamento approfondito; se vuoto, resta il modello sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Codexに常に高い推論レベルを指定します。空欄の場合は上のモデルのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "항상 Codex에 높은 추론 수준을 요청해요. 비워 두면 위의 모델을 그대로 써요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sempre pede ao Codex um esforço de raciocínio alto; vazio mantém o modelo acima."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "始终让 Codex 使用高推理强度；留空则沿用上面的模型。"
          }
        }
      }
    },
    "An AI voice. %@ says one short line, and never reads out links, file paths or code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una voz de IA. %@ dice una frase corta y nunca lee en voz alta enlaces, rutas de archivos ni código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
