        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "위의 항목으로 제한된 샌드박스에서 실행돼요. 언제든 끄거나 설치 제거할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
