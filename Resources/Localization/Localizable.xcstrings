    "Its folder goes to the Trash, where you can put it back." : {
      "comment" : "Moving a companion made from data to the Trash",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ينتقل مجلده إلى سلة المهملات، ويمكنك إعادته من هناك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sein Ordner kommt in den Papierkorb, wo du ihn zurücklegen kannst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Su carpeta va a la Papelera, desde donde puedes recuperarla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son dossier va dans la Corbeille, d'où vous pouvez le remettre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La sua cartella va nel Cestino, da dove puoi ripristinarla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダはゴミ箱に入り、そこから戻せます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더는 휴지통으로 가고, 거기서 되돌릴 수 있어요."
