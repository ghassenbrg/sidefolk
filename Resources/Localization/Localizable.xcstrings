    "No API key needed. The command's own tools are switched off: it can only act through Sidefolk's." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا حاجة إلى مفتاح API. أدوات الأمر نفسه معطّلة: لا يمكنه التصرف إلا عبر أدوات Sidefolk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kein API-Schlüssel nötig. Die eigenen Werkzeuge des Befehls sind ausgeschaltet: Er kann nur über die von Sidefolk handeln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No hace falta clave de API. Las herramientas propias del comando están desactivadas: solo puede actuar a través de las de Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune clé API nécessaire. Les outils propres à la commande sont désactivés : elle ne peut agir que par ceux de Sidefolk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non serve una chiave API. Gli strumenti propri del comando sono disattivati: può agire solo tramite quelli di Sidefolk."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "APIキーは不要です。コマンド自体のツールはオフになり、Sidefolkのツールを通してのみ操作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "API 키가 필요 없어요. 명령 자체의 도구는 꺼져 있어서 Sidefolk의 도구로만 동작해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não precisa de chave de API. As ferramentas próprias do comando ficam desligadas: ele só age pelas do Sidefolk."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不需要 API 密钥。该命令自带的工具会被关闭：它只能通过 Sidefolk 的工具行事。"
          }
        }
      }
    },
