          "stringUnit" : {
            "state" : "translated",
            "value" : "Ti avviso se si avvia e poi si chiude."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "起動したあと終了したらお知らせします。"
          }
