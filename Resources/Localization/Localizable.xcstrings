    "More moments, more often, and eyes that follow the pointer across the screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لحظات أكثر وبتكرار أكبر، وعينان تتبعان المؤشر عبر الشاشة كلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mehr Momente, öfter, und Augen, die dem Zeiger über den ganzen Bildschirm folgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más momentos, más a menudo, y ojos que siguen al puntero por toda la pantalla."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus de moments, plus souvent, et des yeux qui suivent le pointeur sur tout l’écran."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Più momenti, più spesso, e occhi che seguono il puntatore su tutto lo schermo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "動きがもっと多く、もっと頻繁に。目が画面じゅうのポインタを追います。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "더 많은 움직임을 더 자주 보여 주고, 눈이 화면 전체에서 포인터를 따라가요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais momentos, com mais frequência, e olhos que seguem o ponteiro pela tela toda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多小动作、更频繁，眼睛会在整个屏幕上跟随指针。"
          }
        }
      }
    },
