    "%lld extensions, %lld tool servers and %lld skills. Each runs only with what its passport says." : {
      "comment" : "Settings › Add-ons: under the title",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$lld ملحقات و%2$lld خوادم أدوات و%3$lld مهارات. كلٌّ منها يعمل فقط بما يسمح به جوازه."
          }
