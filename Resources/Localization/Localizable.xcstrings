          "stringUnit" : {
            "state" : "translated",
            "value" : "Tempo compare quando mancano meno di 15 minuti a un promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リマインダーまで15分を切ると、Tempoが現れます。"
