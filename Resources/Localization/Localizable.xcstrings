    "It can read %@ and use the internet, so it could upload those files." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede leer %@ y usar internet, así que podría subir esos archivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle peut lire %@ et utiliser Internet : elle pourrait donc envoyer ces fichiers en ligne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può leggere %@ e usare internet, quindi potrebbe caricare online quei file."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 폴더를 읽고 인터넷을 사용할 수 있어서 그 파일들을 업로드할 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode ler %@ e usar a internet, então poderia enviar esses arquivos."
          }
        }
      }
    },
    "It can run %@, which can run any code its sandbox allows." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede ejecutar %@, que puede ejecutar cualquier código que su entorno aislado permita."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle peut exécuter %@, qui peut lancer n’importe quel code autorisé par son bac à sable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può eseguire %@, che può eseguire qualsiasi codice consentito dalla sua sandbox."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 실행 파일을 실행할 수 있어서 샌드박스가 허용하는 코드는 무엇이든 실행할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode executar %@, que pode executar qualquer código que o sandbox permitir."
          }
        }
      }
    },
    "It can save what it downloads into %@." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede guardar lo que descargue en %@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle peut enregistrer ce qu’elle télécharge dans %@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può salvare ciò che scarica in %@."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 것을 %@ 폴더에 저장할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode salvar o que baixar em %@."
          }
        }
      }
    },
    "It can use the internet and run %@, so it could download and run other code." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede usar internet y ejecutar %@, así que podría descargar y ejecutar otro código."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle peut utiliser Internet et exécuter %@ : elle pourrait donc télécharger et exécuter du code supplémentaire."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Può usare internet ed eseguire %@, quindi potrebbe scaricare ed eseguire altro codice."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인터넷을 사용하고 %@ 실행 파일을 실행할 수 있어서 다른 코드를 내려받아 실행할 수도 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pode usar a internet e executar %@, então poderia baixar e executar outro código."
          }
        }
      }
    },
    "It downloads the latest %@ every time it starts. Pin a version, like %@==1.2.3." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It downloads the latest %1$@ every time it starts. Pin a version, like %2$@==1.2.3."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Descarga la versión más reciente de %1$@ cada vez que se inicia. Fija una versión, como %2$@==1.2.3."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À chaque démarrage, la dernière version de %1$@ est téléchargée. Fixez une version, par exemple %2$@==1.2.3."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scarica la versione più recente di %1$@ a ogni avvio. Fissa una versione, come %2$@==1.2.3."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "시작할 때마다 %1$@ 최신 버전을 내려받아요. %2$@==1.2.3처럼 버전을 고정하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Baixa a versão mais recente de %1$@ sempre que inicia. Fixe uma versão, como %2$@==1.2.3."
          }
        }
      }
    },
    "It downloads the latest %@ every time it starts. Pin a version, like %@@1.2.3." : {
