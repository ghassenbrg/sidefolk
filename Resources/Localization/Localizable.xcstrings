    "Nothing running. Connect Claude Code or Codex to see their sessions here, or start a command with “sidefolk run -- npm test”." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا شيء قيد التشغيل. اربط Claude Code أو Codex لترى جلساتهما هنا، أو ابدأ أمرًا باستخدام «sidefolk run -- npm test»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
