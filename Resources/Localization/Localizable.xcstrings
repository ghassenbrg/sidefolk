    "You asked %@ %@." : {
      "comment" : "A day like “Nov 12”, then a time",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بطلب منك يوم %1$@ الساعة %2$@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du hast am %1$@ um %2$@ gefragt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You asked %1$@ %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo pediste el %1$@ a las %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous l’avez demandé le %1$@ à %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me l'hai chiesto il %1$@ alle %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@の依頼です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@에 요청했어요."
          }
