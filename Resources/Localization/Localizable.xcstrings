    "Asks every time something would change outside Sidefolk, even if you allowed it before." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta cada vez que algo fuera de Sidefolk vaya a cambiar, aunque lo hayas permitido antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande à chaque fois que quelque chose changerait hors de Sidefolk, même si vous l’avez déjà autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede ogni volta che qualcosa cambierebbe fuori da Sidefolk, anche se l'avevi già consentito."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이전에 허용했더라도 Sidefolk 밖의 무언가가 바뀔 때마다 물어봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pergunta toda vez que algo for mudar fora do Sidefolk, mesmo que você já tenha permitido antes."
          }
        }
      }
    },
    "Asks once for each kind of action and remembers “Always allow”." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pregunta una vez por cada tipo de acción y recuerda “Permitir siempre”."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Demande une fois pour chaque type d’action et retient « Toujours autoriser »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiede una volta per ogni tipo di azione e ricorda “Consenti sempre”."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "동작 종류마다 한 번씩 묻고, “항상 허용”을 기억해요."
