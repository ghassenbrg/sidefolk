    "My answer got cut off before I could finish. Try asking for less at once." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقطعت إجابتي قبل أن أُنهيها. جرّب أن تطلب أقل دفعة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Meine Antwort wurde abgeschnitten, bevor ich fertig war. Bitte um weniger auf einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mi respuesta se cortó antes de que pudiera terminar. Prueba a pedir menos cosas a la vez."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ma réponse a été coupée avant la fin. Essayez de demander moins de choses à la fois."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La mia risposta è stata interrotta prima che potessi finire. Prova a chiedere meno cose alla volta."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "答えが途中で切れてしまいました。一度に頼む内容を減らしてみてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "답을 마치기 전에 잘렸어요. 한 번에 더 적게 요청해 보세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minha resposta foi cortada antes de eu terminar. Tente pedir menos coisas de uma vez."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我的回答还没说完就被截断了。试试一次少问一些。"
          }
        }
      }
    },
