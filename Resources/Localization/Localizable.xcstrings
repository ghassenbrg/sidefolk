    "Claude Code and Codex aren't part of it: connect them again on the other Mac." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code وCodex ليسا جزءًا منها: صِلهما من جديد على جهاز Mac الآخر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code und Codex gehören nicht dazu: Verbinde sie auf dem anderen Mac neu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code y Codex no van incluidos: vuelve a conectarlos en el otro Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code et Codex n’en font pas partie : connectez-les à nouveau sur l’autre Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code e Codex non ne fanno parte: ricollegali sull’altro Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude CodeとCodexは含まれません。もう一方のMacで接続し直してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Claude Code와 Codex는 포함되지 않아요. 다른 Mac에서 다시 연결하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
