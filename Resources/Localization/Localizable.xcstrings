        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "입력한 요청은 AI 없이는 영어로만 이해하고, AI가 있으면 모든 언어로 이해해요."
          }
        },
        "pt-BR" : {
