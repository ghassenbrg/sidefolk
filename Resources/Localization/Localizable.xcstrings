    "Tell me things like “I prefer short answers” and I'll keep them here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرني بأشياء مثل «أفضّل الإجابات القصيرة» وسأحتفظ بها هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir Dinge wie „Ich bevorzuge kurze Antworten“, und ich bewahre sie hier auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dime cosas como “prefiero las respuestas cortas” y las guardaré aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-moi des choses comme « je préfère les réponses courtes » et je les garderai ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmi cose come “preferisco risposte brevi” e le terrò qui."
          }
        },
