    "No skills yet. Ask “write a skill for my weekly review” and approve it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا مهارات بعد. اطلب «write a skill for my weekly review» ثم وافق عليها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch keine Skills. Frag „write a skill for my weekly review“ und stimme zu."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no hay habilidades. Pide “escribe una habilidad para mi revisión semanal” y apruébala."
          }
