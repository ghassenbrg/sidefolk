    },
    "Only what can't wait: reminders come as silent notifications; whispers wait." : {
      "comment" : "Settings › Attention › Quiet",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ما لا يحتمل الانتظار فقط: تصل التذكيرات كإشعارات صامتة؛ وتنتظر الهمسات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nur was nicht warten kann: Erinnerungen kommen als stille Mitteilungen; leise Hinweise warten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo lo que no puede esperar: los recordatorios llegan como notificaciones silenciosas; los susurros esperan."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seulement l'urgent : les rappels arrivent en notifications silencieuses ; les murmures attendent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo ciò che non può aspettare: i promemoria arrivano come notifiche silenziose; i sussurri aspettano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "待てないものだけ：リマインダーは音なしの通知で届き、ささやきは待ちます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "기다릴 수 없는 것만: 리마인더는 무음 알림으로 오고, 속삭임은 기다려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só o que não pode esperar: lembretes chegam como notificações silenciosas; os sussurros esperam."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只有不能等的：提醒以静音通知送达；轻声提示会等待。"
          }
        }
      }
    },
