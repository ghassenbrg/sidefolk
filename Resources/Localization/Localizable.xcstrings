    "At %@, today's reminders, open tasks and watches in one bubble." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في الساعة %@، تذكيرات اليوم والمهام المفتوحة والمراقبات في فقاعة واحدة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um %@ die Erinnerungen, offenen Aufgaben und Beobachtungen des Tages in einer Sprechblase."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A las %@, los recordatorios de hoy, las tareas pendientes y las vigilancias en una sola burbuja."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "À %@, les rappels du jour, les tâches à faire et les surveillances dans une seule bulle."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alle %@, i promemoria di oggi, le attività aperte e le sentinelle in un solo fumetto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@に、今日のリマインダー、未完了のタスク、監視をひとつの吹き出しでお知らせします。"
          }
