    "A short spoken answer to what you said aloud. Typed requests get text." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ردّ منطوق قصير على ما قلته بصوت مسموع. أما الطلبات المكتوبة فتحصل على ردّ نصي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine kurze gesprochene Antwort auf das, was du laut gesagt hast. Getippte Anfragen bekommen Text."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una respuesta hablada y breve a lo que dices en voz alta. Las peticiones escritas reciben texto."
