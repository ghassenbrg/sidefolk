    "I stopped: you didn't answer in time. Nothing was changed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "توقفت: لم تُجب في الوقت المناسب. لم يتغيّر شيء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich habe gestoppt: Du hast nicht rechtzeitig geantwortet. Es wurde nichts geändert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me detuve: no respondiste a tiempo. No se ha cambiado nada."
          }
        },
        "fr" : {
          "stringUnit" : {
