    "Check that Sidefolk has access to that folder in System Settings › Privacy & Security › Files and Folders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحقّق من أن Sidefolk لديه حق الوصول إلى هذا المجلد في إعدادات النظام › الخصوصية والأمن › الملفات والمجلدات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Prüfe in Systemeinstellungen › Datenschutz & Sicherheit › Dateien und Ordner, ob Sidefolk Zugriff auf diesen Ordner hat."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que Sidefolk tenga acceso a esa carpeta en Ajustes del Sistema › Privacidad y seguridad › Archivos y carpetas."
