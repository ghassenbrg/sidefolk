    "Pick another model in Settings › AI, or leave it empty for Codex's default." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نموذجًا آخر في الإعدادات › الذكاء الاصطناعي، أو اتركه فارغًا لاستخدام الافتراضي في Codex."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wähle in Einstellungen › KI ein anderes Modell oder lass das Feld leer für den Standard von Codex."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige otro modelo en Ajustes › IA, o déjalo vacío para usar el predeterminado de Codex."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un autre modèle dans Réglages › IA, ou laissez vide pour la valeur par défaut de Codex."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
