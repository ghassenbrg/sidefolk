        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se detuvo de forma inesperada demasiadas veces (%1$lld× en %2$lld min), así que Sidefolk la desactivó."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elle s’est arrêtée trop souvent de façon inattendue (%1$lld fois en %2$lld min), Sidefolk l’a donc désactivée."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si è fermata in modo imprevisto troppe volte (%1$lld× in %2$lld min), quindi Sidefolk l'ha disattivata."
