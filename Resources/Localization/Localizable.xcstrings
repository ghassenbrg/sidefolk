            "value" : "Personne n’a répondu avant %@, la tâche a donc continué sans cette étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto entro %@, quindi l'operazione è proseguita senza questo passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までに答えがなかったため、タスクはそのステップなしで続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 아무도 답하지 않아서 그 단계 없이 작업이 이어졌어요."
