    "While quiet, reminders still fire, but only important ones interrupt you." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في وضع الهدوء تستمر التذكيرات، لكن المهمة منها فقط تقاطعك."
          }
        },
