        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다운로드한 것을 %@ 폴더에 저장할 수 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
