            "value" : "Was du die KI gefragt hast – zum Nachlesen oder Nachfragen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo que le pediste a la IA, para volver a leerlo o continuar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce que vous avez demandé à l’IA, pour le relire ou enchaîner."
