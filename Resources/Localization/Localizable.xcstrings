    "Your companion stays yours unless you switch." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبقى رفيقك كما هو ما لم تبدّله."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dein Begleiter bleibt deiner, außer du wechselst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu compañero sigue siendo el tuyo, salvo que lo cambies."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre compagnon reste le vôtre, sauf si vous en changez."
