    "“%@” points at this computer or your local network, so I won't fetch it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” apunta a este Mac o a tu red local, así que no lo descargaré."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » pointe vers cet ordinateur ou votre réseau local, je ne vais donc pas le récupérer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” punta a questo computer o alla tua rete locale, quindi non lo carico."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 주소는 이 컴퓨터나 로컬 네트워크를 가리켜서 가져오지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aponta para este computador ou para sua rede local, então não vou buscar."
          }
        }
      }
    },
    "“%@” points at this computer or your local network. Ask me directly to watch it — I only watch local addresses when you ask." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” apunta a este Mac o a tu red local. Pídeme directamente que lo vigile: solo vigilo direcciones locales cuando tú me lo pides."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« %@ » pointe vers cet ordinateur ou votre réseau local. Demandez-moi directement de le surveiller — je ne surveille les adresses locales que si vous le demandez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” punta a questo computer o alla tua rete locale. Chiedimi direttamente di tenerlo d'occhio: tengo d'occhio gli indirizzi locali solo quando me lo chiedi tu."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” 주소는 이 컴퓨터나 로컬 네트워크를 가리켜요. 지켜보려면 저에게 직접 요청하세요. 로컬 주소는 직접 요청할 때만 지켜봐요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“%@” aponta para este computador ou para sua rede local. Peça diretamente para eu monitorar — só monitoro endereços locais quando você pede."
          }
        }
      }
    },
