          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria, osservazioni, comandi, Claude Code, Codex, altre app, estensioni e il compagno: una scheda, un sussurro, solo in Oggi o disattivato."
          }
        },
        "ja" : {
