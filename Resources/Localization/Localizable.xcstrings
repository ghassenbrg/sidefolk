        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "elevenlabs.io에서 글자 수를 추가하거나, 설정 › 음성에서 Apple 음성을 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
