    },
    "%@ keeps %lld things in mind about you. They shape its answers, and never leave this Mac unless an answer needs the AI." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ %1$@ بـ%2$lld من المعلومات عنك. تشكّل إجاباته، ولا تغادر هذا الـMac إلا إذا احتاجت إجابة إلى الذكاء الاصطناعي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ behält %2$lld Dinge über dich im Kopf. Sie prägen die Antworten und verlassen diesen Mac nie, außer eine Antwort braucht die KI."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene presentes %2$lld cosas sobre ti. Dan forma a sus respuestas y nunca salen de este Mac salvo que una respuesta necesite la IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ garde %2$lld choses en tête à votre sujet. Elles guident ses réponses et ne quittent jamais ce Mac, sauf si une réponse a besoin de l’IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ tiene a mente %2$lld cose su di te. Orientano le sue risposte e non lasciano mai questo Mac, a meno che una risposta non richieda l’IA."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@はあなたについて%2$lld件のことを覚えています。回答に活かされ、AIが必要な回答以外でこのMacの外に出ることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@이(가) 당신에 대해 %2$lld가지를 기억하고 있어요. 답변에 반영되며, AI가 필요한 답변이 아니면 이 Mac 밖으로 나가지 않아요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ guarda %2$lld coisas sobre você. Elas orientam as respostas e nunca saem deste Mac, a menos que uma resposta precise da IA."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 记着关于你的 %2$lld 件事。它们会影响回答，除非回答需要 AI，否则绝不会离开这台 Mac。"
          }
        }
      }
    },
    "%@ keeps nothing in mind about you yet." : {
