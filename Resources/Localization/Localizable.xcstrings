    "This Mac can't listen in this language. Pick another one." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يستطيع هذا الـ Mac الإصغاء إلى هذه اللغة. اختر لغة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieser Mac kann in dieser Sprache nicht zuhören. Wähle eine andere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Mac no puede escuchar en este idioma. Elige otro."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce Mac ne peut pas écouter dans cette langue. Choisissez-en une autre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo Mac non può ascoltare in questa lingua. Scegline un'altra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このMacでは、この言語を聞き取れません。別の言語を選んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 Mac에서는 이 언어로 들을 수 없어요. 다른 언어를 선택하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
