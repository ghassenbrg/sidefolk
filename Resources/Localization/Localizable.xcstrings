    },
    "Everything Sidefolk did, who asked, and what was allowed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما فعله Sidefolk، ومن طلبه، وما سُمح به."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Sidefolk getan hat, wer es angefragt hat und was erlaubt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hizo Sidefolk, quién lo pidió y qué se permitió."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que Sidefolk a fait, qui l’a demandé et ce qui a été autorisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che Sidefolk ha fatto, chi l'ha chiesto e cosa è stato consentito."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが行ったすべての操作、依頼者、許可された内容。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk가 한 모든 일과 누가 요청했는지, 무엇이 허용됐는지."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que o Sidefolk fez, quem pediu e o que foi permitido."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolk 做过的每件事、由谁发起，以及哪些获得了允许。"
          }
        }
      }
    },
    "Everything Sidefolk does, and who asked for it, shows up here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل ما يفعله Sidefolk، ومن طلبه، يظهر هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alles, was Sidefolk tut, und wer darum gebeten hat, erscheint hier."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que hace Sidefolk, y quién se lo pide, aparece aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce que fait Sidefolk, et qui l’a demandé, s’affiche ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto ciò che Sidefolk fa, e chi l'ha chiesto, compare qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sidefolkが行うすべての操作と、その依頼者がここに表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
