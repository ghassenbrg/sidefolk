    "MCP server" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor MCP"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Serveur MCP"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server MCP"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서버"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Servidor MCP"
          }
        }
      }
    },
    "MCP servers run outside Sidefolk's sandbox, with your full permissions and the folders you shared with Sidefolk. Only add servers you trust. Their tools ask before changing anything, and what they return is treated as untrusted." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los servidores MCP se ejecutan fuera del entorno aislado de Sidefolk, con todos tus permisos y con las carpetas que compartiste con Sidefolk. Añade solo servidores de confianza. Sus herramientas preguntan antes de cambiar nada, y lo que devuelven se trata como no fiable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les serveurs MCP s’exécutent hors du bac à sable de Sidefolk, avec toutes vos autorisations et les dossiers que vous avez partagés avec Sidefolk. N’ajoutez que des serveurs de confiance. Leurs outils demandent avant de modifier quoi que ce soit, et ce qu’ils renvoient est traité comme non fiable."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I server MCP vengono eseguiti fuori dalla sandbox di Sidefolk, con tutti i tuoi permessi e le cartelle che hai condiviso con Sidefolk. Aggiungi solo server di cui ti fidi. I loro strumenti chiedono prima di modificare qualcosa, e ciò che restituiscono è considerato non attendibile."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "MCP 서버는 Sidefolk의 샌드박스 밖에서 사용자의 모든 권한과 Sidefolk에 공유한 폴더 접근 권한으로 실행돼요. 신뢰하는 서버만 추가하세요. 서버의 도구는 무언가를 변경하기 전에 물어보고, 서버가 돌려준 내용은 신뢰할 수 없는 것으로 취급해요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os servidores MCP rodam fora do sandbox do Sidefolk, com todas as suas permissões e as pastas que você compartilhou com o Sidefolk. Só adicione servidores em que você confia. As ferramentas deles pedem permissão antes de alterar qualquer coisa, e o que elas devolvem é tratado como não confiável."
          }
        }
      }
    },
    "Make sure %@ is running, and check the address in Settings › AI." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Asegúrate de que %@ se está ejecutando y comprueba la dirección en Ajustes › IA."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assurez-vous que %@ est lancé, et vérifiez l’adresse dans Réglages › IA."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che %@ sia in esecuzione e controlla l'indirizzo in Impostazioni › IA."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ 앱이 실행 중인지 확인하고, 설정 › AI에서 주소를 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Confira se %@ está em execução e verifique o endereço em Ajustes › IA."
          }
        }
      }
    },
    "Many providers' models behind one key." : {
      "localizations" : {
