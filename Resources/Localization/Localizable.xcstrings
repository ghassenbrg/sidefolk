    "Tell me things like “I prefer short answers” and I'll keep them here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أخبرني بأشياء مثل «I prefer short answers» وسأحتفظ بها هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sag mir Dinge wie „I prefer short answers“, und ich bewahre sie hier auf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dime cosas como “prefiero las respuestas cortas” y las guardaré aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites-moi des choses comme « je préfère les réponses courtes » et je les garderai ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dimmi cose come “preferisco risposte brevi” e le terrò qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「短い答えが好き」のようなことを教えてもらえれば、ここに残しておきます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“짧은 답변이 좋아요” 같은 내용을 알려 주시면 여기에 보관할게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga coisas como “prefiro respostas curtas” e eu guardo aqui."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "告诉我像“I prefer short answers”这样的事，我会记在这里。"
          }
        }
      }
    },
    "Tell me what to look for on the page, or to watch for any change." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
