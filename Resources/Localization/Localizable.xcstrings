    "Moves only when something happens, then rests. The lightest on battery." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتحرك إلا عند حدوث شيء، ثم يرتاح. الأخف على البطارية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bewegt sich nur, wenn etwas passiert, und ruht dann. Am sparsamsten für den Akku."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Solo se mueve cuando pasa algo y luego descansa. Lo más ligero para la batería."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ne bouge que lorsqu’il se passe quelque chose, puis se repose. Le plus léger pour la batterie."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si muove solo quando succede qualcosa, poi riposa. Il più leggero per la batteria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何かあったときだけ動き、そのあとは休みます。バッテリーへの負担がいちばん少ない設定です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "무슨 일이 있을 때만 움직이고 그다음엔 쉬어요. 배터리 부담이 가장 적어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Só se move quando algo acontece e depois descansa. O mais leve para a bateria."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "只在有事发生时才动，之后就休息。最省电。"
          }
        }
      }
    },
