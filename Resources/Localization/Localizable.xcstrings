          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ich sage dir Bescheid, wenn es startet und dann beendet wird."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Te avisaré si se inicia y luego se cierra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je vous préviendrai si le programme démarre puis se ferme."
          }
