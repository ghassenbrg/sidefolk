    "I only heard silence from %@. Check it's the microphone you're talking into, in System Settings › Sound." : {
      "comment" : "A microphone's name, like “MacBook Pro Microphone”",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم أسمع من %@ سوى الصمت. تحقّق في إعدادات النظام › الصوت من أنه الميكروفون الذي تتحدث فيه."
          }
        },
        "de" : {
          "stringUnit" : {
