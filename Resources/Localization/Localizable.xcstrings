        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiunge hook a ~/.claude/settings.json, così mi accorgo quando una sessione ha bisogno di te o finisce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.claude/settings.jsonにフックを追加し、セッションで対応が必要になったときや終了したときに気づけるようにします。"
