    "Each one shows what will happen before it does." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض كل منها ما سيحدث قبل حدوثه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jeder zeigt, was passieren wird, bevor es passiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada uno muestra lo que pasará antes de que pase."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chacun montre ce qui va se passer avant que ça se passe."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ognuno mostra cosa succederà prima che succeda."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "どれも、実行する前に何が起こるかを表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실행하기 전에 무슨 일이 일어날지 먼저 보여 줘요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada um mostra o que vai acontecer antes de acontecer."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每一项都会先告诉你将发生什么。"
          }
        }
      }
    },
    "Each result is the real setting. Change it here, or open its tab to see the rest." : {
      "comment" : "Settings search: under the title",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كل نتيجة هي الإعداد الحقيقي. غيّره هنا، أو افتح تبويبه لرؤية الباقي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Ergebnis ist die echte Einstellung. Ändere sie hier oder öffne ihren Bereich für den Rest."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
