    "Every %@ is the fastest for this; I'll check every %@." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Every %1$@ is the fastest for this; I'll check every %2$@."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada %1$@ es lo más rápido posible para esto; comprobaré cada %2$@."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toutes les %1$@, c’est le plus rapide possible ici ; je vérifierai toutes les %2$@."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni %1$@ è l'intervallo più breve possibile per questo; controllerò ogni %2$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この表示では%1$@ごとが最短です。%2$@ごとに確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@마다 확인하는 것이 이 항목에서 가장 빠른 주기예요. %2$@마다 확인할게요."
