    "Nobody answered by %@, so the task stopped here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió (%@), así que la tarea se detuvo aquí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a répondu avant %@, la tâche s’est donc arrêtée ici."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto entro %@, quindi l'operazione si è fermata qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までに答えがなかったため、タスクはここで停止しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 아무도 답하지 않아서 작업이 여기서 멈췄어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém respondeu até %@, então a tarefa parou aqui."
          }
        }
      }
    },
    "Nobody answered by %@, so the task went on without it." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nadie respondió (%@), así que la tarea siguió sin ese paso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Personne n’a répondu avant %@, la tâche a donc continué sans cette étape."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno ha risposto entro %@, quindi l'operazione è proseguita senza questo passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@までに答えがなかったため、タスクはそのステップなしで続行しました。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@까지 아무도 답하지 않아서 그 단계 없이 작업이 이어졌어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ninguém respondeu até %@, então a tarefa seguiu sem esse passo."
          }
        }
      }
    },
    "Not allowed yet. Without them, reminders only appear on the desktop." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "غير مسموح بعد. من دونها لا تظهر التذكيرات إلا على سطح المكتب."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Noch nicht erlaubt. Ohne sie erscheinen Erinnerungen nur auf dem Schreibtisch."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no están permitidas. Sin ellas, los recordatorios solo aparecen en el escritorio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pas encore autorisées. Sans elles, les rappels n’apparaissent que sur le bureau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non ancora consentite. Senza notifiche, i promemoria compaiono solo sulla scrivania."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ許可されていません。許可しないと、リマインダーはデスクトップにだけ表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 허용되지 않았어요. 허용하지 않으면 미리 알림이 데스크탑에만 나타나요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ainda não permitidas. Sem elas, os lembretes só aparecem na mesa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "尚未允许。没有通知的话，提醒只会出现在桌面上。"
          }
        }
      }
    },
    "Not allowed. Voice input can't hear you until it is." : {
