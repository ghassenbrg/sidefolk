            "state" : "translated",
            "value" : "Sidefolk 不会动隐藏的文件或文件夹。"
          }
        }
      }
    },
    "Sidefolk doesn't work on the whole disk." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
