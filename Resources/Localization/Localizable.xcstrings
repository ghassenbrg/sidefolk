    "Add characters on elevenlabs.io, or choose Apple's voice in Settings › Voice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف أحرفًا على elevenlabs.io، أو اختر صوت Apple في الإعدادات › الصوت."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hol dir auf elevenlabs.io mehr Zeichen oder wähle in Einstellungen › Stimme eine Apple-Stimme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade caracteres en elevenlabs.io o elige la voz de Apple en Ajustes › Voz."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez des caractères sur elevenlabs.io, ou choisissez une voix Apple dans Réglages › Voix."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggiungi caratteri su elevenlabs.io, o scegli la voce di Apple in Impostazioni › Voce."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "elevenlabs.ioで文字数を追加するか、設定 › 音声でAppleの音声を選んでください。"
