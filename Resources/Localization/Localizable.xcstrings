        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs no pudo generar la voz. No se ha dicho nada en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs n’a pas pu produire la voix. Rien n’a été prononcé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs non ha potuto generare la voce. Non ho detto nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabsで音声を生成できませんでした。何も読み上げられていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs에서 음성을 만들지 못했어요. 아무 말도 하지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
