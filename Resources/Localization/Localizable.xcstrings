            "value" : "モデルにごく小さなリクエストを1回送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "모델에 아주 작은 요청을 하나 보내요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
