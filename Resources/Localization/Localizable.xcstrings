          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "~/.local/bin/sidefolk에 링크를 추가해서 터미널에서 “sidefolk run -- npm test”를 입력할 수 있게 해요."
          }
        },
        "pt-BR" : {
