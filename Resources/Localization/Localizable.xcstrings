    "Found %@ %@ at %@, but it isn't signed in. Run this in Terminal, then click Look again." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Found %1$@ %2$@ at %3$@, but it isn't signed in. Run this in Terminal, then click Look again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontró %1$@ %2$@ en %3$@, pero no tiene la sesión iniciada. Ejecuta esto en Terminal y haz clic en Volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ trouvé (%3$@), mais aucun compte n’est connecté. Exécutez ceci dans Terminal, puis cliquez sur Vérifier à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho trovato %1$@ %2$@ in %3$@, ma non ha effettuato l'accesso. Esegui questo comando nel Terminale, poi fai clic su Cerca di nuovo."
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@에서 %1$@ %2$@ 버전을 찾았지만 로그인되어 있지 않아요. 터미널에서 다음을 실행한 다음 다시 찾기를 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrei %1$@ %2$@ em %3$@, mas sem sessão iniciada. Execute isto no Terminal e clique em Procurar de novo."
          }
        }
      }
    },
    "Found %@ %@ at %@, signed in with an API key, so it's billed to that key. To use your ChatGPT plan instead, run this in Terminal:" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Found %1$@ %2$@ at %3$@, signed in with an API key, so it's billed to that key. To use your ChatGPT plan instead, run this in Terminal:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se encontró %1$@ %2$@ en %3$@, con la sesión iniciada mediante una clave de API, así que el uso se factura a esa clave. Para usar tu plan de ChatGPT, ejecuta esto en Terminal:"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ %2$@ trouvé (%3$@), connecté avec une clé API : l’utilisation est donc facturée sur cette clé. Pour utiliser plutôt votre forfait ChatGPT, exécutez ceci dans Terminal :"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ho trovato %1$@ %2$@ in %3$@, con accesso tramite chiave API, quindi l'uso viene addebitato a quella chiave. Per usare invece il tuo piano ChatGPT, esegui questo comando nel Terminale:"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%3$@에서 %1$@ %2$@ 버전을 찾았어요. API 키로 로그인되어 있어서 그 키로 요금이 청구돼요. 대신 ChatGPT 요금제를 사용하려면 터미널에서 다음을 실행하세요:"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Encontrei %1$@ %2$@ em %3$@, com sessão iniciada por uma chave de API, então o uso é cobrado dessa chave. Para usar seu plano do ChatGPT, execute isto no Terminal:"
          }
        }
      }
    },
    "Found %@ %@ at %@, signed in with your ChatGPT plan." : {
      "localizations" : {
