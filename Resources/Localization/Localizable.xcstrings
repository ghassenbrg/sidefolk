    "Quiet is on: only urgent things reach you. They're all here when you're ready." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الهدوء مفعّل: لا يصلك إلا العاجل. كل شيء هنا حين تكون مستعدًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ruhemodus ist an: Nur Dringendes erreicht dich. Alles ist hier, wenn du so weit bist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El silencio está activado: solo te llega lo urgente. Todo estará aquí cuando estés listo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le mode discret est activé : seul l’urgent vous parvient. Tout est là quand vous êtes prêt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il silenzio è attivo: ti raggiunge solo ciò che è urgente. È tutto qui quando sei pronto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "静かモードがオンです。緊急のことだけが届きます。準備ができたら、すべてここにあります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "조용한 모드가 켜져 있어요. 급한 일만 알려 드려요. 준비되면 모두 여기 있어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O silêncio está ativo: só o urgente chega até você. Está tudo aqui quando estiver pronto."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安静已开启：只有紧急事项会打扰你。准备好时，一切都在这里。"
          }
        }
      }
    },
