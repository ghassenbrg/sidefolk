    "Shell commands, always shown word for word before they run." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوامر الصدفة (shell)، تُعرض دائمًا حرفيًا قبل تشغيلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-Befehle, die vor dem Ausführen immer wörtlich angezeigt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos de shell, que siempre se muestran tal cual antes de ejecutarse."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commandes shell, toujours affichées mot pour mot avant leur exécution."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandi della shell, sempre mostrati parola per parola prima dell'esecuzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルコマンド。実行前に必ずそのまま表示します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "셸 명령. 실행하기 전에 항상 그대로 보여 드려요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos de shell, sempre mostrados palavra por palavra antes de rodar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell 命令，运行前始终逐字显示。"
          }
        }
      }
    },
    "Shell commands, shown word for word before they run unless Full access is on." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أوامر shell، تُعرض كلمةً بكلمة قبل تشغيلها ما لم يكن الوصول الكامل قيد التشغيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Shell-Befehle, vor dem Ausführen Wort für Wort angezeigt, es sei denn, Vollzugriff ist an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandos de shell, que se muestran palabra por palabra antes de ejecutarse salvo que el acceso total esté activado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Commandes shell, affichées mot pour mot avant leur exécution, sauf si l’accès complet est activé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comandi di shell, mostrati parola per parola prima dell'esecuzione, a meno che l'accesso completo non sia attivo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "シェルコマンドは、フルアクセスがオンでない限り、実行前に一字一句そのまま表示されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
