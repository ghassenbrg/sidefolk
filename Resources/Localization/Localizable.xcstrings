    "This can send what it's given off this Mac, so I check with you first." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لهذا إرسال ما يُعطى له خارج هذا الـ Mac، لذا أتحقق منك أولًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kann, was es bekommt, von diesem Mac wegschicken, deshalb frage ich dich zuerst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto puede enviar lo que recibe fuera de este Mac, así que lo consulto contigo primero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci peut envoyer ce qu’on lui donne hors de ce Mac, alors je vérifie d’abord avec vous."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo può inviare ciò che riceve fuori da questo Mac, quindi te lo chiedo prima."
          }
        },
        "ja" : {
          "stringUnit" : {
