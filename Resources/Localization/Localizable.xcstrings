    "Installed but not running. Open Ollama, then click Look again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبّت لكنه لا يعمل. افتح Ollama، ثم انقر على «البحث مجددًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert, aber nicht gestartet. Öffne Ollama und klicke dann auf „Erneut suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado, pero no se está ejecutando. Abre Ollama y haz clic en Volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé, mais pas lancé. Ouvrez Ollama, puis cliquez sur Vérifier à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato ma non in esecuzione. Apri Ollama, poi fai clic su Cerca di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みですが、動作していません。Ollamaを開いてから、「再確認」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치되어 있지만 실행 중이 아니에요. Ollama를 연 다음 다시 찾기를 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado, mas não está em execução. Abra o Ollama e clique em Procurar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装，但没有运行。请打开 Ollama，然后点按“重新查找”。"
          }
        }
      }
    },
    "Installed, but its server is off. In LM Studio, start the server (Developer tab), then click Look again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مثبّت، لكن خادمه متوقف. في LM Studio، شغّل الخادم (علامة التبويب Developer)، ثم انقر على «البحث مجددًا»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installiert, aber der Server ist aus. Starte in LM Studio den Server (Tab „Developer“) und klicke dann auf „Erneut suchen“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado, pero su servidor está apagado. En LM Studio, inicia el servidor (pestaña Developer) y haz clic en Volver a buscar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installé, mais son serveur est arrêté. Dans LM Studio, démarrez le serveur (onglet Developer), puis cliquez sur Vérifier à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Installato, ma il suo server è spento. In LM Studio, avvia il server (scheda Developer), poi fai clic su Cerca di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストール済みですが、サーバがオフです。LM Studioでサーバを起動（Developerタブ）してから、「再確認」をクリックしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설치되어 있지만 서버가 꺼져 있어요. LM Studio에서 서버를 시작한 다음(Developer 탭) 다시 찾기를 클릭하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalado, mas o servidor está desligado. No LM Studio, inicie o servidor (aba Developer) e clique em Procurar de novo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已安装，但它的服务器没有开启。请在 LM Studio 中启动服务器（Developer 标签页），然后点按“重新查找”。"
          }
