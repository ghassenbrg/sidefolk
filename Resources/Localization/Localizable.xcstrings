        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "我会继续尝试，每次间隔稍长一些。"
          }
        }
      }
    },
    "I'll look for what to stop." : {
      "localizations" : {
        "ar" : {
