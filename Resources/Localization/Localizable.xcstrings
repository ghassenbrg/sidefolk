    "This came up while reading outside content. Check it carefully." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ظهر هذا أثناء قراءة محتوى خارجي. تحقّق منه بعناية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das kam beim Lesen von Inhalten von außen auf. Prüfe es sorgfältig."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto surgió al leer contenido externo. Revísalo con cuidado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ceci est apparu en lisant du contenu extérieur. Vérifiez-le attentivement."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "È emerso durante la lettura di contenuti esterni. Controllalo con attenzione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これは外部のコンテンツを読み込んでいるときに出てきたものです。よく確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "외부 콘텐츠를 읽다가 나온 요청이에요. 꼼꼼히 확인하세요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso surgiu durante a leitura de conteúdo externo. Confira com cuidado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这是在读取外部内容时出现的。请仔细检查。"
          }
        }
      }
    },
    "This can't be undone." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يمكن التراجع عن ذلك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das lässt sich nicht widerrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta acción no se puede deshacer."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette action est irréversible."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'operazione non può essere annullata."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この操作は取り消せません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 작업은 실행 취소할 수 없어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso não pode ser desfeito."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此操作无法撤销。"
          }
        }
      }
    },
    "This command watcher wasn't made by you, so I won't run it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم تُنشئ أنت مراقبة الأوامر هذه، لذا لن أشغّلها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Befehlsbeobachtung stammt nicht von dir, deshalb führe ich sie nicht aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta vigilancia de comando no la creaste tú, así que no la ejecutaré."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette surveillance de commande n’a pas été créée par vous, je ne vais donc pas l’exécuter."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa sentinella su un comando non l'hai creata tu, quindi non la eseguo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このコマンドの監視はユーザー本人が作成したものではないため、実行しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 명령 지켜보기는 직접 만든 것이 아니라서 실행하지 않을게요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este monitoramento de comando não foi criado por você, então não vou executá-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这项命令监视不是你创建的，所以我不会运行它。"
          }
        }
      }
    },
