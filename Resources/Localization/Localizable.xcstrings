          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las habilidades solo las puedes eliminar tú o el propio Sidefolk."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
