    "ElevenLabs couldn't find that voice. Nothing was said." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs no encontró esa voz. No se ha dicho nada en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs n’a pas trouvé cette voix. Rien n’a été prononcé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs non ha trovato quella voce. Non ho detto nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabsでその声が見つかりませんでした。何も読み上げられていません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs에서 그 음성을 찾지 못했어요. 아무 말도 하지 않았어요."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O ElevenLabs não encontrou essa voz. Nada foi dito em voz alta."
          }
        }
      }
    },
    "ElevenLabs couldn't make the voice. Nothing was said." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs no pudo generar la voz. No se ha dicho nada en voz alta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs n’a pas pu produire la voix. Rien n’a été prononcé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs non ha potuto generare la voce. Non ho detto nulla."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabsで音声を生成できませんでした。何も読み上げられていません。"
          }
        },
        "ko" : {
