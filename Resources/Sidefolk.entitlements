<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime blocks Apple Events without it: reading Apple Notes and Reminders (DECISIONS D38). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- The hardened runtime blocks the microphone without it; voice input only opens it while the talk key is held (D34). -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- The hardened runtime blocks Location Services without it; used only after the person chooses their Mac's location (D48). -->
	<key>com.apple.security.personal-information.location</key>
	<true/>
	<!-- The hardened runtime blocks the calendar without it; read only after the person chooses to show it (D57). -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
