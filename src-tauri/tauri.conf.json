{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidefolk",
  "version": "0.1.0",
  "identifier": "dev.sidefolk.companion",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Sidefolk",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist"
    },
    "category": "DeveloperTool",
    "shortDescription": "Pip, your desktop companion for reminders, a work log and Claude Code",
    "longDescription": "Pip sits on your desktop, taps you when Claude Code or a reminder needs you, takes you to that exact session, and keeps a dated log of what you got done.",
    "copyright": "© 2026 Ghassen Bargougui",
    "createUpdaterArtifacts": false
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "requireSignedVersion": true
    }
  }
}
