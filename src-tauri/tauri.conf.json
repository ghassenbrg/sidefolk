{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sidefolk",
  "version": "0.1.0",
  "identifier": "dev.sidefolk.companion",
  "build": {
    "beforeDevCommand": "npm run web",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "overlay",
        "title": "Sidefolk",
        "url": "index.html",
        "width": 800,
        "height": 600,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "resizable": false,
        "visible": false,
        "focus": false,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "backgroundThrottling": "disabled"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    },
    "category": "DeveloperTool",
    "shortDescription": "Desktop pets that give your AI agents a body",
    "longDescription": "A crew of 3D desktop pets that act out what Claude Code and Codex are doing, bring you their questions, remind you of things and let agents reach you.",
    "copyright": "© 2026 Ghassen Bargougui"
  }
}
