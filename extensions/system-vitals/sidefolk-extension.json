{
  "id": "dev.sidefolk.system-vitals",
  "name": "System Vitals",
  "version": "1.2.0",
  "sidefolk": ">=0.1",
  "description": "Battery, disk and memory at a glance, and a nudge when the battery or the disk runs low.",
  "folk": "byte",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": { "command": "bin/ext-system-vitals" },
  "permissions": {
    "network": false,
    "files": { "read": [], "write": [] },
    "exec": ["/usr/bin/pmset"]
  },
  "tools": {
    "battery": { "title": "Battery status", "risk": "low", "category": "system", "mutates": false },
    "disk": { "title": "Disk space", "risk": "low", "category": "system", "mutates": false },
    "memory": { "title": "Memory use", "risk": "low", "category": "system", "mutates": false },
    "about": {
      "title": "About this Mac", "risk": "low", "category": "system", "mutates": false,
      "commands": [
        { "say": ["about this mac", "about my mac", "what mac is this", "what mac do i have", "which mac do i have", "mac info",
                  "system info", "how long has my mac been on", "uptime"] }
      ]
    }
  },
  "watchers": {
    "battery_low": {
      "title": "Battery low",
      "description": "Tells you once when the battery drops below a level while it isn't charging.",
      "config": {
        "below_percent": { "type": "integer", "description": "Warn below this percentage.", "default": 20, "minimum": 1, "maximum": 99 }
      }
    },
    "disk_low": {
      "title": "Disk space low",
      "description": "Tells you once when free space on the startup disk drops below a size.",
      "config": {
        "below_gb": { "type": "number", "description": "Warn below this many gigabytes free.", "default": 10, "minimum": 0.5 }
      }
    }
  }
}
