{
  "id": "dev.sidefolk.playtime",
  "name": "Playtime",
  "version": "1.1.0",
  "sidefolk": ">=0.1",
  "description": "A break with your companion: flip a coin, roll dice, let chance pick, play rock, paper, scissors, or a trivia quiz that keeps your score.",
  "folk": "play",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-playtime"
  },
  "permissions": {},
  "tools": {
    "chance": {
      "title": "Coin, dice and random picks",
      "risk": "low",
      "category": "system",
      "mutates": false,
      "commands": [
        {
          "say": [
            "pick a number between {min:integer} and {max:integer}",
            "random number between {min:integer} and {max:integer}",
            "a random number between {min:integer} and {max:integer}",
            "pick a number from {min:integer} to {max:integer}", "random number from {min:integer} to {max:integer}"
          ],
          "input": {
            "kind": "number",
            "min": "{min}",
            "max": "{max}"
          }
        },
        {
          "say": [
            "pick a number", "random number", "pick a random number", "give me a random number"
          ],
          "input": {
            "kind": "number"
          }
        },
        {
          "say": [
            "pick one: {choices:list}", "pick one of {choices:list}", "choose between {choices:list}",
            "choose one of {choices:list}", "pick from {choices:list}", "pick between {choices:list}",
            "help me pick between {choices:list}", "help me choose between {choices:list}"
          ],
          "input": {
            "kind": "pick",
            "choices": "{choices}"
          }
        }
      ]
    },
    "trivia": {
      "title": "Trivia quiz",
      "risk": "low",
      "category": "system",
      "mutates": false
    },
    "rock_paper_scissors": {
      "title": "Rock, paper, scissors",
      "risk": "low",
      "category": "system",
      "mutates": false
    }
  }
}
