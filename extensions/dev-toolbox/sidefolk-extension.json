{
  "id": "dev.sidefolk.dev-toolbox",
  "name": "Dev Toolbox",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "For developers: format JSON, encode and decode base64, URLs and hex, decode JWTs, convert timestamps, make UUIDs, and check a file's checksum.",
  "folk": "byte",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-dev-toolbox"
  },
  "permissions": {},
  "tools": {
    "transform": {
      "title": "Transform text",
      "risk": "low",
      "category": "system",
      "mutates": false
    },
    "timestamp": {
      "title": "Convert a timestamp",
      "risk": "low",
      "category": "time",
      "mutates": false
    },
    "generate": {
      "title": "Generate IDs",
      "risk": "low",
      "category": "system",
      "mutates": false
    },
    "checksum": {
      "title": "File checksum",
      "risk": "low",
      "category": "files",
      "mutates": false,
      "paths": {
        "path": "read"
      },
      "timeout": 120
    }
  }
}
