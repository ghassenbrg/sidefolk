{
  "id": "dev.sidefolk.dev-toolbox",
  "name": "Dev Toolbox",
  "version": "1.1.0",
  "sidefolk": ">=0.1",
  "description": "For developers: format JSON, encode and decode base64, URLs and hex, decode JWTs, convert timestamps, make UUIDs, and check a file's checksum.",
  "folk": "byte",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-dev-toolbox"
  },
  "permissions": {},
  "tools": {
    "transform": {
      "title": "Transform text",
      "risk": "low",
      "category": "system",
      "mutates": false
    },
    "timestamp": {
      "title": "Convert a timestamp",
      "risk": "low",
      "category": "time",
      "mutates": false,
      "commands": [
        {
          "say": [
            "timestamp {value:word}", "convert timestamp {value:word}", "unix time {value:word}",
            "unix timestamp {value:word}", "epoch {value:word}"
          ],
          "input": {
            "value": "{value}"
          }
        },
        {
          "say": [
            "unix time", "unix time now", "current unix time", "timestamp now", "current timestamp", "epoch now"
          ],
          "input": {}
        }
      ]
    },
    "generate": {
      "title": "Generate IDs",
      "risk": "low",
      "category": "system",
      "mutates": false,
      "commands": [
        {
          "say": [
            "uuid", "new uuid", "a uuid", "generate a uuid", "make a uuid", "give me a uuid", "random uuid"
          ],
          "input": {
            "kind": "uuid"
          }
        },
        {
          "say": [
            "{count:integer} uuids", "generate {count:integer} uuids", "make {count:integer} uuids",
            "give me {count:integer} uuids"
          ],
          "input": {
            "kind": "uuid",
            "count": "{count}"
          }
        },
        {
          "say": [
            "new token", "random token", "generate a token", "make a token", "secure token", "random hex token"
          ],
          "input": {
            "kind": "token"
          }
        }
      ]
    },
    "checksum": {
      "title": "File checksum",
      "risk": "low",
      "category": "files",
      "mutates": false,
      "paths": {
        "path": "read"
      },
      "timeout": 120
    }
  }
}
