{
  "id": "dev.sidefolk.images",
  "name": "Images",
  "version": "1.0.0",
  "sidefolk": ">=0.1",
  "description": "A photo's details, and copies of pictures converted to JPEG, PNG or HEIC, made smaller, or without their location. Your originals stay as they are.",
  "tagline": "Photo details and converted copies",
  "folk": "melody",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-images"
  },
  "permissions": {
    "media": true
  },
  "tools": {
    "image_info": {
      "title": "Picture details",
      "risk": "low",
      "category": "files",
      "mutates": false,
      "paths": {
        "path": "read"
      }
    },
    "convert_images": {
      "title": "Convert pictures",
      "risk": "medium",
      "category": "files",
      "mutates": true,
      "paths": {
        "folder": "write"
      },
      "timeout": 300
    }
  }
}
