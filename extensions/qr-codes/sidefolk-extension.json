{
  "id": "dev.sidefolk.qr-codes",
  "name": "QR Codes",
  "version": "1.1.0",
  "sidefolk": ">=0.1",
  "description": "Makes a QR code picture of a link or text, and reads the QR code in a picture or a screenshot.",
  "tagline": "Make and read QR codes",
  "folk": "byte",
  "author": "Sidefolk",
  "icon": "icon.pdf",
  "run": {
    "command": "bin/ext-qr-codes"
  },
  "permissions": {
    "media": true
  },
  "tools": {
    "make_qr": {
      "title": "Make a QR code",
      "risk": "medium",
      "category": "files",
      "mutates": true,
      "paths": {
        "folder": "write"
      },
      "commands": [
        {
          "say": [
            "qr code for {text:text}", "make a qr code for {text:text}", "make a qr code of {text:text}",
            "qr for {text:text}", "create a qr code for {text:text}"
          ],
          "input": {
            "text": "{text}",
            "folder": "~/Desktop"
          }
        }
      ]
    },
    "read_qr": {
      "title": "Read a QR code",
      "risk": "low",
      "category": "files",
      "mutates": false,
      "paths": {
        "path": "read"
      }
    }
  }
}
